+</style>
+</head>
+<body>
+<main>
+  <header>
+    <h1 id="siteTitle">Cranked</h1>
+    <p class="sub" id="siteSub">Playdate games in the browser: Lua games, and C games on a built-in ARM interpreter.</p>
+  </header>
+  <div class="screen" id="screen"><canvas id="lcd" width="400" height="240"></canvas></div>
+  <div class="touch" id="touch">
+    <div class="dpad">
+      <span></span><button class="pad" data-bit="4" aria-label="Up">&uarr;</button><span></span>
+      <button class="pad" data-bit="1" aria-label="Left">&larr;</button><button class="pad" data-bit="128" aria-label="Menu">&#9776;</button><button class="pad" data-bit="2" aria-label="Right">&rarr;</button>
+      <span></span><button class="pad" data-bit="8" aria-label="Down">&darr;</button><span></span>
+    </div>
+    <div class="crank" id="crankdial" aria-label="Crank"></div>
+    <div class="ab"><button class="pad" data-bit="16">B</button><button class="pad" data-bit="32">A</button></div>
+  </div>
+  <div class="bar">
+    <label class="btn site-only">Open zipped game<input type="file" id="zipfile" accept=".zip"></label>
+    <label class="btn site-only">Open .pdx folder<input type="file" id="folder" webkitdirectory></label>
+    <button id="pause" type="button" disabled>Pause</button>
+    <button id="full" type="button">Fullscreen</button>
+    <button id="shot" type="button" disabled>Screenshot</button>
+    <button id="mute" type="button">Sound on</button>
+    <button id="exportSaves" type="button" disabled>Export saves</button>
+    <label class="btn" id="importLabel">Import saves<input type="file" id="importSaves" accept=".zip"></label>
+    <span id="status">Loading engine...</span>
+  </div>
+
+  <div class="site-only" id="catalogSection" hidden>
+    <h2 id="catalogTitle">Games</h2>
+    <ul class="library" id="catalog"></ul>
+  </div>
+  <div class="site-only">
+    <h2>Library</h2>
+    <ul class="library" id="library"></ul>
+    <p class="empty" id="empty">Games you open are kept here, in this browser, to play again without picking the file.</p>
+  </div>
+
+  <details id="lookPanel">
+    <summary>Screen</summary>
+    <div class="look">
+      <label>Colors <select id="lookColors"></select></label>
+      <label><input type="checkbox" id="lookBlend"> Blend frames</label>
+      <label><input type="checkbox" id="lookGrid"> Pixel grid</label>
+      <label><input type="checkbox" id="lookShadow"> Pixel shadow</label>
+      <label>Room light <input type="range" id="lookLight" min="0" max="1" step="0.05" value="0"></label>
+      <label id="lookTiltLabel" hidden><input type="checkbox" id="lookTilt"> Tilting the phone moves the light</label>
+      <label><input type="checkbox" id="lookScan"> Scanlines (CRT)</label>
+      <label><input type="checkbox" id="lookDevice"> Device frame</label>
+      <button id="lookReset" type="button">Reset</button>
+    </div>
+    <p class="empty">Blend frames mixes each frame with the one before, as the eye does with pixels a game flickers to make
+      grey. The device frame's buttons light up as they are pressed, and its crank turns.</p>
+  </details>
+  <details>
+    <summary>Controls</summary>
+    <table>
+      <tr><td>D-pad</td><td><kbd>&larr;</kbd> <kbd>&uarr;</kbd> <kbd>&rarr;</kbd> <kbd>&darr;</kbd></td></tr>
+      <tr><td>A, B</td><td><kbd>X</kbd> and <kbd>Z</kbd></td></tr>
+      <tr><td>Menu</td><td><kbd>Enter</kbd> or <kbd>Esc</kbd></td></tr>
+      <tr><td>Crank</td><td>mouse wheel over the screen, or <kbd>,</kbd> and <kbd>.</kbd>; <kbd>C</kbd> docks and undocks it</td></tr>
+      <tr><td>Pause</td><td><kbd>P</kbd></td></tr>
+      <tr><td>Gamepad</td><td>d-pad or left stick; right and bottom buttons for A and B; Start or Back for the menu; right stick or shoulder buttons for the crank</td></tr>
+      <tr><td>Touch</td><td>the buttons under the screen; drag round the dial to turn the crank</td></tr>
+      <tr><td>Saves</td><td>kept in this browser (IndexedDB); Export saves and Import saves move them between browsers</td></tr>
+    </table>
+  </details>
+  <footer>
+    Playdate fonts by Panic Inc., licensed under <a href="https://creativecommons.org/licenses/by/4.0/" rel="license noopener" target="_blank">CC BY 4.0</a>.
+    Playdate is a trademark of Panic Inc. This project is not affiliated with Panic.
+  </footer>
+</main>
+<script src="zip.js"></script>
+<script>
+"use strict";
+// The engine (engine.js) runs on this page's thread by default, or in a worker with ?worker=1 (worker.js);
+// this page handles input, drawing, audio output, the library and the buttons. Hosting needs only static files either
+// way.
+const BUTTONS = { ArrowLeft: 1, ArrowRight: 2, ArrowUp: 4, ArrowDown: 8, KeyZ: 16, KeyX: 32, Enter: 128, Escape: 128 };
+const RATE = 44100;
+const $ = id => document.getElementById(id);
+const status = $("status"), screen = $("screen");
+const ctx2d = $("lcd").getContext("2d");
+let ready = false, running = false, paused = false, buttons = 0, crank = 0, docked = true;
+let currentFolder = "", currentEntry = null;
+let audio = null, audioNode = null, muted = false, currentTitle = "", pendingEntry = null, frameMs = 0, latest = null;
+
+function setStatus(text) { status.textContent = text; }
+function store(key, value) { try { localStorage.setItem(key, value); } catch (e) {} }
+function load(key) { try { return localStorage.getItem(key); } catch (e) { return null; } }
+
+const useWorker = new URLSearchParams(location.search).has("worker") && typeof Worker !== "undefined";
+const worker = useWorker ? new Worker("worker.js") : { postMessage() {}, onmessage: null, onerror: null };
+if (!useWorker) { // the same messages, on this thread: load the engine's scripts, then connect them
+  const handler = { pending: [], run: null };
+  worker.postMessage = msg => { if (handler.run) handler.run({ data: msg }); else handler.pending.push(msg); };
+  const load = src => new Promise((resolve, reject) => { const el = document.createElement("script"); el.src = src; el.onload = resolve; el.onerror = () => reject(new Error("could not load " + src)); document.head.append(el); });
+  load("cranked.js").then(() => load("engine.js")).then(() => {
+    handler.run = createCrankedEngine(msg => worker.onmessage && worker.onmessage({ data: msg }), false);
+    for (const msg of handler.pending.splice(0)) handler.run({ data: msg });
+  }).catch(e => worker.onerror && worker.onerror(e));
+}
+worker.onmessage = e => {
+  const msg = e.data;
+  if (msg.type === "ready") { ready = true; setStatus(site.game ? "Starting..." : "Open a game, or pick one from the library"); connectAudio(); siteReady(); }
+  else if (msg.type === "loaded") {
+    if (!msg.ok) { setStatus(msg.error); running = false; updateButtons(); return; }
+    currentFolder = (msg.info && msg.info.dataFolder) || "";
+    running = true; paused = false; docked = true; crank = 0; screen.classList.remove("paused"); updateButtons();
+    setStatus("Running (loaded in " + Math.round(msg.loadMs) + " ms)");
+    if (pendingEntry) remember(pendingEntry, msg.info);
+  } else if (msg.type === "saves") savesExported(msg);
+  else if (msg.type === "imported") savesImported(msg);
+  else if (msg.type === "frame") { latest = msg.rgba; latestWidth = msg.width; latestHeight = msg.height; frameMs = msg.frameMs; }
+  else if (msg.type === "stopped") { setStatus(msg.error); running = false; updateButtons(); }
+};
+worker.onerror = e => setStatus("The engine could not start: " + (e.message || "worker error"));
+
+function sendInput() { worker.postMessage({ type: "input", input: { buttons: buttons | touchBits | padBits, crank, docked } }); }
+
+// ---------- the library: games kept in IndexedDB as a zip's bytes or a folder's files ----------
+const DB = new Promise((resolve, reject) => {
+  const req = indexedDB.open("cranked-library", 1);
+  req.onupgradeneeded = () => req.result.createObjectStore("games", { keyPath: "id" });
+  req.onsuccess = () => resolve(req.result);
+  req.onerror = () => reject(req.error);
+});
+async function dbDo(mode, fn) {
+  const db = await DB;
+  return new Promise((resolve, reject) => {
+    const tx = db.transaction("games", mode); const r = fn(tx.objectStore("games"));
+    tx.oncomplete = () => resolve(r && r.result); tx.onerror = () => reject(tx.error);
+  });
+}
+async function renderLibrary() {
+  let games = [];
+  try { games = await dbDo("readonly", s => s.getAll()); } catch (e) {}
+  games.sort((a, b) => b.played - a.played);
+  const list = $("library"); list.textContent = "";
+  $("empty").style.display = games.length ? "none" : "";
+  for (const g of games) {
+    const li = document.createElement("li");
+    const text = document.createElement("div"); text.className = "grow";
+    const t = document.createElement("div"); t.className = "title"; t.textContent = g.title;
+    const m = document.createElement("div"); m.className = "meta";
+    m.textContent = [g.author, (g.size / 1048576).toFixed(1) + " MB"].filter(Boolean).join(" \u00b7 ");
+    text.append(t, m);
+    const play = document.createElement("button"); play.textContent = "Play"; play.onclick = () => startGame(g);
+    const del = document.createElement("button"); del.textContent = "Remove";
+    del.onclick = async () => { await dbDo("readwrite", s => s.delete(g.id)); renderLibrary(); };
+    li.append(text, play, del); list.append(li);
+  }
+}
+async function remember(entry, info) {
+  const id = (info && info.bundleID) || entry.id || entry.fileName;
+  const title = (info && info.name) || entry.title || entry.fileName;
+  const author = (info && info.author) || entry.author || "";
+  currentTitle = title;
+  try { await dbDo("readwrite", s => s.put({ ...entry, id, title, author, played: Date.now() })); } catch (e) { console.warn("library", e); }
+  renderLibrary();
+}
+
+// ---------- loading: the game's bytes go to the worker (copied, so the library keeps its own) ----------
+function startGame(entry) {
+  if (!ready) return;
+  pendingEntry = entry; currentEntry = entry; setStatus("Loading...");
+  if (entry.kind === "zip") worker.postMessage({ type: "load", kind: "zip", zip: entry.zip });
+  else worker.postMessage({ type: "load", kind: "files", files: entry.files });
+}
+async function openZip(file) {
+  const data = new Uint8Array(await file.arrayBuffer());
+  startGame({ kind: "zip", fileName: file.name.replace(/\.zip$/i, ""), zip: data, size: data.length });
+}
+$("zipfile").addEventListener("change", e => { const f = e.target.files[0]; if (f) openZip(f); e.target.value = ""; });
+$("folder").addEventListener("change", async e => {
+  const picked = [...e.target.files]; e.target.value = ""; if (!picked.length) return;
+  const files = []; let size = 0;
+  for (const f of picked) {
+    const data = new Uint8Array(await f.arrayBuffer()); size += data.length;
+    files.push({ path: f.webkitRelativePath.split("/").slice(1).join("/"), data }); // without the folder's own name
+  }
+  const fileName = picked[0].webkitRelativePath.split("/")[0].replace(/\.pdx$/i, "");
+  startGame({ kind: "files", fileName, files, size });
+});
+screen.addEventListener("dragover", e => { e.preventDefault(); screen.classList.add("drop"); });
+screen.addEventListener("dragleave", () => screen.classList.remove("drop"));
+screen.addEventListener("drop", e => {
+  e.preventDefault(); screen.classList.remove("drop");
+  const f = e.dataTransfer.files[0]; if (f) openZip(f);
+});
+renderLibrary();
+
+// ---------- the site: one game (kiosk) or a catalog of games to download ----------
+// site.json next to the page (optional): { "title", "subtitle", "game": url of a zipped game (one game, no library),
+// "catalog": url of a game list (default games.json), "proxy": a download proxy's address, to which a game's
+// address is appended, encoded (see packaging/download-proxy) }. The URL can set ?game=<url> and ?catalog=<url> too.
+// The game list: { "title": "Games", "games": [{ "title", "author", "url", "version", "license", "source",
+// "description", "download", "page" }] }; a downloaded game is kept in the library and downloaded again only when its
+// version changes. "url" is a game the site hosts. A game hosted elsewhere has "download" (its own address, tried
+// directly and then through the proxy, since most hosts do not allow downloads from other sites) and/or "page" (the
+// author's page, to get it from by hand and open here).
+const params = new URLSearchParams(location.search);
+const site = { title: "", subtitle: "", game: "", catalog: "games.json", proxy: "" };
+const siteLoaded = fetch("site.json", { cache: "no-cache" }).then(r => r.ok ? r.json() : {}).catch(() => ({})).then(cfg => {
+  for (const k of Object.keys(site)) if (typeof cfg[k] === "string") site[k] = cfg[k];
+  if (params.get("game")) site.game = params.get("game");
+  if (params.get("catalog")) site.catalog = params.get("catalog");
+  if (site.title) { $("siteTitle").textContent = site.title; document.title = site.title; }
+  if (site.subtitle) $("siteSub").textContent = site.subtitle;
+  if (site.game) document.body.classList.add("kiosk");
+  else renderCatalog();
+});
+function webUrl(url) { // a relative or http(s) address, as an absolute one; anything else is refused
+  try { const u = new URL(url, location.href); return u.protocol === "http:" || u.protocol === "https:" ? u.href : null; }
+  catch (e) { return null; }
+}
+async function siteReady() {
+  await siteLoaded;
+  if (site.game) playUrl(site.game, { title: site.title });
+}
+async function fetchGame(url, label) {
+  const r = await fetch(url);
+  if (!r.ok) throw new Error(r.status + " " + r.statusText);
+  const total = +r.headers.get("content-length") || 0;
+  if (!r.body || !total) return new Uint8Array(await r.arrayBuffer());
+  const reader = r.body.getReader(), chunks = []; let got = 0;
+  for (;;) {
+    const { done, value } = await reader.read(); if (done) break;
+    chunks.push(value); got += value.length;
+    setStatus(label + " " + Math.min(100, Math.round(got * 100 / total)) + "%");
+  }
+  const out = new Uint8Array(got); let at = 0;
+  for (const c of chunks) { out.set(c, at); at += c.length; }
+  return out;
+}
+async function cachedGame(url, version) {
+  try { return (await dbDo("readonly", s => s.getAll())).find(g => g.source === url && (g.version || "") === (version || "")); }
+  catch (e) { return null; }
+}
+async function playUrl(url, meta, viaProxy) {
+  const abs = webUrl(url);
+  if (!abs) { setStatus("Not a web address: " + url); return; }
+  const cached = await cachedGame(abs, meta.version);
+  if (cached) { startGame(cached); return; }
+  try {
+    const label = "Downloading " + (meta.title || "the game");
+    let zip;
+    try { zip = await fetchGame(abs, label); }
+    catch (e) { // a host that does not allow downloads from other sites fails here (the browser hides why)
+      const proxy = viaProxy && site.proxy && webUrl(site.proxy);
+      if (!proxy) throw new Error(meta.page ? "its host does not allow it from here; get it from the author's page and open it here" : e.message);
+      zip = await fetchGame(proxy + encodeURIComponent(abs), label);
+    }
+    startGame({ kind: "zip", fileName: meta.title || decodeURIComponent(abs.split("/").pop()).replace(/\.zip$/i, ""), title: meta.title,
+                author: meta.author, zip, size: zip.length, source: abs, version: meta.version || "", license: meta.license || "" });
+  } catch (e) { setStatus("Could not download the game: " + e.message); }
+}
+async function renderCatalog() {
+  let list;
+  try {
+    const url = webUrl(site.catalog); if (!url) return;
+    const r = await fetch(url, { cache: "no-cache" }); if (!r.ok) return;
+    list = await r.json();
+  } catch (e) { return; }
+  const games = Array.isArray(list.games) ? list.games.filter(g => g && [g.url, g.download, g.page].some(u => typeof u === "string")) : [];
+  if (!games.length) return;
+  if (typeof list.title === "string") $("catalogTitle").textContent = list.title;
+  const ul = $("catalog"); ul.textContent = "";
+  for (const g of games) {
+    const li = document.createElement("li");
+    const text = document.createElement("div"); text.className = "grow";
+    const t = document.createElement("div"); t.className = "title"; t.textContent = g.title || g.url || g.download || g.page;
+    const m = document.createElement("div"); m.className = "meta";
+    m.textContent = [g.author, g.license].filter(x => typeof x === "string" && x).join(" \u00b7 ");
+    text.append(t, m);
+    if (typeof g.description === "string" && g.description) { const d = document.createElement("div"); d.className = "meta"; d.textContent = g.description; text.append(d); }
+    const src = webUrl(g.source || "");
+    if (src) { const a = document.createElement("a"); a.className = "src"; a.href = src; a.target = "_blank"; a.rel = "noopener"; a.textContent = "Source and license"; text.append(a); }
+    li.append(text);
+    const page = webUrl(typeof g.page === "string" ? g.page : "");
+    if (typeof g.url === "string" || typeof g.download === "string") {
+      const play = document.createElement("button"); play.textContent = "Play";
+      play.onclick = () => typeof g.url === "string" ? playUrl(g.url, g) : playUrl(g.download, g, true);
+      li.append(play);
+    } else if (page) { // only the author's page: the game is downloaded there and opened here
+      const a = document.createElement("a"); a.className = "btn"; a.href = page; a.target = "_blank"; a.rel = "noopener";
+      a.textContent = "Get it"; a.title = "Download it from the author's page, then open or drop the file here"; li.append(a);
+    }
+    ul.append(li);
+  }
+  $("catalogSection").hidden = false;
+}
+
+// ---------- save data: exported as a zip of the game's data folder, and imported from one ----------
+$("exportSaves").onclick = () => { if (currentFolder) worker.postMessage({ type: "exportSaves", folder: currentFolder }); };
+function savesExported(msg) {
+  if (!msg.files.length) { setStatus("This game has no save data yet"); return; }
+  const blob = new Blob([CrankedZip.write(msg.files)], { type: "application/zip" });
+  const a = document.createElement("a"); a.href = URL.createObjectURL(blob);
+  a.download = msg.folder.replace(/[^\w.-]+/g, "_") + "-saves-" + new Date().toISOString().slice(0, 10) + ".zip";
+  a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 1000);
+  setStatus("Exported " + msg.files.length + " file" + (msg.files.length === 1 ? "" : "s"));
+}
+$("importSaves").addEventListener("change", async e => {
+  const f = e.target.files[0]; e.target.value = "";
+  if (!f || !currentEntry || !currentFolder) return;
+  if (!confirm("Replace this game's save data with " + f.name + "? The game starts again.")) return;
+  let files;
+  try { files = await CrankedZip.read(new Uint8Array(await f.arrayBuffer())); }
+  catch (err) { setStatus("Could not read " + f.name + ": " + err.message); return; }
+  const prefix = currentFolder + "/"; // a zip of the folder itself is accepted too
+  if (files.length && files.every(x => x.path.startsWith(prefix))) files = files.map(x => ({ path: x.path.slice(prefix.length), data: x.data }));
+  running = false; updateButtons(); setStatus("Importing...");
+  worker.postMessage({ type: "importSaves", folder: currentFolder, files });
+});
+function savesImported(msg) {
+  if (!msg.ok) { setStatus("Import failed: " + msg.error); return; }
+  if (currentEntry) startGame(currentEntry);
+}
+
+// ---------- buttons: pause, fullscreen, screenshot, sound ----------
+function updateButtons() {
+  $("pause").disabled = !running; $("shot").disabled = !running; $("exportSaves").disabled = !running || !currentFolder;
+  $("importLabel").style.display = running && currentFolder ? "" : "none";
+  $("pause").textContent = paused ? "Resume" : "Pause";
+}
+function setPaused(on) {
+  if (!running || paused === on) return;
+  paused = on; screen.classList.toggle("paused", paused); updateButtons();
+  worker.postMessage({ type: paused ? "pause" : "resume" });
+}
+$("pause").onclick = () => setPaused(!paused);
+let hiddenPause = false; // a hidden tab pauses the game, and showing it again resumes it unless it was paused by hand
+document.addEventListener("visibilitychange", () => {
+  if (document.hidden && running && !paused) { hiddenPause = true; setPaused(true); }
+  else if (!document.hidden && hiddenPause) { hiddenPause = false; setPaused(false); }
+});
+$("full").onclick = () => { if (document.fullscreenElement) document.exitFullscreen(); else screen.requestFullscreen().catch(() => {}); };
+$("shot").onclick = () => { // at least 800 pixels wide, at a whole multiple of the image
+  const lcd = $("lcd"), k = Math.max(1, Math.ceil(800 / lcd.width));
+  const c = document.createElement("canvas"); c.width = lcd.width * k; c.height = lcd.height * k;
+  const g = c.getContext("2d"); g.imageSmoothingEnabled = false; g.drawImage(lcd, 0, 0, c.width, c.height);
+  c.toBlob(blob => {
+    const a = document.createElement("a"); a.href = URL.createObjectURL(blob);
+    a.download = (currentTitle || "cranked").replace(/[^\w-]+/g, "_") + "-" + new Date().toISOString().replace(/[:.]/g, "-") + ".png";
+    a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 1000);
+  });
+};
+muted = load("cranked.muted") === "1";
+$("mute").textContent = muted ? "Sound off" : "Sound on";
+$("mute").onclick = e => {
+  muted = !muted; e.target.textContent = muted ? "Sound off" : "Sound on"; store("cranked.muted", muted ? "1" : "0");
+  if (audio) { if (muted) audio.suspend(); else audio.resume(); }
+  ensureAudio();
+};
+
+// ---------- audio: an AudioWorklet fed by the worker over its own channel ----------
+async function connectAudio() {
+  if (audio || typeof AudioContext === "undefined") return;
+  audio = new AudioContext({ sampleRate: RATE });
+  const channel = new MessageChannel();
+  let worklet = false;
+  if (audio.audioWorklet) { // only in secure contexts (https, localhost)
+    try {
+      await audio.audioWorklet.addModule("audio-worklet.js");
+      audioNode = new AudioWorkletNode(audio, "cranked-audio", { outputChannelCount: [2] });
+      audioNode.connect(audio.destination);
+      audioNode.port.postMessage({ port: channel.port1 }, [channel.port1]);
+      worklet = true;
+    } catch (e) { console.warn("audio worklet", e); }
+  }
+  if (!worklet) { // the chunks played as scheduled buffers on this thread
+    let at = 0;
+    channel.port1.onmessage = m => {
+      const samples = m.data, frames = samples.length / 2;
+      const buffer = audio.createBuffer(2, frames, RATE);
+      const left = buffer.getChannelData(0), right = buffer.getChannelData(1);
+      for (let i = 0; i < frames; i++) { left[i] = samples[2 * i] / 32768; right[i] = samples[2 * i + 1] / 32768; }
+      const now = audio.currentTime;
+      if (at < now + 0.02 || at > now + 0.3) at = now + 0.05; // restart after an underrun or a stall
+      const source = audio.createBufferSource(); source.buffer = buffer; source.connect(audio.destination);
+      source.start(at); at += frames / RATE;
+    };
