+// Proof of Concept player features: a game can travel inside the executable (appended to it) or next to it
+// (game.pdx or game.zip in the executable's folder, or in Contents/Resources of a macOS app). An appended game is:
+// the zip's bytes, then its length as 8 little-endian bytes, then "CRNKGAME".
+namespace {
+constexpr char EMBED_MAGIC[8] = { 'C', 'R', 'N', 'K', 'G', 'A', 'M', 'E' };
+constexpr int MAX_RECENT = 8;
+
+string sdlPath(char *path) { // takes an SDL path string, and frees it
+    string result = path ? path : "";
+    SDL_free(path);
+    return result;
+}
+
+// The executable's own file, from argv[0] (as given, or its name in SDL's base folder): no platform calls needed
+vector<fs::path> selfCandidates(const char *argv0) {
+    vector<fs::path> paths;
+    if (!argv0 or !*argv0)
+        return paths;
+    fs::path given = argv0;
+    paths.push_back(given);
+    auto base = sdlPath(SDL_GetBasePath());
+    if (!base.empty()) {
+        paths.push_back(fs::path(base) / given.filename());
+        paths.push_back(fs::path(base) / (given.filename().string() + ".exe"));
+    }
+    return paths;
+}
+
+// Copies an appended game out of the executable into the data folder (once per distinct game); the path, or empty
+string extractEmbeddedGame(const char *argv0, const fs::path &folder) {
+    for (auto &candidate : selfCandidates(argv0)) {
+        std::ifstream in(candidate, std::ios::binary);
+        if (!in)
+            continue;
+        in.seekg(0, std::ios::end);
+        auto fileSize = (int64) in.tellg();
+        if (fileSize < 16)
+            continue;
+        char trailer[16];
+        in.seekg(fileSize - 16);
+        if (!in.read(trailer, 16) or memcmp(trailer + 8, EMBED_MAGIC, 8) != 0)
+            continue;
+        uint64 size = 0;
+        for (int i = 7; i >= 0; i--)
+            size = size << 8 | (uint8) trailer[i];
+        if (size == 0 or size > (uint64) fileSize - 16)
+            continue;
+        vector<char> data(size);
+        in.seekg(fileSize - 16 - (int64) size);
+        if (!in.read(data.data(), (std::streamsize) size))
+            continue;
+        uint64 hash = 1469598103934665603ull; // FNV-1a: one copy per distinct game
+        for (char c : data)
+            hash = (hash ^ (uint8) c) * 1099511628211ull;
+        fs::create_directories(folder);
+        char name[40];
+        snprintf(name, sizeof(name), "embedded-%016llx.zip", (unsigned long long) hash);
+        auto out = folder / name;
+        std::error_code ec;
+        if (!fs::exists(out, ec) or fs::file_size(out, ec) != size) {
+            std::ofstream file(out, std::ios::binary | std::ios::trunc);
+            file.write(data.data(), (std::streamsize) size);
+            if (!file)
+                throw CrankedError("Could not write the game to {}", out.string());
+        }
+        return out.string();
+    }
+    return "";
+}
+
+// A game shipped beside the executable, or empty
+string bundledGame() {
+    auto base = sdlPath(SDL_GetBasePath());
+    if (base.empty())
+        return "";
+    std::error_code ec;
+    for (auto name : { "game.pdx", "game.zip" })
+        if (fs::exists(fs::path(base) / name, ec))
+            return (fs::path(base) / name).string();
+    return "";
+}
+
+// A folder that exists and takes a new file (a probe file is made and removed)
+bool writableFolder(const fs::path &folder) {
+    std::error_code ec;
+    if (!fs::is_directory(folder, ec))
+        return false;
+    auto probe = folder / ".cranked-write-test";
+    bool ok = (bool) std::ofstream(probe, std::ios::binary | std::ios::app);
+    fs::remove(probe, ec);
+    return ok;
+}
+
+// A file that exists and can be written (opened for appending, which does not change it)
+bool writableFile(const fs::path &file) {
+    std::error_code ec;
+    return fs::is_regular_file(file, ec) and (bool) std::ofstream(file, std::ios::binary | std::ios::app);
+}
+
+void addRecent(vector<string> &recent, const string &path) {
+    std::erase(recent, path);
+    recent.insert(recent.begin(), path);
+    if (recent.size() > MAX_RECENT)
+        recent.resize(MAX_RECENT);
+}
+}
