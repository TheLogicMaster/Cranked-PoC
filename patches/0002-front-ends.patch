+    if (e.target.checked && typeof DeviceOrientationEvent.requestPermission === "function")
+      DeviceOrientationEvent.requestPermission().then(r => { if (r !== "granted") { e.target.checked = false; lookChanged(); } }).catch(() => {});
+  });
+  let lastTilt = 0;
