+  table { border-collapse: collapse; margin-top: 8px; }
+  td { padding: 3px 14px 3px 0; vertical-align: top; }
+  td:first-child { color: var(--muted); white-space: nowrap; }
+  .touch { display: none; justify-content: space-between; align-items: center; gap: 12px; margin-top: 14px; user-select: none; touch-action: none; }
+  @media (pointer: coarse) { .touch { display: flex; } }
+  .touch.on { display: flex; }
+  .dpad { display: grid; grid-template-columns: repeat(3, 46px); grid-template-rows: repeat(3, 46px); flex: none; gap: 4px; }
+  .pad { border: 1px solid var(--line); background: var(--panel); color: var(--fg); border-radius: 10px; font: 600 16px system-ui; touch-action: none; padding: 0; }
+  .pad.down { background: var(--accent); color: #000; }
