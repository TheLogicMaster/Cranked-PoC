+    let at = 0;
+    channel.port1.onmessage = m => {
+      const samples = m.data, frames = samples.length / 2;
+      const buffer = audio.createBuffer(2, frames, RATE);
+      const left = buffer.getChannelData(0), right = buffer.getChannelData(1);
+      for (let i = 0; i < frames; i++) { left[i] = samples[2 * i] / 32768; right[i] = samples[2 * i + 1] / 32768; }
+      const now = audio.currentTime;
+      if (at < now + 0.02 || at > now + 0.3) at = now + 0.05; // restart after an underrun or a stall
+      const source = audio.createBufferSource(); source.buffer = buffer; source.connect(audio.destination);
+      source.start(at); at += frames / RATE;
+    };
+  }
+  worker.postMessage({ type: "audioPort", port: channel.port2 }, [channel.port2]);
+  if (muted) audio.suspend();
+}
+function ensureAudio() { // browsers start audio only after a user gesture
+  if (audio && !muted && audio.state === "suspended") audio.resume().catch(() => {});
+}
+
+// ---------- input ----------
+function turn(degrees) { crank = ((crank + degrees) % 360 + 360) % 360; docked = false; sendInput(); }
+addEventListener("keydown", e => {
+  if (e.target instanceof HTMLInputElement) return;
+  if (e.code in BUTTONS) { buttons |= BUTTONS[e.code]; e.preventDefault(); sendInput(); }
+  else if (e.code === "Comma") turn(-10);
+  else if (e.code === "Period") turn(10);
+  else if (e.code === "KeyC") { docked = !docked; sendInput(); }
+  else if (e.code === "KeyP" && !e.repeat) setPaused(!paused);
+  ensureAudio();
+});
+addEventListener("keyup", e => { if (e.code in BUTTONS) { buttons &= ~BUTTONS[e.code]; sendInput(); } });
+addEventListener("blur", () => { buttons = 0; sendInput(); });
+screen.addEventListener("wheel", e => { e.preventDefault(); turn(e.deltaY / 4); }, { passive: false });
+screen.addEventListener("pointerdown", ensureAudio);
+
+// Touch controls (shown on touch screens): held buttons set their bits; dragging round the dial turns the crank
+let touchBits = 0;
+if (navigator.maxTouchPoints > 0) $("touch").classList.add("on");
+for (const el of document.querySelectorAll(".pad[data-bit]")) {
+  const bit = +el.dataset.bit;
+  const press = e => { e.preventDefault(); el.setPointerCapture(e.pointerId); touchBits |= bit; el.classList.add("down"); ensureAudio(); sendInput(); };
+  const release = () => { touchBits &= ~bit; el.classList.remove("down"); sendInput(); };
+  el.addEventListener("pointerdown", press);
+  for (const t of ["pointerup", "pointercancel", "lostpointercapture"]) el.addEventListener(t, release);
+}
+const dial = $("crankdial");
+function dialAngle(e) {
+  const r = dial.getBoundingClientRect();
+  return Math.atan2(e.clientX - (r.left + r.width / 2), -(e.clientY - (r.top + r.height / 2))) * 180 / Math.PI;
+}
+let dialLast = null;
+dial.addEventListener("pointerdown", e => { e.preventDefault(); dial.setPointerCapture(e.pointerId); dialLast = dialAngle(e); ensureAudio(); });
+dial.addEventListener("pointermove", e => {
+  if (dialLast === null) return;
+  const a = dialAngle(e); let d = a - dialLast; dialLast = a;
+  if (d > 180) d -= 360; if (d < -180) d += 360;
+  turn(d);
+});
+for (const t of ["pointerup", "pointercancel"]) dial.addEventListener(t, () => { dialLast = null; });
+
+// Gamepads (standard mapping), as the libretro core maps a RetroPad: the d-pad or left stick; the right face button
+// is A, the bottom one B; Start or Back the menu; the right stick points the crank and the shoulder buttons turn it
+let padBits = 0;
+function pollPads() {
+  let bits = 0, moved = false;
+  for (const pad of navigator.getGamepads ? navigator.getGamepads() : []) {
+    if (!pad || pad.mapping !== "standard") continue;
+    const on = i => pad.buttons[i] && pad.buttons[i].pressed;
+    const lx = pad.axes[0] || 0, ly = pad.axes[1] || 0; // the left stick works as the d-pad too
+    if (on(14) || lx < -0.5) bits |= 1; if (on(15) || lx > 0.5) bits |= 2; if (on(12) || ly < -0.5) bits |= 4; if (on(13) || ly > 0.5) bits |= 8;
+    if (on(0)) bits |= 16; if (on(1)) bits |= 32; if (on(9) || on(8)) bits |= 128;
+    const x = pad.axes[2] || 0, y = pad.axes[3] || 0;
+    if (x * x + y * y > 0.25) { crank = ((Math.atan2(x, -y) * 180 / Math.PI) + 360) % 360; docked = false; moved = true; }
+    if (on(4)) { crank = ((crank - 6) % 360 + 360) % 360; docked = false; moved = true; }
+    if (on(5)) { crank = (crank + 6) % 360; docked = false; moved = true; }
+  }
+  if (bits !== padBits || moved) { padBits = bits; sendInput(); }
+  if (bits) ensureAudio();
+}
+
+// ---------- drawing: the newest frame from the worker, once per animation frame ----------
+let image = null, shownAt = 0;
+function draw(time) {
+  pollPads();
+  if (latest) {
+    const data = new Uint8ClampedArray(latest); latest = null;
+    if (!image) image = new ImageData(400, 240);
+    image.data.set(data); ctx2d.putImageData(image, 0, 0);
+  }
+  dial.style.setProperty("--angle", crank + "deg");
+  if (running && !paused && time - shownAt > 500) { shownAt = time; setStatus("Running \u00b7 " + frameMs.toFixed(2) + " ms per step"); }
+  requestAnimationFrame(draw);
+}
+requestAnimationFrame(draw);
+
+// Installable and usable offline (a service worker needs https or localhost)
+if ("serviceWorker" in navigator && (location.protocol === "https:" || location.hostname === "localhost" || location.hostname === "127.0.0.1"))
+  navigator.serviceWorker.register("sw.js").catch(e => console.warn("service worker", e));
+</script>
+</body>
+</html>
diff --git a/web/main.cpp b/web/main.cpp
new file mode 100644
index 0000000..f8fdee9
--- /dev/null
+++ b/web/main.cpp
@@ -0,0 +1,102 @@
+// Browser front end (WebAssembly, Emscripten). The page drives it: it writes the game into the in-memory
+// file system, calls web_load, then web_frame once per animation frame with the input and the elapsed time, and draws
+// the returned RGBA frame; web_audio fills the audio queue. The game's clock is virtual and advanced by the page, so a
+// hidden tab (no animation frames) pauses the game instead of making it jump ahead.
+#include "Cranked.hpp"
+
+#include <emscripten/emscripten.h>
+#include <cstdio>
+#include <string>
+
+using namespace cranked;
+
+static Cranked *instance;
+static bool failed;
+static std::string lastError; // shown by the page
+
+template<typename F>
+static bool guarded(const char *what, F &&f) {
+    try {
+        f();
+        return true;
+    } catch (std::exception &e) {
+        std::fprintf(stderr, "Cranked: %s failed: %s\n", what, e.what());
+        lastError = std::string(what) + " failed: " + e.what();
+    } catch (...) {
+        lastError = std::string(what) + " failed";
+        std::fprintf(stderr, "Cranked: %s failed\n", what);
+    }
+    failed = true;
+    return false;
+}
+
+extern "C" {
+
+// Loads and starts the game at path (a .pdx folder or a zipped one); 1 on success
+EMSCRIPTEN_KEEPALIVE int web_load(const char *path) {
+    if (instance) {
+        guarded("unloading the game", [] { instance->unload(); });
+        delete instance;
+    }
+    instance = new Cranked;
+    instance->useVirtualClock();
+    instance->crankDocked = true;
+    failed = false;
+    return guarded("loading the game", [&] {
+        instance->load(path);
+        instance->start();
+    });
+}
+
+// Unloads the game (before its save data is replaced, so a game that saves when it ends cannot overwrite it)
+EMSCRIPTEN_KEEPALIVE void web_unload() {
+    if (instance) {
+        guarded("unloading the game", [] { instance->unload(); });
+        delete instance;
+        instance = nullptr;
+    }
+}
+
+// One step: buttons are PDButtons bits, crank in degrees (0 up, clockwise). Returns the 400x240 frame as RGBA bytes.
+EMSCRIPTEN_KEEPALIVE const uint8_t *web_frame(int buttons, float crank, int docked, int micros) {
+    if (!instance)
+        return nullptr;
+    if (!failed) {
+        instance->currentInputs = buttons;
+        instance->crankAngle = crank;
+        instance->crankDocked = docked != 0;
+        instance->advanceVirtualClock(micros);
+        guarded("update", [] { instance->update(); });
+    }
+    return (const uint8_t *) instance->graphics.displayBufferRGBA;
+}
+
+// Interleaved stereo 16-bit samples at 44.1 kHz (silence once the game has stopped)
+EMSCRIPTEN_KEEPALIVE void web_audio(int16_t *out, int frames) {
+    memset(out, 0, (size_t) frames * 4);
+    if (instance and !failed)
+        guarded("audio", [&] { instance->audio.sampleAudio(out, frames); });
+}
+
+// A pdxinfo field of the loaded game ("name", "author", "bundleID", ...), or an empty string
+EMSCRIPTEN_KEEPALIVE const char *web_info(const char *key) {
+    if (!instance or !instance->rom)
+        return "";
+    if (std::string(key) == "_dataFolder") { // the save data's folder name under /appData (for export and import)
+        static std::string folder;
+        folder = instance->files.getRomDataPath().filename().string();
+        return folder.c_str();
+    }
+    auto value = instance->rom->getManifestString(key);
+    return value ? value : "";
+}
+
+EMSCRIPTEN_KEEPALIVE const char *web_error() {
+    return lastError.c_str();
+}
+
+EMSCRIPTEN_KEEPALIVE int web_failed() {
+    return failed ? 1 : 0;
+}
+
+}
