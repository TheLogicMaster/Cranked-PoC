+</script>
+</body>
+</html>
diff --git a/web/main.cpp b/web/main.cpp
new file mode 100644
index 0000000..951cd3b
--- /dev/null
+++ b/web/main.cpp
@@ -0,0 +1,121 @@
+// Browser front end (WebAssembly, Emscripten). The page drives it: it writes the game into the in-memory
+// file system, calls web_load, then web_frame once per animation frame with the input and the elapsed time, and draws
+// the returned RGBA frame; web_audio fills the audio queue. The game's clock is virtual and advanced by the page, so a
+// hidden tab (no animation frames) pauses the game instead of making it jump ahead.
+#include "Cranked.hpp"
+#include "ScreenEffects.hpp"
+
+#include <emscripten/emscripten.h>
+#include <cstdio>
+#include <string>
+
+using namespace cranked;
+
+static Cranked *instance;
+static bool failed;
+static std::string lastError; // shown by the page
+static ScreenEffects screenEffects;
+
+template<typename F>
+static bool guarded(const char *what, F &&f) {
+    try {
+        f();
+        return true;
+    } catch (std::exception &e) {
+        std::fprintf(stderr, "Cranked: %s failed: %s\n", what, e.what());
+        lastError = std::string(what) + " failed: " + e.what();
+    } catch (...) {
+        lastError = std::string(what) + " failed";
+        std::fprintf(stderr, "Cranked: %s failed\n", what);
+    }
+    failed = true;
+    return false;
+}
+
+extern "C" {
+
+// Loads and starts the game at path (a .pdx folder or a zipped one); 1 on success
+EMSCRIPTEN_KEEPALIVE int web_load(const char *path) {
+    if (instance) {
+        guarded("unloading the game", [] { instance->unload(); });
+        delete instance;
+    }
+    instance = new Cranked;
+    screenEffects.reset();
+    instance->useVirtualClock();
+    instance->crankDocked = true;
+    failed = false;
+    return guarded("loading the game", [&] {
+        instance->load(path);
+        instance->start();
+    });
+}
+
+// Unloads the game (before its save data is replaced, so a game that saves when it ends cannot overwrite it)
+EMSCRIPTEN_KEEPALIVE void web_unload() {
+    if (instance) {
+        guarded("unloading the game", [] { instance->unload(); });
+        delete instance;
+        instance = nullptr;
+    }
+}
+
+// One step: buttons are PDButtons bits, crank in degrees (0 up, clockwise). Returns the 400x240 frame as RGBA bytes.
+EMSCRIPTEN_KEEPALIVE const uint8_t *web_frame(int buttons, float crank, int docked, int micros) {
+    if (!instance)
+        return nullptr;
+    if (!failed) {
+        instance->currentInputs = buttons;
+        instance->crankAngle = crank;
+        instance->crankDocked = docked != 0;
+        instance->advanceVirtualClock(micros);
+        guarded("update", [] { instance->update(); });
+    }
+    return (const uint8_t *) instance->graphics.displayBufferRGBA;
+}
+
+// The frame through the screen's effects: a color preset, flags (1 blend frames, 2 pixel grid, 4 pixel shadow,
+// 8 scanlines, 16 device frame), the room's light and tilt, at a whole scale. RGBA bytes, web_render_width() by
+// web_render_height().
+EMSCRIPTEN_KEEPALIVE const uint8_t *web_render(int colors, int flags, float light, float tiltX, float tiltY, int scale) {
+    if (!instance)
+        return nullptr;
+    ScreenEffectSettings settings;
+    settings.colors = colors;
+    settings.blendFrames = flags & 1; settings.pixelGrid = flags & 2; settings.pixelShadow = flags & 4;
+    settings.scanlines = flags & 8; settings.deviceFrame = flags & 16;
+    settings.roomLight = light; settings.tiltX = tiltX; settings.tiltY = tiltY;
+    return (const uint8_t *) screenEffects.render(*instance, settings, scale, ScreenEffects::Format::RGBA);
+}
+EMSCRIPTEN_KEEPALIVE int web_render_width() { return screenEffects.width; }
+EMSCRIPTEN_KEEPALIVE int web_render_height() { return screenEffects.height; }
+
+// Interleaved stereo 16-bit samples at 44.1 kHz (silence once the game has stopped)
+EMSCRIPTEN_KEEPALIVE void web_audio(int16_t *out, int frames) {
+    memset(out, 0, (size_t) frames * 4);
+    if (instance and !failed)
+        guarded("audio", [&] { instance->audio.sampleAudio(out, frames); });
+}
+
+// A pdxinfo field of the loaded game ("name", "author", "bundleID", ...), or an empty string
+EMSCRIPTEN_KEEPALIVE const char *web_info(const char *key) {
+    if (!instance or !instance->rom)
+        return "";
+    if (std::string(key) == "_dataFolder") { // the save data's folder name under /appData (for export and import)
+        static std::string folder;
+        folder = instance->files.getRomDataPath().filename().string();
+        return folder.c_str();
+    }
+    auto value = instance->rom->getManifestString(key);
+    return value ? value : "";
+}
+
+EMSCRIPTEN_KEEPALIVE const char *web_error() {
+    return lastError.c_str();
+}
+
+EMSCRIPTEN_KEEPALIVE int web_failed() {
+    return failed ? 1 : 0;
+}
+
+}
