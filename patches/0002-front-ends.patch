+    if (on(14) || lx < -0.5) bits |= 1; if (on(15) || lx > 0.5) bits |= 2; if (on(12) || ly < -0.5) bits |= 4; if (on(13) || ly > 0.5) bits |= 8;
+    if (on(0)) bits |= 16; if (on(1)) bits |= 32; if (on(9) || on(8)) bits |= 128;
+    const x = pad.axes[2] || 0, y = pad.axes[3] || 0;
+    if (x * x + y * y > 0.25) { crank = ((Math.atan2(x, -y) * 180 / Math.PI) + 360) % 360; docked = false; moved = true; }
+    if (on(4)) { crank = ((crank - 6) % 360 + 360) % 360; docked = false; moved = true; }
+    if (on(5)) { crank = (crank + 6) % 360; docked = false; moved = true; }
+  }
+  if (bits !== padBits || moved) { padBits = bits; sendInput(); }
+  if (bits) ensureAudio();
+}
+
+// ---------- the screen's look: colors and effects, drawn by the engine (ScreenEffects), kept in this browser ----------
+const COLOR_PRESETS = ["Playdate", "Bright room", "Paper", "Game Boy", "Amber", "High contrast"]; // as in ScreenEffects.cpp
+const LOOK_DEFAULT = { colors: 0, blend: false, grid: false, shadow: false, light: 0, tilt: false, scan: false, device: false };
+let look = { ...LOOK_DEFAULT }, tiltX = 0, tiltY = 0;
+try { Object.assign(look, JSON.parse(load("cranked.look") || "{}")); } catch (e) {}
+for (const [i, name] of COLOR_PRESETS.entries()) $("lookColors").append(new Option(name, i));
+const lookInputs = { colors: "lookColors", blend: "lookBlend", grid: "lookGrid", shadow: "lookShadow", light: "lookLight", tilt: "lookTilt", scan: "lookScan", device: "lookDevice" };
+function showLook() {
+  for (const [key, id] of Object.entries(lookInputs)) { const el = $(id); if (el.type === "checkbox") el.checked = look[key]; else el.value = look[key]; }
+}
+// the whole scale to draw at: the effects that work on parts of a pixel need the size the image is shown at
+function lookScale() {
+  if (!(look.grid || look.shadow || look.scan || look.device)) return 1;
+  const unit = look.device ? 630 : 400; // the drawn device's width (ScreenEffects::outputSize), or the screen's
+  const shown = $("lcd").getBoundingClientRect().width * (devicePixelRatio || 1);
+  return Math.min(4, Math.max(1, Math.ceil(shown / unit - 0.01)));
+}
+function sendLook() {
+  const flags = (look.blend ? 1 : 0) | (look.grid ? 2 : 0) | (look.shadow ? 4 : 0) | (look.scan ? 8 : 0) | (look.device ? 16 : 0);
+  const unit = look.device ? [630, 504] : [400, 240];
+  $("lcd").style.setProperty("--ar", (unit[0] / unit[1]).toFixed(4));
+  $("lcd").classList.toggle("device", look.device);
+  worker.postMessage({ type: "screen", screen: { colors: +look.colors, flags, light: +look.light, tiltX: look.tilt ? tiltX : 0, tiltY: look.tilt ? tiltY : 0, scale: lookScale() } });
+}
+function lookChanged() {
+  for (const [key, id] of Object.entries(lookInputs)) { const el = $(id); look[key] = el.type === "checkbox" ? el.checked : el.type === "range" ? +el.value : +el.value; }
+  store("cranked.look", JSON.stringify(look));
+  sendLook();
+}
+for (const id of Object.values(lookInputs)) $(id).addEventListener("input", lookChanged);
+$("lookReset").onclick = () => { look = { ...LOOK_DEFAULT }; showLook(); lookChanged(); };
