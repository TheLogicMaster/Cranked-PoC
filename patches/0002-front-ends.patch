+function ensureAudio() { // browsers start audio only after a user gesture
+  if (audio && !muted && audio.state === "suspended") audio.resume().catch(() => {});
+}
+
+// ---------- input ----------
+function turn(degrees) { crank = ((crank + degrees) % 360 + 360) % 360; docked = false; sendInput(); }
+addEventListener("keydown", e => {
+  if (e.target instanceof HTMLInputElement || e.target instanceof HTMLSelectElement) return;
+  if (e.code in BUTTONS) { buttons |= BUTTONS[e.code]; e.preventDefault(); sendInput(); }
+  else if (e.code === "Comma") turn(-10);
+  else if (e.code === "Period") turn(10);
+  else if (e.code === "KeyC") { docked = !docked; sendInput(); }
+  else if (e.code === "KeyP" && !e.repeat) setPaused(!paused);
+  ensureAudio();
+});
+addEventListener("keyup", e => { if (e.code in BUTTONS) { buttons &= ~BUTTONS[e.code]; sendInput(); } });
+addEventListener("blur", () => { buttons = 0; sendInput(); });
+screen.addEventListener("wheel", e => { e.preventDefault(); turn(e.deltaY / 4); }, { passive: false });
+screen.addEventListener("pointerdown", ensureAudio);
+
+// Touch controls (shown on touch screens): held buttons set their bits; dragging round the dial turns the crank
+let touchBits = 0;
+if (navigator.maxTouchPoints > 0) $("touch").classList.add("on");
+for (const el of document.querySelectorAll(".pad[data-bit]")) {
+  const bit = +el.dataset.bit;
+  const press = e => { e.preventDefault(); el.setPointerCapture(e.pointerId); touchBits |= bit; el.classList.add("down"); ensureAudio(); sendInput(); };
+  const release = () => { touchBits &= ~bit; el.classList.remove("down"); sendInput(); };
+  el.addEventListener("pointerdown", press);
+  for (const t of ["pointerup", "pointercancel", "lostpointercapture"]) el.addEventListener(t, release);
