+new ResizeObserver(() => sendLook()).observe($("lcd")); // the scale follows the shown size
+showLook(); sendLook();
+
+// ---------- drawing: the newest frame from the worker, once per animation frame ----------
+let image = null, shownAt = 0, latestWidth = 400, latestHeight = 240;
+function draw(time) {
+  pollPads();
+  if (latest) {
+    const data = new Uint8ClampedArray(latest); latest = null;
+    const lcd = $("lcd");
+    if (lcd.width !== latestWidth || lcd.height !== latestHeight) { lcd.width = latestWidth; lcd.height = latestHeight; }
+    if (!image || image.width !== latestWidth || image.height !== latestHeight) image = new ImageData(latestWidth, latestHeight);
+    image.data.set(data); ctx2d.putImageData(image, 0, 0);
+    // drawn larger than shown: smoothed when shrunk, so the grid's lines do not come and go; else crisp
+    lcd.style.imageRendering = lcd.width > lcd.getBoundingClientRect().width * (devicePixelRatio || 1) + 1 ? "auto" : "pixelated";
+  }
+  dial.style.setProperty("--angle", crank + "deg");
+  if (running && !paused && time - shownAt > 500) { shownAt = time; setStatus("Running \u00b7 " + frameMs.toFixed(2) + " ms per step"); }
