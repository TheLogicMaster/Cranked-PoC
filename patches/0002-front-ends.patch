+const dial = $("crankdial");
+function dialAngle(e) {
+  const r = dial.getBoundingClientRect();
+  return Math.atan2(e.clientX - (r.left + r.width / 2), -(e.clientY - (r.top + r.height / 2))) * 180 / Math.PI;
+}
+let dialLast = null;
+dial.addEventListener("pointerdown", e => { e.preventDefault(); dial.setPointerCapture(e.pointerId); dialLast = dialAngle(e); ensureAudio(); });
+dial.addEventListener("pointermove", e => {
+  if (dialLast === null) return;
+  const a = dialAngle(e); let d = a - dialLast; dialLast = a;
+  if (d > 180) d -= 360; if (d < -180) d += 360;
+  turn(d);
+});
+for (const t of ["pointerup", "pointercancel"]) dial.addEventListener(t, () => { dialLast = null; });
