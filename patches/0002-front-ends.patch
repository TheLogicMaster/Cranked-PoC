diff --git a/web/index.html b/web/index.html
new file mode 100644
index 0000000..8735412
--- /dev/null
+++ b/web/index.html
@@ -0,0 +1,612 @@
+<!doctype html>
+<!-- Browser front end for Cranked (WebAssembly). Serve this folder over HTTP with cranked.js and cranked.wasm. -->
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="theme-color" content="#1f1d1a">
+<link rel="manifest" href="manifest.webmanifest">
+<link rel="icon" href="icon-192.png">
+<title>Cranked</title>
+<style>
+  :root {
+    --bg: #f4f2ec; --fg: #1f1d1a; --muted: #6b665d; --line: #d9d4c8; --panel: #fffdf8; --accent: #b8860b;
+  }
+  @media (prefers-color-scheme: dark) {
+    :root { --bg: #171614; --fg: #ebe7de; --muted: #9b958a; --line: #34312c; --panel: #201f1c; --accent: #e0b040; }
+  }
+  * { box-sizing: border-box; }
+  body { margin: 0; background: var(--bg); color: var(--fg); font: 15px/1.5 system-ui, sans-serif; }
+  main { max-width: 860px; margin: 0 auto; padding: 20px 16px 48px; }
+  header { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
+  h1 { font-size: 20px; margin: 0; letter-spacing: .02em; }
+  h2 { font-size: 15px; margin: 24px 0 8px; }
+  .sub { margin: 0; color: var(--muted); font-size: 14px; }
+  .screen { background: #000; border-radius: 10px; padding: 12px; display: flex; justify-content: center; align-items: center; position: relative; }
+  .screen:fullscreen { border-radius: 0; padding: 0; }
+  /* --ar: the shown image's width over its height (the screen's 5 / 3, or the drawn device's) */
+  canvas { width: 100%; max-width: 800px; aspect-ratio: var(--ar, 1.6667); image-rendering: pixelated; background: #b1aea7; display: block; }
+  canvas.device { background: transparent; }
+  .screen:fullscreen canvas { max-width: none; width: min(100vw, calc(100vh * var(--ar, 1.6667))); }
+  .look { display: flex; flex-wrap: wrap; gap: 8px 18px; align-items: center; margin-top: 8px; }
+  .look label { display: inline-flex; gap: 6px; align-items: center; }
+  .look [hidden] { display: none; }
+  .look select, .look input[type=range] { font: inherit; }
