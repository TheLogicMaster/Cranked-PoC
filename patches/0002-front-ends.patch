+    if (!look.tilt || !look.light || e.gamma === null) return;
+    tiltX = Math.max(-1, Math.min(1, e.gamma / 40)); // left and right
+    tiltY = Math.max(-1, Math.min(1, (e.beta - 45) / 40)); // toward and away, from a phone held at 45 degrees
