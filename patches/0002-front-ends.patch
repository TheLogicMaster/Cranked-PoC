+  .crank::after { content: ""; position: absolute; left: 50%; top: 6px; width: 4px; height: 34px; margin-left: -2px; background: var(--accent); border-radius: 2px; transform-origin: 2px 34px; transform: rotate(var(--angle, 0deg)); }
+  /* a phone: the pads shrink so the row fits (and again below 350 px, for 320 px screens) */
+  @media (max-width: 420px) {
