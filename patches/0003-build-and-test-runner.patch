 if (NOT SKIP_LIBRETRO)
     add_subdirectory(libretro)
 endif ()
+add_subdirectory(runner)
+if (EMSCRIPTEN) # browser front end
+    add_subdirectory(web)
+endif ()
+if (DJGPP) # DOS front end
+    add_subdirectory(dos)
+endif ()
diff --git a/cmake/djgpp.cmake b/cmake/djgpp.cmake
new file mode 100644
index 0000000..bc0d037
--- /dev/null
+++ b/cmake/djgpp.cmake
@@ -0,0 +1,18 @@
+# CMake toolchain file for the DJGPP cross compiler (32-bit DOS, i386-pc-msdosdjgpp). The code needs a Pentium
+# (i586) or later with an FPU. DJGPP_PREFIX is the folder the toolchain is installed in.
+set(CMAKE_SYSTEM_NAME Generic)
+set(CMAKE_SYSTEM_PROCESSOR i386)
+set(DJGPP ON)
+set(DJGPP_PREFIX "$ENV{DJGPP_PREFIX}" CACHE PATH "DJGPP install folder")
+set(CMAKE_C_COMPILER ${DJGPP_PREFIX}/bin/i386-pc-msdosdjgpp-gcc)
+set(CMAKE_CXX_COMPILER ${DJGPP_PREFIX}/bin/i386-pc-msdosdjgpp-g++)
+set(CMAKE_AR ${DJGPP_PREFIX}/bin/i386-pc-msdosdjgpp-ar)
+set(CMAKE_RANLIB ${DJGPP_PREFIX}/bin/i386-pc-msdosdjgpp-ranlib)
+set(CMAKE_EXECUTABLE_SUFFIX .exe)
+set(CMAKE_FIND_ROOT_PATH ${DJGPP_PREFIX}/i386-pc-msdosdjgpp)
+set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
+set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
+set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
+set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
+set(CMAKE_C_FLAGS_INIT "-march=i586 -mtune=i686")
+set(CMAKE_CXX_FLAGS_INIT "-march=i586 -mtune=i686")
