diff --git a/CMakeLists.txt b/CMakeLists.txt
index afdb1c3..9814fa4 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -7,6 +7,17 @@ project(cranked)
 set(CMAKE_CXX_STANDARD 20)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
 set(CMAKE_CXX_EXTENSIONS OFF)
+if (DJGPP) # its headers declare POSIX types (off_t) only in GNU mode
+    set(CMAKE_CXX_EXTENSIONS ON)
+endif ()
+# the libretro core and the Java binding are shared libraries, so every static library linked into them must be
+# position independent (otherwise the bundled asio fails to link: "relocation R_X86_64_TPOFF32 ... can not be used
+# when making a shared object")
+set(CMAKE_POSITION_INDEPENDENT_CODE ON)
+# the bundled libraries are linked in statically, so the programs run without the build folder's shared libraries
+# (libzip's own option would otherwise make every library shared, and under MSVC Capstone's static and shared
+# libraries would both be capstone.lib)
+option(BUILD_SHARED_LIBS "Build the bundled libraries as shared libraries" OFF)
 
 add_subdirectory(core)
 
