+    # Opaque values: userdata and context pointers are stored and handed back by the API, never dereferenced, so they
+    # are passed as raw 32-bit values instead of being translated as addresses. A game may pass any value, such as
+    # (void *) 1, and translation can only work for addresses inside emulated memory.
+    OPAQUE_PARAM_NAMES = {'userdata', 'ud', 'buttonud', 'context'}
+    opaque = CType('cref_t', emu_type='uint32_t', wrapper_type='cref_t')
+    for func in functions:
+        for param in func.params:
+            if isinstance(param, CField) and param.field_name in OPAQUE_PARAM_NAMES and param.c_type.wrapper_type == 'void *':
+                param.c_type = opaque
+        if func.qualified_name.endswith('Userdata') and func.qualified_name.split('_')[-1].startswith('get') and func.return_type.wrapper_type == 'void *':
+            func.return_type = opaque
+
