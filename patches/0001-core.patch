+                renderSegment(left + off, right + off, seg, ampPrev, a1, ampPrevR, b1, off, n); any = true;
+            }
+            ampPrev = a1; ampPrevR = b1;
+            off += seg;
+            // once the next note is due by the block's end, the playing note
+            // renders only this one segment; the synth then skips ahead to the next note's start (silent in between)
+            // and starts it there, with no note-off for the old note
+            if (!pendingNotes.empty() and pendingNotes.front().start <= T + (uint32) n) { off = stop; first = false; break; }
+            if (first and lengthLeft == off) { release(); envelopeNoteOff(off); }
+            first = false;
+        }
+        if (off >= n and (envDone or envClock == -1 or (sample and sampleSilent))) { // a sample that ran out ends the note
+            // with a note queued the synth stays active, so the next note keeps the oscillator phase
+            noteActive = false; idle = pendingNotes.empty(); envDone = false;
+            if (pendingNotes.empty()) { playing = false; cranked.audio.finishedSources.push_back(this); }
+        }
+    }
+    return any;
+}
