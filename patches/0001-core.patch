@@ -0,0 +1,799 @@
+// Playdate-compatible JSON decoder. See JsonDecoder.hpp.
+#include "JsonDecoder.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <cstdio>
+#include <cstring>
+
+namespace jsondecoder {
+
+namespace {
+
+constexpr int kEnd = -1;      // no more input
+constexpr int kNothing = -2;  // pushback slot empty
+
+std::string upToNul(const std::string &s) {
+    size_t z = s.find('\0');
+    return z == std::string::npos ? s : s.substr(0, z);
+}
+
+// Index digits for sublist names are written least significant first:
+// element 13 is "[31]".
+std::string reversedDigits(int n) {
+    std::string r;
+    do {
+        r.push_back(char('0' + n % 10));
+        n /= 10;
+    } while (n > 0);
+    return r;
+}
+
+bool isDigit(int c) { return c >= '0' && c <= '9'; }
+
+int hexNibble(int c) {
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return 0;  // anything else counts as 0 ("\uZZ41" is "A")
+}
+
+void appendCodepoint(std::string &s, unsigned cp) {
+    if (cp < 0x100) {
+        s.push_back(char(cp));  // Latin-1 range: a single raw byte
+    } else if (cp < 0x800) {
+        s.push_back(char(0xC0 | (cp >> 6)));
+        s.push_back(char(0x80 | (cp & 0x3F)));
+    } else {
+        s.push_back(char(0xE0 | (cp >> 12)));
+        s.push_back(char(0x80 | ((cp >> 6) & 0x3F)));
+        s.push_back(char(0x80 | (cp & 0x3F)));
+    }
+}
+
+// Nearest float and nearest double to 10^e, from the C library's correctly
+// rounded text conversion. Outside the tables the result is 0 or infinity.
+constexpr int kFloatPowMin = -46, kFloatPowMax = 39;
+constexpr int kDoublePowMin = -330, kDoublePowMax = 310;
+
+float floatPowerOfTen(int32_t e) {
+    static const std::vector<float> table = [] {
+        std::vector<float> t;
+        char text[16];
+        for (int k = kFloatPowMin; k <= kFloatPowMax; ++k) {
+            std::snprintf(text, sizeof text, "1e%d", k);
+            t.push_back(std::strtof(text, nullptr));
+        }
+        return t;
+    }();
+    if (e < kFloatPowMin) return 0.0f;
+    if (e > kFloatPowMax) return INFINITY;
+    return table[size_t(e - kFloatPowMin)];
+}
+
+double doublePowerOfTen(int32_t e) {
+    static const std::vector<double> table = [] {
+        std::vector<double> t;
+        char text[16];
+        for (int k = kDoublePowMin; k <= kDoublePowMax; ++k) {
+            std::snprintf(text, sizeof text, "1e%d", k);
+            t.push_back(std::strtod(text, nullptr));
+        }
+        return t;
+    }();
+    if (e < kDoublePowMin) return 0.0;
+    if (e > kDoublePowMax) return INFINITY;
+    return table[size_t(e - kDoublePowMin)];
+}
+
+// 0 times infinity ("0.0e39", "0e400") gives the NaN with bits 0xFFC00000 in
+// the Simulator, whatever the signs.
+float canonicalNan(float f) {
+    if (!std::isnan(f)) return f;
+    uint32_t bits = 0xFFC00000u;
+    std::memcpy(&f, &bits, 4);
+    return f;
+}
+
+// Where a sublist would be placed: its callback name and its path.
+struct Place {
+    std::string name;
+    std::string path;
+};
+
+}  // namespace
+
+struct DecoderImpl {
+    const ReadFn *reader = nullptr;
+    std::vector<uint8_t> chunk = std::vector<uint8_t>(1024);
+    int chunkLen = 0;
+    int chunkPos = 0;
+    bool ended = false;
+    int held = kNothing;
+    int line = 1;
+    int depth = 0;
+    bool rootIsList = false;
+    std::string rootPath;
+    const char *errPath = "";
+    Decoder dec;
+    DecodeStatus status;
+
+    // ---- byte source ----
+    int pull() {
+        if (held != kNothing) {
+            int c = held;
+            held = kNothing;
+            return c;
+        }
+        if (chunkPos >= chunkLen) {
+            if (ended) return kEnd;
+            int n = (*reader)(chunk.data(), 1024);
+            if (n <= 0) {
+                ended = true;
+                return kEnd;
+            }
+            chunkLen = n > 1024 ? 1024 : n;
+            chunkPos = 0;
+        }
+        return chunk[chunkPos++];
+    }
+    // A pushed-back NUL byte is lost.
+    void unpull(int c) {
+        if (c != 0) held = c;
+    }
+    // Skips white space. A NUL byte ending the white space is dropped and the
+    // byte after it is returned as is.
+    // At the top level a NUL byte is returned like any other byte.
+    int nextToken(bool topLevel = false) {
+        for (;;) {
+            int c = pull();
+            if (c == '\n') {
+                ++line;
+            } else if (c == 0 && !topLevel) {
+                return pull();
+            } else if (c != ' ' && c != '\t' && c != '\r') {
+                return c;
+            }
+        }
+    }
+    static bool atTopEnd(int c) { return c == kEnd || c == 0xFF; }
+
+    // ---- errors ----
+    bool fail(const char *msg) {
+        dec.hdr.path = errPath;
+        if (dec.hdr.cb.decodeError) dec.hdr.cb.decodeError(dec, msg, line);
+        return false;
+    }
+    bool callbackRaisedError() {
+        if (!dec.hdr.errorMsg) return false;
+        const char *m = dec.hdr.errorMsg;
+        if (dec.hdr.cb.decodeError) dec.hdr.cb.decodeError(dec, m, line);
+        return true;
+    }
+
+    // ---- scalars ----
+    bool readText(std::string &out) {
+        for (;;) {
+            int c = pull();
+            if (c == kEnd) return fail("read_string() hit end of file");
+            if (c == '"') return true;
+            if (c != '\\') {
+                out.push_back(char(c));
+                continue;
+            }
+            int e = pull();
+            switch (e) {
+            case kEnd: return fail("read_string() hit end of file");
+            case '"': out.push_back('"'); break;
+            case '\\': out.push_back('\\'); break;
+            case '/': out.push_back('/'); break;
+            case 'b': out.push_back('\b'); break;
+            case 'f': out.push_back('\f'); break;
+            case 'n': out.push_back('\n'); break;
+            case 'r': out.push_back('\r'); break;
+            case 't': out.push_back('\t'); break;
+            case 'u': {
+                unsigned cp = 0;
+                for (int k = 0; k < 4; ++k) {
+                    int h = pull();
+                    if (h == kEnd) return fail("read_string() hit end of file");
+                    cp = cp * 16 + unsigned(hexNibble(h));
+                }
+                appendCodepoint(out, cp);
+                break;
+            }
+            default: return fail("invalid escape character");
+            }
+        }
+    }
+
+    bool readWord(const char *rest, const char *msg) {
+        for (const char *p = rest; *p; ++p) {
+            if (pull() != (unsigned char)*p) return fail(msg);
+        }
+        return true;
+    }
+
+    // Number grammar: -?digits*(.digits+)?([eE]-?digits*)?
+    // The integer part wraps in 32 bits; at most 9 fraction digits are used.
+    // End of input inside the integer or fraction digits is a silent failure.
+    bool readNumber(int c, Value &out) {
+        bool negative = false;
+        if (c == '-') {
+            negative = true;
+            c = pull();
+        }
+        uint32_t whole = 0;
+        while (isDigit(c)) {
+            whole = whole * 10u + uint32_t(c - '0');
+            c = pull();
+        }
+        if (c == kEnd) return false;
+
+        bool hasFraction = false;
+        float mantissa = 0.0f;
+        if (c == '.') {
+            c = pull();
+            if (c == kEnd) return false;
+            if (!isDigit(c)) return fail("bad number format");
+            uint32_t fracDigits = 0;
+            int used = 0;
+            while (isDigit(c)) {
+                if (used < 9) {
+                    fracDigits = fracDigits * 10u + uint32_t(c - '0');
+                    ++used;
+                }
+                c = pull();
+            }
+            if (c == kEnd) return false;
+            float scale = 1.0f;
+            for (int k = 0; k < used; ++k) scale *= 10.0f;
+            mantissa = float(int32_t(whole)) + float(fracDigits) / scale;
+            if (negative) mantissa = -mantissa;
+            hasFraction = true;
+        }
+
+        if (c == 'e' || c == 'E') {
+            c = pull();
+            bool expNegative = false;
+            if (c == '-') {
+                expNegative = true;
+                c = pull();
+            }
+            // The exponent wraps in 32 bits like the integer part: "3e2147483648"
+            // has the exponent -2147483648 and is 0.0 (measured in the Simulator).
+            uint32_t expDigits = 0;
+            while (isDigit(c)) {
+                expDigits = expDigits * 10u + uint32_t(c - '0');
+                c = pull();
+            }
+            double whole64 = negative ? -double(int32_t(whole)) : double(int32_t(whole));
+            if (c == kEnd) {
+                // Input ended inside the exponent: the exponent is dropped.
+                out.type = kJSONFloat;
+                out.floatval = hasFraction ? mantissa : float(whole64);
+                return true;
+            }
+            unpull(c);
+            int32_t e = int32_t(expNegative ? 0u - expDigits : expDigits);
+            out.type = kJSONFloat;
+            if (hasFraction) {
+                // With a fraction, the single precision mantissa is multiplied in
+                // single precision by the nearest float to 10^e (0 below 1e-45,
+                // infinity above 1e38); measured in the Simulator.
+                out.floatval = canonicalNan(mantissa * floatPowerOfTen(e));
+                return true;
+            }
