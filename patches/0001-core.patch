+bool cranked::audioSimulatorFloat(Cranked &cranked) { return cranked.audio.simulatorFloat; }
+
+bool SoundEffect_32::modValue(const SynthSignalValueRef &mod, int length, float &value) const {
+    if (!mod) return false;
+    if (auto lfo = dynamic_cast<PDSynthLFO_32 *>(mod.get())) { lfo->step(renderTime, length); value = lfo->v0; return true; }
+    if (auto env = dynamic_cast<PDSynthEnvelope_32 *>(mod.get())) { env->modStep(renderTime, length); value = env->modValue; return true; }
+    if (auto cs = dynamic_cast<ControlSignal_32 *>(mod.get())) { cs->modStep(renderTime, length); value = cs->modValue; return true; }
+    if (auto ch = dynamic_cast<SoundChannelSignal_32 *>(mod.get())) { value = ch->level; return true; }
+    return false;
+}
+
+void ControlSignal_32::setStep(float tempo, uint32 step, int32 offset) {
+    csTempo = tempo;
+    csTargetSample = 0;
+    if (events.empty()) return;
+    vector<pair<int32, Event>> list(events.begin(), events.end());
+    csCounter = (uint32) ((float) step * 44100.0f / tempo + (float) offset); // the offset is added in float, as on the device
+    if ((int64) step < (int64) list[0].first) { csIndex = -1; csValue = 0; return; }
+    int i = 0;
+    if (csCounter != 0) { i = 0; while (i + 1 < (int) list.size() and list[i + 1].first <= (int32) step) i++; }
+    csIndex = i;
+    csValue = list[i].second.value;
+    if (i < (int) list.size() - 1 and list[i].second.interpolate) {
+        csTarget = list[i + 1].second.value;
+        auto from = (uint32) ((float) list[i].first * 44100.0f / tempo), to = (uint32) ((float) list[i + 1].first * 44100.0f / tempo);
+        csTargetSample = to;
+        csValue = ((float) (csCounter - from) * (csTarget - csValue)) / (float) (to - from) + csValue;
+    }
+}
+
+float ControlSignal_32::step(int n) {
+    vector<pair<int32, Event>> list(events.begin(), events.end());
+    int last = (int) list.size() - 1;
+    if (csIndex >= last) return csValue;
+    int next = csIndex + 1;
+    csCounter += (uint32) n;
+    auto at = (int32) (((float) csCounter / 44100.0f) * csTempo);
+    if (at < list[next].first) {
+        if (csTargetSample != 0) // interpolating toward the next event
+            csValue = ((csTarget - csValue) * (float) n) / (float) (csTargetSample - csCounter) + csValue;
+        return csValue;
+    }
+    while (next < last and list[next + 1].first <= at) next++;
+    csIndex = next;
+    csValue = list[next].second.value;
+    if (next == last) return csValue;
+    if (list[next].second.interpolate) {
+        csTarget = list[next + 1].second.value;
+        csTargetSample = (uint32) ((float) list[next + 1].first * 44100.0f / csTempo);
+    } else csTargetSample = 0;
+    return csValue;
+}
+
+void SoundSequence_32::setStep(uint32 step, int32 offset) {
+    passTime = (tempo > 0 ? (uint32) ((44100.0f * (float) step) / tempo) : 0) + (uint32) offset;
+    for (auto &track : tracks) // the tracks' control signals follow
+        if (track) for (auto &signal : track->controlSignals) if (signal) signal->setStep(tempo, step, offset);
+}
+
+void SoundSequence_32::finished() {
+    playing = false;
+    cranked.audio.finishedSequences.push_back(this); // the Lua callback
+    if (auto callback = finishCallback)
+        cranked.nativeEngine.invokeEmulatedFunction<void, ArgType::void_t, ArgType::ptr_t, ArgType::uint32_t>(callback, this, finishCallbackUserdata);
+}
+
+void SoundSequence_32::goToStep(uint32 step, int32 offset, bool playNotes) {
+    setStep(step, offset);
+    if (!playNotes) return;
+    // the notes that start at exactly that step are played at once (each track not muted, with an instrument)
+    for (auto &track : tracks) {
+        if (!track or track->muted or !track->instrument) continue;
+        for (auto &note : track->notes)
+            if (note.step == step)
+                playdate_sound_instrument_playMIDINote(&cranked, track->instrument.get(), note.note, note.velocity, (float) note.length / tempo, 0);
+    }
+}
