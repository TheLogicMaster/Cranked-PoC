+void SoundSequence_32::sampleAudio(int16 *left, int16 *right, int length) {
+    // Measured: a loop covers loopStart to loopEnd inclusive, and loops is the total number of passes through it
+    // (0: forever); playback starts at step 0 and jumps back to loopStart after loopEnd.
+    // As the device does it: a note at step s starts trunc(s * 44100 / tempo) samples (in single
+    // precision) into the pass; its length is length / tempo seconds.
+    if (tempo <= 0) return;
+    auto stepSample = [&](double step) { return (int64) ((float) step * (float) AUDIO_SAMPLING_RATE / tempo); };
+    auto trigger = [&](int64 from, int64 to, int64 base) { // notes starting in [from, to), at offset start - base (at least 0)
+        for (auto &track : tracks) {
+            if (!track or track->muted or !track->instrument) continue;
+            for (auto &note : track->notes) {
+                int64 start = stepSample(note.step);
+                if (start < from or start >= to) continue;
+                int offset = (int) min<int64>(length - 1, max<int64>(0, start - base));
+                long long startSample = time + offset;
+                float frequency; // the device's voice choice (it counts time from the block being mixed)
+                if (auto voice = track->instrument->allocateVoice((float) note.note, cranked.audio.sampleTime, frequency)) {
+                    voice->scheduledEnd = startSample + (long long) (note.length / tempo * AUDIO_SAMPLING_RATE);
+                    voice->scheduleNote(cranked.audio.sampleTime + (uint32) offset, frequency, note.velocity, (float) note.length / tempo);
+                    voice->releaseTime = -1;
+                }
+            }
+        }
+    };
+    bool looping = loopEnd > loopStart and (loops == 0 or currentLoop < loops - 1);
+    int64 from = passTime, to = from + length;
+    if (looping and (int64) ((float) to * tempo / (float) AUDIO_SAMPLING_RATE) >= loopEnd + 1) {
+        // on the device: play up to one sample before the end step, then restart the pass at the loop start plus the
+        // rest of the block, as if that were this block's start; so the notes the jump reaches sound up to one block
+        // early, the loop-start notes at this block's start (measured: the looped passes start one block early)
+        int64 used = max<int64>(0, min<int64>(length, stepSample(loopEnd + 1) - from - 1));
+        trigger(from, from + used, from);
+        currentLoop++;
+        int64 restart = stepSample(loopStart), newPass = restart + (length - used);
+        trigger(restart, newPass + (length - used), newPass);
+        setStep((uint32) loopStart, (int32) (newPass - restart)); // the control signals jump with the loop
+        passTime = (uint32) newPass;
+    } else {
+        trigger(from, to, from);
+        passTime = (uint32) to;
+    }
+    // a track's pitch bend signal is stepped each block, to the step at the
+    // block's end; when its value changes the track's instrument gets it as its pitch bend
+    for (auto &track : tracks) {
