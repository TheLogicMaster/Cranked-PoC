+                }
+            }
+
+            void remove(IntVec2 pos) {
+                uint32_t k = key(pos);
+                auto &chain = buckets[bucketOf(hash(k))];
+                auto it = find_if(chain.begin(), chain.end(), [&](const Entry &e) { return e.pos == pos; });
+                if (it == chain.end()) return;
+                chain.erase(it);
+                count--;
+                if (state != Shrink) {
+                    if (count >= bucketMax / 8 or bucketBit <= 6) return;
+                    if (state == Stable) { lowMax = bucketMax / 2; lowMask = bucketMask / 2; split = lowMax; }
+                    state = Shrink;
+                }
+                while (lowMax + split > count * 8) { // merge an upper bucket onto the end of its lower twin
+                    split--;
+                    auto &upper = buckets[split + lowMax];
+                    auto &lower = buckets[split];
+                    lower.insert(lower.end(), upper.begin(), upper.end());
+                    upper.clear();
+                    if (split == 0) {
+                        bucketBit--; bucketMax = 1u << bucketBit; bucketMask = bucketMax - 1;
+                        buckets.resize(bucketMax);
+                        state = Stable; lowMax = bucketMax; lowMask = bucketMask; split = 0;
+                        return;
+                    }
+                }
+            }
+        };
