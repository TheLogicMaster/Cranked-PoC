+static void updateControlSignalEvents(Cranked *cranked, ControlSignal signal) { // the Lua object's events field
+    auto object = pushResource(cranked, signal);
+    auto events = pushTable(cranked);
+    int n = 1;
+    for (auto &[step, event] : signal->events) {
+        auto entry = pushTable(cranked);
+        entry.setIntField("step", step + 1); // 1-based in Lua
+        entry.setFloatField("value", event.value);
+        entry.setBoolField("interpolate", event.interpolate);
+        events.setElement(n++, entry);
+        lua_pop(cranked->getLuaContext(), 1);
+    }
+    // the object is userdata: its Lua-side properties live in its user value table
+    auto L = cranked->getLuaContext();
+    if (lua_type(L, -2) == LUA_TUSERDATA) {
+        if (lua_getiuservalue(L, -2, 1) != LUA_TTABLE) {
+            lua_pop(L, 1); lua_newtable(L); lua_pushvalue(L, -1); lua_setiuservalue(L, -4, 1);
+        }
+        lua_insert(L, -2);
+        lua_setfield(L, -2, "events");
+        lua_pop(L, 2);
+        return;
+    }
+    lua_setfield(L, -2, "events");
+    lua_pop(L, 1);
+}
+
+// properties kept on the Lua side of a userdata object (such as a control signal's events)
+static LuaRet playdate_sound_controlsignal_index_lua(Cranked *cranked, ControlSignal signal, LuaVal key) {
+    if (cranked->luaEngine.indexMetatable())
+        return 1;
+    auto L = cranked->getLuaContext();
+    if (lua_type(L, 1) == LUA_TUSERDATA and lua_getiuservalue(L, 1, 1) == LUA_TTABLE) {
+        lua_pushvalue(L, key.index);
+        lua_gettable(L, -2);
+        return 1;
+    }
+    lua_pushnil(L);
+    return 1;
+}
