+    int first = dbl ? (int) (d << 4 | vd) : (int) (vd << 1 | d);
+    if (p and !w) { // VLDR, VSTR
+        u32 base = rn == 15 ? ((pc + 4) & ~3u) : st.r[rn];
+        u32 address = u ? base + imm8 * 4 : base - imm8 * 4;
+        if (dbl) { if (l) setD(st, first, load64(address)); else store64(address, getD(st, first)); }
+        else { if (l) st.s[first] = load32(address); else store32(address, st.s[first]); }
+        return;
+    }
+    // VLDM, VSTM (increment after, or decrement before with writeback); VPUSH and VPOP
+    if (p == u) undefined();
