+static LuaRet pushJsonResult(Cranked *cranked, const jsondecoder::LuaDecodeResult &result) {
+    auto L = cranked->getLuaContext();
+    switch (result.status) {
+        case jsondecoder::LuaDecodeResult::Ok:
+            pushJsonValue(L, result.value);
+            return 1;
+        case jsondecoder::LuaDecodeResult::Failed:
+            lua_pushnil(L);
+            pushJsonValue(L, result.message);
+            return 2;
+        case jsondecoder::LuaDecodeResult::LuaError:
+            lua_pushstring(L, result.luaError.c_str());
+            lua_error(L);
+            return 0;
+        default:
+            lua_pushnil(L);
+            lua_pushstring(L, result.luaError.c_str());
+            return 2;
+    }
+}
