+            if (freqLfo) freqLfo->step(T, n);
+            if (ampLfo) ampLfo->step(T, n);
+            if (freqEnv) freqEnv->modStep(T, n); // envelopes as modulators
+            if (ampEnv) ampEnv->modStep(T, n);
+            if (freqCs) freqCs->modStep(T, n); // control signals as modulators
+            if (ampCs) ampCs->modStep(T, n);
+            // each parameter modulator is stepped and its value given to the generator's setParameter
+            for (int p = 1; p <= 4; p++)
+                if (auto lfo = dynamic_cast<PDSynthLFO_32 *>(parameterModulators[p].get())) {
+                    lfo->step(T, n);
+                    playdate_sound_synth_setParameter(&cranked, this, p, lfo->v0);
+                } else if (auto mod = dynamic_cast<PDSynthEnvelope_32 *>(parameterModulators[p].get())) {
+                    mod->modStep(T, n);
+                    playdate_sound_synth_setParameter(&cranked, this, p, mod->modValue);
+                } else if (auto cs = dynamic_cast<ControlSignal_32 *>(parameterModulators[p].get())) {
+                    cs->modStep(T, n);
+                    playdate_sound_synth_setParameter(&cranked, this, p, cs->modValue);
+                } else if (auto ch = dynamic_cast<SoundChannelSignal_32 *>(parameterModulators[p].get())) {
+                    playdate_sound_synth_setParameter(&cranked, this, p, ch->level);
+                }
+            if (envClock != -1) {
+                envPrevClock = envClock;
+                envClock = (float) n / SYNTH_RATE + envClock;
+                envStepValue = envValue(envClock);
+                if (envDone) envClock = -1;
+            }
+            // the envelope's value (for getValue) is offset + scale x its step value
+            if (env) env->modValue = env->offset + env->scale * (envClock != -1 or envDone ? envStepValue : 0.0f);
+        }
