+    setEmu<EmuShouldDecodeKey>(cb.shouldDecodeTableValueForKey, &ctx, w->shouldDecodeTableValueForKey);
+    setEmu<EmuDidDecodeTableValue>(cb.didDecodeTableValue, &ctx, w->didDecodeTableValue);
+    setEmu<EmuShouldDecodeIndex>(cb.shouldDecodeArrayValueAtIndex, &ctx, w->shouldDecodeArrayValueAtIndex);
