+void Interpreter::coprocessor(u16 hw1, u16 hw2) {
+    u32 coproc = (hw2 >> 8) & 15;
+    if ((coproc & 0xE) != 0xA) undefined(); // only the floating point (CP10, CP11)
+    if ((hw1 & 0xEF00) == 0xEF00) undefined(); // Advanced SIMD data processing (not in FPv5)
+    if (hw1 & 0x1000) return vfpUnconditional(hw1, hw2); // 1111 11xx: FPv5's unconditional instructions
+    if ((hw1 & 0xFE0) == 0xC40) return vfpTransfer(hw1, hw2); // 1110 1100 010x: 64-bit transfers
+    if ((hw1 & 0xF00) == 0xE00) {
+        if (hw2 & 0x10) return vfpTransfer(hw1, hw2);
+        return vfpDataProcessing(hw1, hw2);
+    }
+    if ((hw1 & 0xE00) == 0xC00) return vfpLoadStore(hw1, hw2);
+    undefined();
+}
