diff --git a/core/UnicornStub.cpp b/core/UnicornStub.cpp
new file mode 100644
index 0000000..05728f0
--- /dev/null
+++ b/core/UnicornStub.cpp
@@ -0,0 +1,377 @@
+// Builds without Unicorn (USE_UNICORN=OFF): the parts of Unicorn's API that Cranked calls.
+//
+// With USE_INTERPRETER (CRANKED_INTERPRETER), they run on the bundled ARM interpreter (ArmInterpreter.hpp), so C games
+// run on hosts where Unicorn's JIT cannot (WebAssembly, iOS). An emulation slice ends after SLICE instructions, as the
+// watchdog ends a Unicorn slice after 15 ms (the caller's loop then continues it), so runaway code is still caught,
+// without threads, and at the same points on every run.
+//
+// Without it, memory reads and writes go to the mapped regions and registers are kept in a table, so the memory
+// layout and everything Lua games use work as with Unicorn; starting emulation fails with an error naming the build option,
+// so a C game stops with that message.
+#include "unicorn/unicorn.h"
+
+#include <array>
+#include <cstdarg>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <vector>
+
+#ifdef CRANKED_INTERPRETER
+
+#include "ArmInterpreter.hpp"
+
+namespace {
+constexpr uint64_t SLICE = 2'000'000; // instructions; about 10 ms interpreted on a desktop
+
+struct Hook { int type; void *callback; void *userdata; };
+}
+
+struct uc_struct {
+    armi::Interpreter cpu;
+    std::vector<Hook> hooks;
+    void rebind();
+};
+
+struct uc_context {
+    armi::State state;
+};
+
+void uc_struct::rebind() {
+    void *intr = nullptr, *intrUser = nullptr, *read = nullptr, *readUser = nullptr, *write = nullptr, *writeUser = nullptr;
+    void *fetch = nullptr, *fetchUser = nullptr, *code = nullptr, *codeUser = nullptr;
+    for (auto &h : hooks) {
+        if (h.type & UC_HOOK_INTR) { intr = h.callback; intrUser = h.userdata; }
+        if (h.type & UC_HOOK_MEM_READ_UNMAPPED) { read = h.callback; readUser = h.userdata; }
+        if (h.type & UC_HOOK_MEM_WRITE_UNMAPPED) { write = h.callback; writeUser = h.userdata; }
+        if (h.type & UC_HOOK_MEM_FETCH_UNMAPPED) { fetch = h.callback; fetchUser = h.userdata; }
+        if (h.type & UC_HOOK_CODE) { code = h.callback; codeUser = h.userdata; }
+    }
+    auto self = this;
+    if (intr) cpu.onInterrupt = [self, intr, intrUser](uint32_t intno) { ((uc_cb_hookintr_t) intr)(self, intno, intrUser); };
+    else cpu.onInterrupt = nullptr;
+    cpu.onUnmapped = [self, read, readUser, write, writeUser, fetch, fetchUser](int type, uint32_t address, int size, int64_t value) {
+        void *cb = type == UC_MEM_READ_UNMAPPED ? read : type == UC_MEM_WRITE_UNMAPPED ? write : fetch;
+        void *user = type == UC_MEM_READ_UNMAPPED ? readUser : type == UC_MEM_WRITE_UNMAPPED ? writeUser : fetchUser;
+        if (cb) ((uc_cb_eventmem_t) cb)(self, (uc_mem_type) type, address, size, value, user);
+    };
+    if (code) cpu.onCode = [self, code, codeUser](uint32_t address, uint32_t size) { ((uc_cb_hookcode_t) code)(self, address, size, codeUser); };
+    else cpu.onCode = nullptr;
+}
+
+namespace {
+size_t registerSize(int regid) {
+    if (regid >= UC_ARM_REG_D0 and regid <= UC_ARM_REG_D31) return 8;
+    if (regid >= UC_ARM_REG_Q0 and regid <= UC_ARM_REG_Q15) return 16;
+    return 4;
+}
+
+uc_err fromResult(armi::Result r) {
+    switch (r) {
+        case armi::Result::Ok: return UC_ERR_OK;
+        case armi::Result::FetchUnmapped: return UC_ERR_FETCH_UNMAPPED;
+        case armi::Result::ReadUnmapped: return UC_ERR_READ_UNMAPPED;
+        case armi::Result::WriteUnmapped: return UC_ERR_WRITE_UNMAPPED;
+        case armi::Result::FetchProt: return UC_ERR_FETCH_PROT;
+        case armi::Result::ReadProt: return UC_ERR_READ_PROT;
+        case armi::Result::WriteProt: return UC_ERR_WRITE_PROT;
+        default: return UC_ERR_EXCEPTION;
+    }
+}
+}
+
+uc_err uc_open(uc_arch, uc_mode, uc_engine **uc) {
+    *uc = new uc_struct;
+    return UC_ERR_OK;
+}
+
+uc_err uc_close(uc_engine *uc) {
+    delete uc;
+    return UC_ERR_OK;
+}
+
+uc_err uc_ctl(uc_engine *, uc_control_type, ...) {
+    return UC_ERR_OK; // the CPU model (always a Cortex-M7 here) and cache flushes (the interpreter caches nothing)
+}
+
+const char *uc_strerror(uc_err code) {
+    switch (code) {
+        case UC_ERR_OK: return "OK (UC_ERR_OK)";
+        case UC_ERR_READ_UNMAPPED: return "Invalid memory read (UC_ERR_READ_UNMAPPED)";
+        case UC_ERR_WRITE_UNMAPPED: return "Invalid memory write (UC_ERR_WRITE_UNMAPPED)";
+        case UC_ERR_FETCH_UNMAPPED: return "Invalid memory fetch (UC_ERR_FETCH_UNMAPPED)";
+        case UC_ERR_READ_PROT: return "Invalid memory read (UC_ERR_READ_PROT)";
+        case UC_ERR_WRITE_PROT: return "Invalid memory write (UC_ERR_WRITE_PROT)";
+        case UC_ERR_FETCH_PROT: return "Invalid memory fetch (UC_ERR_FETCH_PROT)";
+        case UC_ERR_MAP: return "Invalid memory mapping (UC_ERR_MAP)";
+        case UC_ERR_EXCEPTION: return "Unhandled CPU exception (UC_ERR_EXCEPTION)";
+        default: return "native engine error";
+    }
+}
+
+uc_err uc_reg_write(uc_engine *uc, int regid, const void *value) {
+    auto &st = uc->cpu.st;
+    uint32_t v = 0;
+    memcpy(&v, value, 4);
+    if (regid >= UC_ARM_REG_R0 and regid <= UC_ARM_REG_R12) st.r[regid - UC_ARM_REG_R0] = v;
+    else if (regid == UC_ARM_REG_SP) st.r[13] = v;
+    else if (regid == UC_ARM_REG_LR) st.r[14] = v;
+    else if (regid == UC_ARM_REG_PC) st.r[15] = v & ~1u;
+    else if (regid >= UC_ARM_REG_S0 and regid <= UC_ARM_REG_S31) st.s[regid - UC_ARM_REG_S0] = v;
+    else if (regid >= UC_ARM_REG_D0 and regid <= UC_ARM_REG_D31) memcpy(&st.s[2 * (regid - UC_ARM_REG_D0)], value, 8);
+    else if (regid >= UC_ARM_REG_Q0 and regid <= UC_ARM_REG_Q15) memcpy(&st.s[4 * (regid - UC_ARM_REG_Q0)], value, 16);
+    else if (regid == UC_ARM_REG_XPSR or regid == UC_ARM_REG_CPSR) st.setXpsr(v);
+    else if (regid == UC_ARM_REG_APSR or regid == UC_ARM_REG_APSR_NZCVQ or regid == UC_ARM_REG_APSR_NZCVQG) st.setXpsr(v, 0xF80F0000);
+    else if (regid == UC_ARM_REG_APSR_NZCV) st.setXpsr(v, 0xF0000000);
+    else if (regid == UC_ARM_REG_IPSR) st.ipsr = v & 0x1FF;
+    else if (regid == UC_ARM_REG_FPSCR) st.fpscr = v;
+    else if (regid == UC_ARM_REG_FPEXC) st.fpexc = v;
+    else if (regid == UC_ARM_REG_CONTROL) st.control = v;
+    else if (regid == UC_ARM_REG_PRIMASK) st.primask = v;
+    else if (regid == UC_ARM_REG_BASEPRI) st.basepri = v;
+    else if (regid == UC_ARM_REG_FAULTMASK) st.faultmask = v;
+    else if (regid == UC_ARM_REG_MSP) st.msp = v;
+    else if (regid == UC_ARM_REG_PSP) st.psp = v;
+    return UC_ERR_OK; // others (CPACR and the like) have no effect here
+}
+
+uc_err uc_reg_read(uc_engine *uc, int regid, void *value) {
+    auto &st = uc->cpu.st;
+    uint32_t v = 0;
+    if (regid >= UC_ARM_REG_D0 and regid <= UC_ARM_REG_D31) { memcpy(value, &st.s[2 * (regid - UC_ARM_REG_D0)], 8); return UC_ERR_OK; }
+    if (regid >= UC_ARM_REG_Q0 and regid <= UC_ARM_REG_Q15) { memcpy(value, &st.s[4 * (regid - UC_ARM_REG_Q0)], 16); return UC_ERR_OK; }
+    if (regid >= UC_ARM_REG_R0 and regid <= UC_ARM_REG_R12) v = st.r[regid - UC_ARM_REG_R0];
+    else if (regid == UC_ARM_REG_SP) v = st.r[13];
+    else if (regid == UC_ARM_REG_LR) v = st.r[14];
+    else if (regid == UC_ARM_REG_PC) v = st.r[15];
+    else if (regid >= UC_ARM_REG_S0 and regid <= UC_ARM_REG_S31) v = st.s[regid - UC_ARM_REG_S0];
+    else if (regid == UC_ARM_REG_XPSR or regid == UC_ARM_REG_CPSR) v = st.xpsr();
+    else if (regid == UC_ARM_REG_APSR or regid == UC_ARM_REG_APSR_NZCVQ or regid == UC_ARM_REG_APSR_NZCVQG) v = st.xpsr() & 0xF80F0000;
+    else if (regid == UC_ARM_REG_APSR_NZCV) v = st.xpsr() & 0xF0000000;
+    else if (regid == UC_ARM_REG_IPSR) v = st.ipsr;
+    else if (regid == UC_ARM_REG_FPSCR) v = st.fpscr;
+    else if (regid == UC_ARM_REG_FPEXC) v = st.fpexc;
+    else if (regid == UC_ARM_REG_CONTROL) v = st.control;
+    else if (regid == UC_ARM_REG_PRIMASK) v = st.primask;
+    else if (regid == UC_ARM_REG_BASEPRI) v = st.basepri;
+    else if (regid == UC_ARM_REG_FAULTMASK) v = st.faultmask;
+    else if (regid == UC_ARM_REG_MSP) v = st.msp;
+    else if (regid == UC_ARM_REG_PSP) v = st.psp;
+    memset(value, 0, registerSize(regid));
+    memcpy(value, &v, 4);
+    return UC_ERR_OK;
+}
+
+uc_err uc_mem_write(uc_engine *uc, uint64_t address, const void *bytes, uint64_t size) {
+    return address + size <= 0x100000000ull and uc->cpu.write((uint32_t) address, bytes, size) ? UC_ERR_OK : UC_ERR_WRITE_UNMAPPED;
+}
+
+uc_err uc_mem_read(uc_engine *uc, uint64_t address, void *bytes, uint64_t size) {
+    return address + size <= 0x100000000ull and uc->cpu.read((uint32_t) address, bytes, size) ? UC_ERR_OK : UC_ERR_READ_UNMAPPED;
+}
+
+uc_err uc_mem_map_ptr(uc_engine *uc, uint64_t address, uint64_t size, uint32_t perms, void *ptr) {
+    if (!ptr or size == 0 or address + size > 0x100000000ull) return UC_ERR_ARG;
+    return uc->cpu.map((uint32_t) address, (uint32_t) size, perms, (uint8_t *) ptr) ? UC_ERR_OK : UC_ERR_MAP;
+}
+
+uc_err uc_mem_unmap(uc_engine *uc, uint64_t address, uint64_t size) {
+    return uc->cpu.unmap((uint32_t) address, (uint32_t) size) ? UC_ERR_OK : UC_ERR_ARG;
+}
+
+uc_err uc_emu_start(uc_engine *uc, uint64_t begin, uint64_t until, uint64_t, size_t count) {
+    auto result = uc->cpu.run((uint32_t) begin, (uint32_t) until, count, count ? 0 : SLICE);
+    return fromResult(result);
+}
+
+uc_err uc_emu_stop(uc_engine *uc) {
+    uc->cpu.stop();
+    return UC_ERR_OK;
+}
+
+uc_err uc_hook_add(uc_engine *uc, uc_hook *hh, int type, void *callback, void *userdata, uint64_t, uint64_t, ...) {
+    uc->hooks.push_back({ type, callback, userdata });
+    *hh = uc->hooks.size();
+    uc->rebind();
+    return UC_ERR_OK;
+}
+
+uc_err uc_hook_del(uc_engine *uc, uc_hook hh) {
+    if (hh >= 1 and hh <= uc->hooks.size()) uc->hooks[hh - 1] = { 0, nullptr, nullptr };
+    uc->rebind();
+    return UC_ERR_OK;
+}
+
+uc_err uc_context_alloc(uc_engine *, uc_context **context) {
+    *context = new uc_context;
+    return UC_ERR_OK;
+}
+
+uc_err uc_context_save(uc_engine *uc, uc_context *context) {
+    context->state = uc->cpu.st;
+    return UC_ERR_OK;
+}
+
+uc_err uc_context_restore(uc_engine *uc, uc_context *context) {
+    uc->cpu.st = context->state;
+    return UC_ERR_OK;
+}
+
+uc_err uc_context_free(uc_context *context) {
+    delete context;
+    return UC_ERR_OK;
+}
+
+uc_err uc_free(void *mem) {
+    free(mem);
+    return UC_ERR_OK;
+}
+
+#else // no native code
+
+struct uc_struct {
+    struct Region { uint64_t address, size; uint8_t *data; };
+    std::vector<Region> regions;
+    std::map<int, std::array<uint8_t, 16>> registers;
+
+    Region *find(uint64_t address, uint64_t size) {
+        for (auto &region : regions)
+            if (address >= region.address and size <= region.size and address - region.address <= region.size - size)
+                return &region;
+        return nullptr;
+    }
+};
+
+struct uc_context {
+    std::map<int, std::array<uint8_t, 16>> registers;
+};
+
+namespace {
+// bytes a register holds: the doubles D0 to D31 take 8, the quads Q0 to Q15 16, the rest 4
+size_t registerSize(int regid) {
+    if (regid >= UC_ARM_REG_D0 and regid <= UC_ARM_REG_D31) return 8;
+    if (regid >= UC_ARM_REG_Q0 and regid <= UC_ARM_REG_Q15) return 16;
+    return 4;
+}
+
+constexpr uc_err NO_NATIVE_CODE = UC_ERR_ARCH;
+}
+
+uc_err uc_open(uc_arch, uc_mode, uc_engine **uc) {
+    *uc = new uc_struct;
+    return UC_ERR_OK;
+}
+
+uc_err uc_close(uc_engine *uc) {
+    delete uc;
+    return UC_ERR_OK;
+}
+
+uc_err uc_ctl(uc_engine *, uc_control_type, ...) {
+    return UC_ERR_OK;
+}
+
+const char *uc_strerror(uc_err code) {
+    if (code == NO_NATIVE_CODE)
+        return "this build runs no native code (configured with USE_UNICORN=OFF)";
+    if (code == UC_ERR_READ_UNMAPPED) return "Invalid memory read (UC_ERR_READ_UNMAPPED)";
+    if (code == UC_ERR_WRITE_UNMAPPED) return "Invalid memory write (UC_ERR_WRITE_UNMAPPED)";
+    if (code == UC_ERR_MAP) return "Invalid memory mapping (UC_ERR_MAP)";
+    return code == UC_ERR_OK ? "OK (UC_ERR_OK)" : "native engine error";
+}
+
+uc_err uc_reg_write(uc_engine *uc, int regid, const void *value) {
+    auto &stored = uc->registers[regid];
+    stored.fill(0);
+    memcpy(stored.data(), value, registerSize(regid));
+    return UC_ERR_OK;
+}
+
+uc_err uc_reg_read(uc_engine *uc, int regid, void *value) {
+    auto found = uc->registers.find(regid);
+    if (found == uc->registers.end())
+        memset(value, 0, registerSize(regid));
+    else
+        memcpy(value, found->second.data(), registerSize(regid));
+    return UC_ERR_OK;
+}
+
+uc_err uc_mem_write(uc_engine *uc, uint64_t address, const void *bytes, uint64_t size) {
+    auto region = uc->find(address, size);
+    if (!region)
+        return UC_ERR_WRITE_UNMAPPED;
+    memcpy(region->data + (address - region->address), bytes, size);
+    return UC_ERR_OK;
+}
+
+uc_err uc_mem_read(uc_engine *uc, uint64_t address, void *bytes, uint64_t size) {
+    auto region = uc->find(address, size);
+    if (!region)
+        return UC_ERR_READ_UNMAPPED;
+    memcpy(bytes, region->data + (address - region->address), size);
+    return UC_ERR_OK;
+}
+
+uc_err uc_mem_map_ptr(uc_engine *uc, uint64_t address, uint64_t size, uint32_t, void *ptr) {
+    if (!ptr or size == 0)
+        return UC_ERR_ARG;
+    for (auto &region : uc->regions)
+        if (address < region.address + region.size and region.address < address + size)
+            return UC_ERR_MAP;
+    uc->regions.push_back({ address, size, (uint8_t *) ptr });
+    return UC_ERR_OK;
+}
+
+uc_err uc_mem_unmap(uc_engine *uc, uint64_t address, uint64_t size) {
+    for (auto it = uc->regions.begin(); it != uc->regions.end(); ++it)
+        if (it->address == address and it->size == size) {
+            uc->regions.erase(it);
+            return UC_ERR_OK;
+        }
+    return UC_ERR_ARG;
+}
+
+uc_err uc_emu_start(uc_engine *, uint64_t, uint64_t, uint64_t, size_t) {
+    return NO_NATIVE_CODE;
+}
+
+uc_err uc_emu_stop(uc_engine *) {
+    return UC_ERR_OK;
+}
+
+uc_err uc_hook_add(uc_engine *, uc_hook *hh, int, void *, void *, uint64_t, uint64_t, ...) {
+    static uc_hook next = 1;
+    *hh = next++;
+    return UC_ERR_OK;
+}
+
+uc_err uc_hook_del(uc_engine *, uc_hook) {
+    return UC_ERR_OK;
+}
+
+uc_err uc_context_alloc(uc_engine *, uc_context **context) {
+    *context = new uc_context;
+    return UC_ERR_OK;
+}
+
+uc_err uc_context_save(uc_engine *uc, uc_context *context) {
+    context->registers = uc->registers;
+    return UC_ERR_OK;
+}
+
+uc_err uc_context_restore(uc_engine *uc, uc_context *context) {
+    uc->registers = context->registers;
+    return UC_ERR_OK;
+}
+
+uc_err uc_context_free(uc_context *context) {
+    delete context;
+    return UC_ERR_OK;
+}
+
+uc_err uc_free(void *mem) {
+    free(mem);
+    return UC_ERR_OK;
+}
+
+#endif
