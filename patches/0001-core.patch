+// Every source joins the default channel when it is made, and the channel holds a reference to it. When the game
+// lets go of the source (a Lua object collected, a C free), that reference is the only one left: nothing can reach
+// the source, so it leaves the channel and is freed (otherwise every source ever made stays in memory, and a game that
+// makes a sample player per event fills the 16 MB heap). A source let go of while it plays plays to the end first
+// (measured: the Simulator keeps a Lua sample player that plays until it finishes, then collects it).
+void SoundSource_32::onSingleReference() {
+    cranked.audio.releaseIfOnlyInMainChannel(this);
+}
+
+void Audio::releaseIfOnlyInMainChannel(SoundSource_32 *source) {
+    if (resetting or !mainChannel) return;
+    auto &sources = mainChannel->sources;
+    auto it = sources.find(source);
+    if (it == sources.end()) return;
+    if (rendering) { pendingReleases.emplace_back(source); return; } // a callback during the render: after the block
+    if (source->playing) { // freed when it stops (see renderBlock)
+        if (find(releaseWhenStopped.begin(), releaseWhenStopped.end(), source) == releaseWhenStopped.end())
+            releaseWhenStopped.push_back(source);
+        return;
+    }
+    sources.erase(it);
 }
 
