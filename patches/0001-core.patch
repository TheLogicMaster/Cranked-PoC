+struct EmuCallback { EmuJson *ctx; cref_t address; };
+struct EmuDecodeError : EmuCallback { void operator()(jsondecoder::Decoder &, const char *, int) const; };
+struct EmuWillDecodeSublist : EmuCallback { void operator()(jsondecoder::Decoder &, const char *, int) const; };
+struct EmuShouldDecodeKey : EmuCallback { int operator()(jsondecoder::Decoder &, const char *) const; };
+struct EmuDidDecodeTableValue : EmuCallback { void operator()(jsondecoder::Decoder &, const char *, const jsondecoder::Value &) const; };
+struct EmuShouldDecodeIndex : EmuCallback { int operator()(jsondecoder::Decoder &, int) const; };
+struct EmuDidDecodeArrayValue : EmuCallback { void operator()(jsondecoder::Decoder &, int, const jsondecoder::Value &) const; };
+struct EmuDidDecodeSublist : EmuCallback { void *operator()(jsondecoder::Decoder &, const char *, int) const; };
+
+template<typename F, typename Fn> cref_t emuAddress(const Fn &fn) { auto t = fn.template target<F>(); return t ? t->address : 0; }
+template<typename F, typename Fn> void setEmu(Fn &fn, EmuJson *ctx, cref_t address) {
+    if (address == emuAddress<F>(fn) and (address != 0) == (bool) fn) return;
+    if (address) fn = F{ { ctx, address } }; else fn = nullptr;
+}
+void writeDecoder(EmuJson &ctx, jsondecoder::Decoder &d) { // the decoder's header -> the emulated working copy
+    auto &cb = d.hdr.cb; auto w = ctx.work;
+    w->decodeError = emuAddress<EmuDecodeError>(cb.decodeError);
+    w->willDecodeSublist = emuAddress<EmuWillDecodeSublist>(cb.willDecodeSublist);
+    w->shouldDecodeTableValueForKey = emuAddress<EmuShouldDecodeKey>(cb.shouldDecodeTableValueForKey);
+    w->didDecodeTableValue = emuAddress<EmuDidDecodeTableValue>(cb.didDecodeTableValue);
+    w->shouldDecodeArrayValueAtIndex = emuAddress<EmuShouldDecodeIndex>(cb.shouldDecodeArrayValueAtIndex);
+    w->didDecodeArrayValue = emuAddress<EmuDidDecodeArrayValue>(cb.didDecodeArrayValue);
+    w->didDecodeSublist = emuAddress<EmuDidDecodeSublist>(cb.didDecodeSublist);
+    w->userdata = (cref_t) (uintptr_t) cb.userdata;
+    w->returnString = cb.returnString;
