+                        genParam = ((((x >> 3) ^ (x >> 2) ^ x ^ (x >> 5)) & 1) << 15) | (x >> 1);
+                    }
+                    genPhase = p + big;
+                    add(i, (int32) (int16) genParam << 8, l, r);
