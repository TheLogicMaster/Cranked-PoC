+// rounding to an integral value in mode: 0 nearest even, 1 +inf, 2 -inf, 3 zero, 4 nearest away from zero
+double roundIntegral(double x, int mode) {
+    switch (mode) {
+        case 0: { double r = std::nearbyint(x); return r; } // the host's default mode is nearest
+        case 1: return std::ceil(x);
+        case 2: return std::floor(x);
+        case 3: return std::trunc(x);
+        default: return std::round(x);
+    }
+}
