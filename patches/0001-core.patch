+void Interpreter::vfpLoadStore(u16 hw1, u16 hw2) {
+    bool p = (hw1 >> 8) & 1, u = (hw1 >> 7) & 1, d = (hw1 >> 6) & 1, w = (hw1 >> 5) & 1, l = (hw1 >> 4) & 1;
+    bool dbl = (hw2 >> 8) & 1;
