+                // is dropped; the fraction is kept), as if the stored position were clamped to the end
+                samplePos = min(samplePos, sampleSustainEnd) + sampleSustainStart - sampleSustainEnd;
+                int more = renderSampleRamp(sample->pcm, sample->channels, sampleSustainEnd, samplePos, sampleFrac, sstep, stepDelta,
