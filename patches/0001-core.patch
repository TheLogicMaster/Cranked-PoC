+        switch (c) {
+        case '[': return readList(at, kJSONArray, out, lastKey);
+        case '{': return readList(at, kJSONTable, out, lastKey);
+        case '"':
+            out.type = kJSONString;
+            if (!readText(out.stringval)) return false;
+            out.stringval = upToNul(out.stringval);
+            return true;
+        case 't': out.type = kJSONTrue; return readWord("rue", "expected \"true\"");
+        case 'f': out.type = kJSONFalse; return readWord("alse", "expected \"false\"");
+        case 'n': out.type = kJSONNull; return readWord("ull", "expected \"null\"");
+        default:
+            if (c == '-' || isDigit(c)) return readNumber(c, out);
+            return fail("json decode_value() read unexpected character");
+        }
+    }
+
+    bool readList(const Place &at, int type, Value &out, std::string *lastKey) {
+        if (depth == 0) {
+            rootIsList = true;
+            rootPath = (type == kJSONArray) ? "_root" : "";
+        }
+        DecoderHeader entry = dec.hdr;
+        const char *outerErrPath = errPath;
+        // Arrays always show a non-empty path; a table's own path is shown as
+        // is to willDecodeSublist and as "_root" (when empty) afterwards.
+        std::string ownPath = (type == kJSONArray && at.path.empty()) ? std::string("_root") : at.path;
+        std::string shownPath = ownPath.empty() ? std::string("_root") : ownPath;
+        dec.hdr.path = ownPath.c_str();
+        errPath = ownPath.c_str();
+
+        if (dec.hdr.cb.willDecodeSublist) dec.hdr.cb.willDecodeSublist(dec, at.name.c_str(), type);
+        if (callbackRaisedError()) return false;
+
+        if (dec.hdr.cb.returnString) {
+            std::string text;
+            if (!scanRaw(&text)) {
+                status.simulatedAllocFailure = true;
+                return fail("alloc failed");
+            }
+            dec.hdr = entry;
+            errPath = outerErrPath;
+            out.type = kJSONString;
+            out.stringval = upToNul(text);
+            return true;
+        }
+
+        dec.hdr.path = shownPath.c_str();
+        ++depth;
+        bool ok = type == kJSONArray ? readArrayBody(at, shownPath) : readTableBody(ownPath, at.name == "_root", lastKey);
+        --depth;
+        if (!ok) return false;
+
+        void *made = nullptr;
+        if (dec.hdr.cb.didDecodeSublist) made = dec.hdr.cb.didDecodeSublist(dec, at.name.c_str(), type);
+        if (callbackRaisedError()) return false;
+        dec.hdr = entry;
+        errPath = outerErrPath;
+        out.type = type;
+        out.ptr = made;
+        return true;
+    }
+
+    bool readArrayBody(const Place &at, const std::string &path) {
+        int c = nextToken();
+        if (c == ']') return true;
+        unpull(c);
+        for (int pos = 1;; ++pos) {
+            int wanted = 1;
+            if (dec.hdr.cb.shouldDecodeArrayValueAtIndex) wanted = dec.hdr.cb.shouldDecodeArrayValueAtIndex(dec, pos);
+            if (callbackRaisedError()) return false;
+            if (wanted) {
+                std::string idx = "[" + reversedDigits(pos) + "]";
+                Place child{at.name + idx, path + idx};
+                Value v;
+                if (!readValue(child, v)) return false;
+                if (dec.hdr.cb.didDecodeArrayValue) dec.hdr.cb.didDecodeArrayValue(dec, pos, v);
+                if (callbackRaisedError()) return false;
+            } else if (!skipValue()) {
+                return false;
+            }
+            c = nextToken();
+            if (c == ']') return true;
+            if (c != ',') return fail("decode_array() didn't find ']'");
+        }
+    }
+
+    // rootNamed: the table is named "_root" (the root, or an empty-key table
+    // inside such a table).
+    bool readTableBody(const std::string &ownPath, bool rootNamed, std::string *lastKey) {
+        std::string keyPath;
+        int c = nextToken();
+        if (c == '}') return true;
+        for (;;) {
+            if (c != '"') return fail("decode_table expected '\"'");
+            std::string key;
+            if (!readText(key)) return false;
+            bool emptyKey = key.empty();
+            key = upToNul(key);
+            keyPath = ownPath.empty() ? key : ownPath + "." + key;
+            errPath = keyPath.c_str();
+            c = nextToken();
+            if (c != ':') return fail("decode_table expected ':'");
+            int wanted = 1;
+            if (dec.hdr.cb.shouldDecodeTableValueForKey) wanted = dec.hdr.cb.shouldDecodeTableValueForKey(dec, key.c_str());
+            if (callbackRaisedError()) return false;
+            if (wanted) {
+                // In a table named "_root", a sublist under the empty key is also named "_root".
+                bool rootMember = rootNamed && emptyKey;
+                Place child{rootMember ? std::string("_root") : key, keyPath};
+                Value v;
+                std::string childLast = key;
+                if (!readValue(child, v, &childLast)) return false;
+                // In a table named "_root", an array stored under the empty key is
+                // reported under its name ("_root"), and a table with members
+                // under the key reported for its last member.
+                bool isList = v.type == kJSONArray || v.type == kJSONTable;
+                std::string shownKey = key;
+                if (rootMember && isList) shownKey = v.type == kJSONArray ? std::string("_root") : childLast;
+                if (lastKey) *lastKey = shownKey;
+                if (dec.hdr.cb.didDecodeTableValue) dec.hdr.cb.didDecodeTableValue(dec, shownKey.c_str(), v);
+                if (callbackRaisedError()) return false;
+            } else {
+                if (lastKey) *lastKey = key;
+                if (!skipValue()) return false;
+            }
+            c = nextToken();
+            if (c == '}') return true;
+            if (c != ',') return fail("decode_table expected ','");
+            c = nextToken();
+        }
+    }
+
+    int run(Value *out) {
+        int c = nextToken(true);
+        if (atTopEnd(c)) {
+            errPath = "";
+            fail("empty file");
+            return 0;
+        }
+        unpull(c);
+        Value v;
+        Place root{"_root", ""};
+        if (!readValue(root, v)) return 0;
+        if (!rootIsList) {
+            dec.hdr.path = "";
+            if (dec.hdr.cb.didDecodeArrayValue) dec.hdr.cb.didDecodeArrayValue(dec, 0, v);
+        }
+        c = nextToken(true);
+        if (!atTopEnd(c)) {
+            errPath = rootPath.c_str();
+            fail("decode_value() didn't run to end of file");
+            return 0;
+        }
+        if (out) *out = v;
+        return 1;
+    }
+};
+
+int Decoder::line() const { return impl ? impl->line : 1; }
+
+int decode(const Callbacks &callbacks, const ReadFn &reader, Value *out, DecodeStatus *status) {
+    DecoderImpl im;
+    im.reader = &reader;
+    im.dec.hdr.cb = callbacks;
+    im.dec.impl = &im;
+    int r = im.run(out);
+    if (status) *status = im.status;
+    return r;
+}
+
+int decodeString(const Callbacks &callbacks, const char *json, Value *out, DecodeStatus *status) {
+    return decodeString(callbacks, std::string(json ? json : ""), out, status);
+}
+
+int decodeString(const Callbacks &callbacks, const std::string &json, Value *out, DecodeStatus *status) {
+    std::string text = upToNul(json);
+    size_t at = 0;
+    ReadFn reader = [&](uint8_t *buf, int size) -> int {
+        size_t n = std::min(text.size() - at, size_t(size));
+        std::memcpy(buf, text.data() + at, n);
+        at += n;
+        return int(n);
+    };
+    return decode(callbacks, reader, out, status);
+}
+
+// ---------------------------------------------------------------------------
+// Lua tables
+// ---------------------------------------------------------------------------
+
+LuaValue LuaValue::newTable() {
+    LuaValue r;
+    r.kind = Table;
+    r.t = std::make_shared<LuaTable>();
+    return r;
+}
+
+namespace {
+std::string keyCode(const LuaValue &k) {
+    char buf[32];
+    switch (k.kind) {
+    case LuaValue::Int: std::snprintf(buf, sizeof buf, "i%d", k.i); return buf;
+    case LuaValue::Float: {
+        float f = k.f;
+        if (f == std::floor(f) && std::fabs(f) < 2147483648.0f) {  // integral floats equal integers
+            std::snprintf(buf, sizeof buf, "i%d", int32_t(f));
+            return buf;
+        }
+        uint32_t bits;
+        std::memcpy(&bits, &f, 4);
+        std::snprintf(buf, sizeof buf, "f%08x", bits);
+        return buf;
+    }
+    case LuaValue::String: return "s" + k.s;
+    case LuaValue::Bool: return k.b ? "bt" : "bf";
+    case LuaValue::Table: std::snprintf(buf, sizeof buf, "t%p", (void *)k.t.get()); return buf;
+    default: return "n";
+    }
+}
+}  // namespace
+
+long LuaTable::find(const LuaValue &key) const {
+    auto it = index_.find(keyCode(key));
+    return it == index_.end() ? -1 : long(it->second);
+}
+
+void LuaTable::reindex() {
+    index_.clear();
+    for (size_t i = 0; i < entries.size(); ++i) index_[keyCode(entries[i].first)] = i;
+}
+
+LuaValue LuaTable::get(const LuaValue &key) const {
+    long i = find(key);
+    return i < 0 ? LuaValue() : entries[size_t(i)].second;
+}
+
+void LuaTable::set(const LuaValue &key, const LuaValue &value) {
+    if (key.isNil()) return;
+    long i = find(key);
+    if (value.isNil()) {
+        if (i >= 0) {
+            entries.erase(entries.begin() + i);
+            reindex();
+        }
+        return;
+    }
+    if (i >= 0) {
+        entries[size_t(i)].second = value;
+    } else {
+        index_[keyCode(key)] = entries.size();
+        entries.emplace_back(key, value);
+    }
+}
+
+bool LuaTable::next(const LuaValue &key, LuaValue &nextKey, LuaValue &nextValue) const {
+    size_t at = 0;
+    if (!key.isNil()) {
+        long i = find(key);
+        if (i < 0) return false;
+        at = size_t(i) + 1;
+    }
+    if (at >= entries.size()) return false;
+    nextKey = entries[at].first;
+    nextValue = entries[at].second;
+    return true;
+}
+
+// ---------------------------------------------------------------------------
+// Lua binding model
+// ---------------------------------------------------------------------------
+
+namespace {
+
+struct LuaBuilder {
+    std::vector<std::shared_ptr<LuaTable>> open;     // tables being filled
+    std::unordered_map<void *, std::shared_ptr<LuaTable>> done;  // finished tables by address
+    LuaValue rootScalar;
+    LuaValue message;
+
+    LuaValue convert(const Value &v) {
+        switch (v.type) {
+        case kJSONTrue: return LuaValue::boolean(true);
+        case kJSONFalse: return LuaValue::boolean(false);
+        case kJSONInteger: return LuaValue::integer(v.intval);
+        case kJSONFloat: return LuaValue::number(v.floatval);
+        case kJSONString: return LuaValue::string(v.stringval);
+        case kJSONArray:
+        case kJSONTable: {
+            auto it = done.find(v.ptr);
+            if (it == done.end()) return LuaValue();
+            LuaValue r;
+            r.kind = LuaValue::Table;
+            r.t = it->second;
+            return r;
+        }
+        default: return LuaValue();
+        }
+    }
+
+    Callbacks callbacks() {
+        Callbacks cb;
+        cb.decodeError = [this](Decoder &, const char *err, int line) {
+            message = LuaValue::string(std::string(err) + " at line " + std::to_string(line));
+        };
+        cb.willDecodeSublist = [this](Decoder &, const char *, int) {
+            open.push_back(std::make_shared<LuaTable>());
+        };
+        cb.didDecodeSublist = [this](Decoder &, const char *, int) -> void * {
+            auto t = open.back();
+            open.pop_back();
+            done[t.get()] = t;
+            return t.get();
+        };
+        cb.didDecodeTableValue = [this](Decoder &, const char *key, const Value &v) {
+            LuaValue lv = convert(v);
+            LuaTable &into = *open.back();
+            // "_array" holding a table is folded into its parent.
+            if (std::strcmp(key, "_array") == 0 && lv.kind == LuaValue::Table) {
+                for (auto &e : lv.t->entries) into.set(e.first, e.second);
+                return;
+            }
+            into.set(LuaValue::string(key), lv);
+        };
+        cb.didDecodeArrayValue = [this](Decoder &, int pos, const Value &v) {
+            if (pos == 0) {
+                rootScalar = convert(v);
+                return;
+            }
+            open.back()->set(LuaValue::integer(pos), convert(v));
+        };
+        return cb;
+    }
+};
+
+LuaDecodeResult luaRun(const std::string &bytes) {
+    LuaBuilder b;
+    Callbacks cb = b.callbacks();
+    size_t at = 0;
+    ReadFn reader = [&](uint8_t *buf, int size) -> int {
+        size_t n = std::min(bytes.size() - at, size_t(size));
+        std::memcpy(buf, bytes.data() + at, n);
+        at += n;
+        return int(n);
+    };
+    Value out;
+    DecodeStatus st;
+    int ok = decode(cb, reader, &out, &st);
+    LuaDecodeResult r;
+    if (st.hang) {
+        r.status = LuaDecodeResult::Undefined;
+        r.luaError = "decoder does not terminate";
+        return r;
+    }
+    if (ok) {
+        r.status = LuaDecodeResult::Ok;
+        r.value = (out.type == kJSONArray || out.type == kJSONTable) ? b.convert(out) : b.rootScalar;
+        return r;
+    }
+    r.status = LuaDecodeResult::Failed;
+    r.message = b.message;
+    return r;
+}
+
+}  // namespace
+
+LuaDecodeResult luaDecode(const std::string &str) { return luaRun(upToNul(str)); }
+
+LuaDecodeResult luaDecodeFile(const std::string &fileBytes) {
+    // A file shorter than 3 bytes is reported as empty, whatever it holds, so a
+    // saved "[]" or "{}" reads back as nil (measured in the Simulator).
+    if (fileBytes.size() < 3) {
+        LuaDecodeResult r;
+        r.status = LuaDecodeResult::Failed;
+        r.message = LuaValue::string("empty file at line 1");
+        return r;
+    }
+    if (fileBytes.size() >= 3 && (unsigned char)fileBytes[0] == 0xEF && (unsigned char)fileBytes[1] == 0xBB &&
+        (unsigned char)fileBytes[2] == 0xBF)
+        return luaRun(fileBytes.substr(3));
+    return luaRun(fileBytes);
+}
+
+// ---------------------------------------------------------------------------
+// Debug text
+// ---------------------------------------------------------------------------
+
+std::string describe(const Value &v) {
+    char buf[64];
+    switch (v.type) {
+    case kJSONNull: return "null";
+    case kJSONTrue: return "true";
+    case kJSONFalse: return "false";
+    case kJSONInteger: return std::to_string(v.intval);
+    case kJSONFloat: std::snprintf(buf, sizeof buf, "%.9g", double(v.floatval)); return buf;
+    case kJSONString: return "\"" + v.stringval + "\"";
+    case kJSONArray: std::snprintf(buf, sizeof buf, "array(%p)", v.ptr); return buf;
+    case kJSONTable: std::snprintf(buf, sizeof buf, "table(%p)", v.ptr); return buf;
+    default: return "?";
+    }
+}
+
+std::string describe(const LuaValue &v) {
+    char buf[64];
+    switch (v.kind) {
+    case LuaValue::Nil: return "nil";
+    case LuaValue::Bool: return v.b ? "true" : "false";
+    case LuaValue::Int: return std::to_string(v.i);
+    case LuaValue::Float: std::snprintf(buf, sizeof buf, "%.9g", double(v.f)); return buf;
+    case LuaValue::String: return "\"" + v.s + "\"";
+    case LuaValue::Table: {
+        std::string s = "{";
+        bool first = true;
+        for (auto &e : v.t->entries) {
+            if (!first) s += ",";
+            first = false;
+            s += "[" + describe(e.first) + "]=" + describe(e.second);
+        }
+        return s + "}";
+    }
+    }
+    return "?";
+}
+
+}  // namespace jsondecoder
