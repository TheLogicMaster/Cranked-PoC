+// ---------------------------------------------------------------------------------------------------------------------
+// floating point
+
+namespace armi {
+
+namespace {
+
+constexpr u32 FPSCR_DN = 1u << 25, FPSCR_FZ = 1u << 24;
+constexpr u32 DEFAULT_NAN32 = 0x7FC00000;
+constexpr u64 DEFAULT_NAN64 = 0x7FF8000000000000ull;
+
+inline float f32(u32 v) { float f; memcpy(&f, &v, 4); return f; }
+inline u32 bits32(float f) { u32 v; memcpy(&v, &f, 4); return v; }
+inline double f64(u64 v) { double d; memcpy(&d, &v, 8); return d; }
+inline u64 bits64(double d) { u64 v; memcpy(&v, &d, 8); return v; }
+
+inline bool isNaN32(u32 a) { return (a & 0x7F800000) == 0x7F800000 and (a & 0x7FFFFF); }
+inline bool isSNaN32(u32 a) { return isNaN32(a) and !(a & 0x400000); }
+inline bool isNaN64(u64 a) { return (a & 0x7FF0000000000000ull) == 0x7FF0000000000000ull and (a & 0xFFFFFFFFFFFFFull); }
+inline bool isSNaN64(u64 a) { return isNaN64(a) and !(a & 0x8000000000000ull); }
+inline bool isDenormal32(u32 a) { return (a & 0x7F800000) == 0 and (a & 0x7FFFFF); }
+inline bool isDenormal64(u64 a) { return (a & 0x7FF0000000000000ull) == 0 and (a & 0xFFFFFFFFFFFFFull); }
+
+// The arithmetic with the FPSCR's controls: flush-to-zero on inputs and results, NaN propagation, the default NaN
+struct Fp {
+    u32 fpscr;
+    bool dn() const { return fpscr & FPSCR_DN; }
+    bool fz() const { return fpscr & FPSCR_FZ; }
+    int rmode() const { return (fpscr >> 22) & 3; } // 0 nearest, 1 +inf, 2 -inf, 3 zero
+
+    u32 in32(u32 a) const { return fz() and isDenormal32(a) ? a & 0x80000000 : a; }
+    u64 in64(u64 a) const { return fz() and isDenormal64(a) ? a & 0x8000000000000000ull : a; }
+    u32 out32(u32 r) const { if (isNaN32(r)) return DEFAULT_NAN32; return fz() and isDenormal32(r) ? r & 0x80000000 : r; }
+    u64 out64(u64 r) const { if (isNaN64(r)) return DEFAULT_NAN64; return fz() and isDenormal64(r) ? r & 0x8000000000000000ull : r; }
+    u32 quiet32(u32 a) const { return dn() ? DEFAULT_NAN32 : a | 0x400000; }
+    u64 quiet64(u64 a) const { return dn() ? DEFAULT_NAN64 : a | 0x8000000000000ull; }
+
+    // FPProcessNaNs: the first signalling NaN, else the first quiet NaN; false if neither operand is a NaN
+    bool nans32(u32 a, u32 b, u32 &r) const {
+        if (isSNaN32(a)) { r = quiet32(a); return true; }
+        if (isSNaN32(b)) { r = quiet32(b); return true; }
+        if (isNaN32(a)) { r = quiet32(a); return true; }
+        if (isNaN32(b)) { r = quiet32(b); return true; }
+        return false;
+    }
+    bool nans64(u64 a, u64 b, u64 &r) const {
+        if (isSNaN64(a)) { r = quiet64(a); return true; }
+        if (isSNaN64(b)) { r = quiet64(b); return true; }
+        if (isNaN64(a)) { r = quiet64(a); return true; }
+        if (isNaN64(b)) { r = quiet64(b); return true; }
+        return false;
+    }
+    bool nans32(u32 a, u32 b, u32 c, u32 &r) const {
+        if (isSNaN32(a)) { r = quiet32(a); return true; }
+        if (isSNaN32(b)) { r = quiet32(b); return true; }
+        if (isSNaN32(c)) { r = quiet32(c); return true; }
+        if (isNaN32(a)) { r = quiet32(a); return true; }
+        if (isNaN32(b)) { r = quiet32(b); return true; }
+        if (isNaN32(c)) { r = quiet32(c); return true; }
+        return false;
+    }
+    bool nans64(u64 a, u64 b, u64 c, u64 &r) const {
+        if (isSNaN64(a)) { r = quiet64(a); return true; }
+        if (isSNaN64(b)) { r = quiet64(b); return true; }
