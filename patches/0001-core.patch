+// The output stage of a channel, as on the device. Its mix (8.24) is added to the output with the
+// channel's volume (times the volume modulator) and pan (plus the pan modulator), in parts split at the modulators'
+// events; across a part the gains ramp from the start values to the end values (interpolating modulators start from
+// their last value). Gains are 4.28 fixed point, added with a 32-bit multiply-accumulate that drops the low 4 bits.
+// A mono channel: left gain v x min(1 - p, 1), right v x min(1 + p, 1) (games built before SDK 2.6.0: max instead
+// of min). A stereo channel also feeds the right input into the left output by v x -p when panned left, and the left
+// into the right by v x p when panned right. Unity gain (pan 0, volume 1) adds the mix unchanged.
+void Audio::mixChannel(SoundChannel_32 &channel, const int32 *L, const int32 *R, int32 *outL, int32 *outR, int n, bool panPresent, bool panSweep,
+                       float panValue, float panBefore, int panEvent, bool volPresent, bool volSweep, float volValue, float volBefore, int volEvent, int gameVersion) {
+    auto smmla = [](int32 a, int32 b, int32 acc) { return (int32) ((uint32) acc + (uint32) (int32) (((int64) a * b) >> 32)); };
+    auto sb28 = [](int32 v) { return (int32) ((uint32) v << 4) >> 4; };
+    auto fx = [](float v) { v = min(v, 7.0f) * 268435456.0f; return !(v == v) ? 0 : v <= -2147483648.0f ? INT32_MIN : v >= 2147483647.0f ? INT32_MAX : (int32) v; };
+    bool oldLaw = gameVersion < 20600;
+    auto sideL = [&](float v, float p) { float g = 1.0f - p; return fx(v * (oldLaw ? max(g, 1.0f) : min(g, 1.0f))); };
+    auto sideR = [&](float v, float p) { float g = p + 1.0f; return fx(v * (oldLaw ? max(g, 1.0f) : min(g, 1.0f))); };
+    float pan = channel.pan, vol = channel.volume;
+    int count = n;
+    for (int pos = 0, guard = 0; pos < n and guard < n + 4; pos += count, guard++) {
+        // the part ends at the next modulator event after pos
+        uint32 cut = panPresent ? (uint32) panEvent : 0xFFFFFFFFu;
+        if (cut <= (uint32) pos) cut = 0xFFFFFFFFu;
+        if (volPresent and (uint32) pos < (uint32) volEvent and (uint32) volEvent <= cut) cut = (uint32) volEvent;
+        if (cut == 0xFFFFFFFFu or (uint32) n <= cut) count = n - pos;
+        else if (cut - (uint32) pos <= (uint32) count) count = (int) (cut - (uint32) pos);
+        if (count <= 0) { count = n - pos; }
+        float p0 = pan, p1 = pan, v0 = vol, v1 = vol;
+        if (panPresent) {
+            float m = panEvent < n and pos < panEvent ? panBefore : panValue;
+            p1 = p0 = pan + m;
+            if (panSweep) { p0 = pan + channel.panModPrev; channel.panModPrev = m; }
+        }
+        if (volPresent) {
+            float m = volEvent < n and pos < volEvent ? volBefore : volValue;
+            v1 = v0 = vol * m;
+            if (volSweep) { v0 = vol * channel.volumeModPrev; channel.volumeModPrev = m; }
+        }
+        if (!(v1 > 0 or v0 > 0)) continue;
+        int32 *oL = outL + pos, *oR = outR + pos;
+        const int32 *iL = L + pos, *iR = R ? R + pos : nullptr;
+        bool unity = p0 == 0 and p1 == 0 and v0 == 1 and v1 == 1;
+        bool ramp = p0 != p1 or v0 != v1;
+        if (!R) { // mono
+            if (unity) { for (int i = 0; i < count; i++) { oL[i] += iL[i]; oR[i] += iL[i]; } continue; }
+            int32 gL = sideL(v0, p0), gR = sideR(v0, p0);
+            int32 dL = ramp ? (int32) ((uint32) sideL(v1, p1) - (uint32) gL) : 0, dR = ramp ? (int32) ((uint32) sideR(v1, p1) - (uint32) gR) : 0;
+            int32 accL = 0, accR = 0;
+            for (int i = 0; i < count; i++) {
+                oL[i] = (int32) ((uint32) smmla(iL[i], (int32) ((uint32) (accL / count) + (uint32) gL), oL[i] >> 4) << 4);
+                oR[i] = (int32) ((uint32) smmla(iL[i], (int32) ((uint32) (accR / count) + (uint32) gR), oR[i] >> 4) << 4);
+                accL = (int32) ((uint32) accL + (uint32) dL); accR = (int32) ((uint32) accR + (uint32) dR);
+            }
+        } else { // stereo
+            if (unity) { for (int i = 0; i < count; i++) { oL[i] += iL[i]; oR[i] += iR[i]; } continue; }
+            auto gains = [&](float v, float p, int32 g[4]) {
+                g[0] = fx(v * min(1.0f - p, 1.0f)); // left to left
+                g[1] = fx(v * (p <= 0 ? -p : 0.0f)); // right to left
+                g[2] = fx(v * (p < 0 ? 0.0f : p)); // left to right
+                g[3] = fx(v * min(p + 1.0f, 1.0f)); // right to right
+            };
+            int32 g0[4], g1[4], d[4], acc[4] = {};
+            gains(v0, p0, g0);
+            if (ramp) gains(v1, p1, g1); else for (int k = 0; k < 4; k++) g1[k] = g0[k];
+            for (int k = 0; k < 4; k++) d[k] = (int32) ((uint32) g1[k] - (uint32) g0[k]);
+            for (int i = 0; i < count; i++) {
+                int32 g[4];
+                for (int k = 0; k < 4; k++) g[k] = ramp ? (int32) ((uint32) (acc[k] / count) + (uint32) g0[k]) : g0[k];
+                oL[i] = (int32) ((uint32) smmla(iL[i], g[0], sb28(smmla(iR[i], g[1], oL[i] >> 4))) << 4);
+                oR[i] = (int32) ((uint32) smmla(iL[i], g[2], sb28(smmla(iR[i], g[3], oR[i] >> 4))) << 4);
+                for (int k = 0; k < 4; k++) acc[k] = (int32) ((uint32) acc[k] + (uint32) d[k]);
+            }
+        }
+    }
+}
