+namespace cranked {
+// called before each Lua update: runs the finish callbacks of sequences that finished
+void runSequenceCallbacks(Cranked *cranked) {
+    auto finished = std::move(cranked->audio.finishedSequences);
+    cranked->audio.finishedSequences.clear();
+    lua_State *L = cranked->getLuaContext();
+    if (!L) return;
+    for (auto sequence : finished) {
+        int top = lua_gettop(L);
+        lua_getfield(L, LUA_REGISTRYINDEX, "crankedSequenceFinish");
+        if (lua_istable(L, -1)) {
+            pushResource(cranked, sequence);
+            lua_pushvalue(L, -1); lua_gettable(L, -3);
+            if (lua_isfunction(L, -1)) {
+                lua_pushvalue(L, -2); lua_pushnil(L); lua_settable(L, -5); // one call per play
+                lua_insert(L, -2);
+                lua_pcall(L, 1, 0, 0);
+            }
+        }
+        lua_settop(L, top);
+    }
+    auto looped = std::move(cranked->audio.loopedSources);
+    cranked->audio.loopedSources.clear();
+    auto finishedPlayers = std::move(cranked->audio.finishedSources);
+    cranked->audio.finishedSources.clear();
+    auto faded = std::move(cranked->audio.fadedSources);
+    cranked->audio.fadedSources.clear();
+    vector<pair<NativeResource *, const char *>> queue; // loop and fade callbacks too
+    for (auto source : looped) queue.emplace_back(source, "crankedLoop");
+    for (auto source : faded) queue.emplace_back(source, "crankedFade");
+    for (auto source : finishedPlayers) queue.emplace_back(source, "crankedFinish");
+    for (auto [source, tableName] : queue) {
+        int top = lua_gettop(L);
+        lua_getfield(L, LUA_REGISTRYINDEX, tableName);
+        if (lua_istable(L, -1)) {
+            pushResource(cranked, source);
+            int object = lua_gettop(L);
+            lua_pushvalue(L, object); lua_gettable(L, -3);
+            if (lua_istable(L, -1)) {
+                // one call per fade (as on the device, the user values are cleared)
+                if (!strcmp(tableName, "crankedFade")) {
+                    lua_pushvalue(L, object); lua_pushnil(L); lua_settable(L, -5);
+                }
+                lua_rawgeti(L, -1, 1); lua_pushvalue(L, object); lua_rawgeti(L, -3, 2);
+                if (lua_isfunction(L, -3)) lua_pcall(L, 2, 0, 0);
+            }
+        }
+        lua_settop(L, top);
+    }
+    // the held sound objects that are not playing any more are let go of (see holdWhilePlaying); one just started
+    // is kept for one more update, since some start at the next render or at a later time
+    int top = lua_gettop(L);
+    lua_getfield(L, LUA_REGISTRYINDEX, "crankedPlaying");
+    if (lua_istable(L, -1)) {
+        int held = lua_gettop(L);
+        vector<pair<int, bool>> changes; // registry references to the keys, and whether to drop (else age)
+        lua_pushnil(L);
+        while (lua_next(L, held)) {
+            bool fresh = lua_toboolean(L, -1);
+            auto source = LuaVal(L, -2).asUserdataObject<SoundSource_32 *>();
+            bool playing = source and source->playing;
+            if (!playing or fresh) { lua_pushvalue(L, -2); changes.emplace_back(luaL_ref(L, LUA_REGISTRYINDEX), !playing and !fresh); }
+            lua_pop(L, 1);
+        }
+        for (auto [ref, drop] : changes) {
+            lua_rawgeti(L, LUA_REGISTRYINDEX, ref);
+            if (drop) lua_pushnil(L); else lua_pushboolean(L, 0);
+            lua_settable(L, held);
+            luaL_unref(L, LUA_REGISTRYINDEX, ref);
+        }
+    }
+    lua_settop(L, top);
 }
+} // namespace cranked
 
