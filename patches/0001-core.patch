+        }
+        if (wavetable and !wavetable->pcm.empty()) { renderWavetableSegment(*this, outL, outR, count, (int32) step0, stepDelta, a0, a1, b0, b1); return; }
+        int32 deltaL = (a1 - a0) / count, deltaR = (b1 - b0) / count, aL = a0, aR = b0;
+        auto add = [&](int i, int32 v, int32 l, int32 r) { accumulate(outL[i], v, l); accumulate(outR[i], v, r); };
+        for (int i = 0; i < count; i++, aL += deltaL, aR += deltaR) {
+            int32 l = aL, r = aR;
+            uint32 step = step0 + (uint32) (stepDelta * i), p = genPhase;
+            switch (waveform) {
+                case SoundWaveform::Sine:
+                    add(i, tableSample(synthTables().sine, 10, p), l, r); genPhase = p + step; break;
+                case SoundWaveform::Sawtooth:
+                    if (step < (1u << 23)) add(i, (int32) (p >> 8), l, r); // measured: a rising ramp from 0 to twice full scale
+                    else { const int16 *t; int bits; tableFor(false, step, t, bits); add(i, tableSample(t, bits, p), l, r); }
+                    genPhase = p + step; break;
+                case SoundWaveform::Triangle:
+                    if (step < (1u << 23)) {
+                        uint32 u = p >> 16;
+                        int32 v = p < 0x40000000 ? (int32) (u << 1) : u < 0xC000 ? (int32) (0x7FFF - 2 * ((int32) u - 0x4000)) : ((int32) u - 0x10000) * 2;
+                        add(i, v << 8, l, r);
+                    } else { const int16 *t; int bits; tableFor(true, step, t, bits); add(i, tableSample(t, bits, p), l, r); }
+                    genPhase = p + step; break;
+                case SoundWaveform::Square:
+                    if (step < (1u << 23)) add(i, p < genParam ? -0x800000 : 0x7FFFFF, l, r);
+                    else { // the difference of two band-limited sawtooths, half a duty cycle apart
+                        const int16 *t; int bits; tableFor(false, step, t, bits);
+                        add(i, tableSample(t, bits, p + genParam), l, r);
+                        add(i, tableSample(t, bits, p), -l, -r);
+                    }
+                    genPhase = p + step; break;
+                default: { // noise: a 16-bit LFSR stepped each time the phase, advancing 16 steps per sample, wraps
+                    uint32 big = step << 4;
+                    if (~p < big) {
