+// Notes may be MIDI numbers or names such as "C4"; with no range the voice covers every note.
+static float noteValue(LuaVal v, float fallback) {
+    if (v.isNumeric()) return v.asFloat();
+    if (!v.isString()) return fallback;
+    string name(v.asString());
+    static const map<char, int> base{ { 'C', 0 }, { 'D', 2 }, { 'E', 4 }, { 'F', 5 }, { 'G', 7 }, { 'A', 9 }, { 'B', 11 } };
+    if (name.empty() or !base.contains((char) toupper(name[0]))) return fallback;
+    int semitone = base.at((char) toupper(name[0])); size_t i = 1;
+    while (i < name.size() and (name[i] == '#' or name[i] == 'b')) semitone += name[i++] == '#' ? 1 : -1;
+    int octave = i < name.size() ? atoi(name.c_str() + i) : 4;
+    return (float) (12 * (octave + 1) + semitone);
 }
 
