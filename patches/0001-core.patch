+            uint32 frames = (uint32) (sample->pcm.size() / sample->channels);
+            constexpr double MIDDLE_C_PHASE = 261.63 * 4294967295.0; // middle C at 261.63 Hz, the documented pitch, in (2^32 - 1) phase units (measured)
+            float divisor = (float) (MIDDLE_C_PHASE / (double) sample->sampleRate);
+            // measured: the conversion rounds to nearest rather than truncating
+            int32 sstep = (int32) lrintf((float) step0 * 65536.0f / divisor);
+            int32 l = a0, r = b0;
+            int done = renderSampleRamp(sample->pcm, sample->channels, sampleLooping ? sampleSustainEnd : frames, samplePos, sampleFrac,
+                                        sstep, stepDelta, l, a1, r, b1, outL, outR, count);
+            while (sampleLooping and done < count) {
