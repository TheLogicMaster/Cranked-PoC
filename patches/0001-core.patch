+// register access (Dn is S[2n] low, S[2n+1] high)
+#define ARMI_S(i) st.s[(i)]
+static inline u64 getD(const State &st, int i) { return (u64) st.s[2 * i] | (u64) st.s[2 * i + 1] << 32; }
+static inline void setD(State &st, int i, u64 v) { st.s[2 * i] = (u32) v; st.s[2 * i + 1] = (u32) (v >> 32); }
