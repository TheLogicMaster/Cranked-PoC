+            // to 10^e and rounded once to single precision.
+            double v = whole64 * doublePowerOfTen(e);
+            // A positive exponent gives an integer when the result is not above
+            // 2^31-1 (no minus sign) or not below -2^31 (minus sign). Only one
+            // bound is checked, so a wrapped integer part can pass with an
+            // out-of-range result. Its conversion saturates, as the device's
+            // ARM conversion does (3.1.2): above 2^31-1 gives
+            // 2^31-1. The Simulator's x86 conversion gives -2^31 for any
+            // out-of-range value ("-7688231203E020" gives -2147483648 there).
+            if (e > 0 && (negative ? v >= -2147483648.0 : v <= 2147483647.0)) {
+                out.type = kJSONInteger;
+                out.intval = v > 2147483647.0 ? INT32_MAX : v < -2147483648.0 ? INT32_MIN : int32_t(v);
+                return true;
+            }
+            out.floatval = canonicalNan(float(v));
+            return true;
+        }
+
+        unpull(c);
+        if (hasFraction) {
+            out.type = kJSONFloat;
+            out.floatval = mantissa;
+        } else {
+            out.type = kJSONInteger;
+            out.intval = negative ? int32_t(0u - whole) : int32_t(whole);
+        }
+        return true;
+    }
+
+    // ---- raw sublist text (returnString and filtered sublists) ----
+    // Collects the text up to the bracket that closes the sublist, which the
+    // caller has already opened. Leading white space is dropped. Text between
+    // double or single quotes is not scanned for brackets. Returns false at end
