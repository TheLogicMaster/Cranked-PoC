+// The tap reads the ring at the line's write position
+// less its delay. A delay modulator's value (seconds) is added to the delay (44100 x value, rounded toward zero).
+// When the delay used changes from the last block's, the block renders the tap at the set delay fading out and at the
+// new delay fading in; the fades go a block's share of the ring's length (scaled by the ring size, not by
+// the block length), so they do not finish. A sweeping LFO shape instead reads with a fractional step that covers
+// the change over the block, starting at the set delay; a change of 0x8000 frames or more skips the block.
+bool DelayLineTap_32::renderFixed(int32 *left, int32 *right, uint32 blockStart, int length) {
+    auto line = delayLine.get();
+    if (!line or line->data.empty()) return true;
+    if ((int64) line->silentFrames > (int64) line->data.size()) return true;
+    auto smmla = [](int32 a, int32 b, int32 acc) { return (int32) ((uint32) acc + (uint32) (int32) (((int64) a * b) >> 32)); };
+    auto s28 = [](float v) { v = min(v, 7.0f) * 268435456.0f; return !(v == v) ? 0 : v <= -2147483648.0f ? INT32_MIN : v >= 2147483647.0f ? INT32_MAX : (int32) v; };
+    bool stereo = line->stereo and !line->dataR.empty();
+    auto &ringL = stereo and channelsFlipped ? line->dataR : line->data;
+    auto &ringR = stereo ? (channelsFlipped ? line->data : line->dataR) : line->data;
+    auto size = (int64) line->data.size();
+    auto readAt = [&](int64 delay) { int64 r = ((int64) line->position - delay) % size; return r < 0 ? r + size : r; };
+    int32 delay = delayFrames;
+    auto mod = stepRateModulator(delayModulator, blockStart, length);
+    if (mod.present) {
+        float sr = (float) AUDIO_SAMPLING_RATE;
+        delay = toInt32Sat(cranked.audio.simulatorFloat ? (float) delayFrames + sr * mod.value : fmaf(sr, mod.value, (float) delayFrames));
+    }
+    // the volume goes from a toward b by i x (b - a) / ring size (in 32-bit arithmetic)
+    auto tap = [&](const vector<int32> &ring, int32 *out, int64 read, float a, float b) {
+        int32 va = s28(a), vb = s28(b);
+        auto diff = (int32) ((uint32) vb - (uint32) va);
+        for (int i = 0; i < length; i++) {
+            int32 v = va == vb ? va : (int32) ((uint32) va + (uint32) ((int32) ((uint32) i * (uint32) diff) / (int32) size));
+            out[i] = (int32) ((uint32) smmla(ring[(size_t) ((read + i) % size)], v, out[i] >> 4) << 4);
+        }
+    };
+    if (!mod.present or !mod.sweep or delay == lastDelay) {
+        int64 read = readAt(delayFrames);
+        float endL = delay == lastDelay ? leftVolume : 0, endR = delay == lastDelay ? rightVolume : 0;
+        tap(ringL, left, read, leftVolume, endL);
+        if (right) tap(ringR, right, read, rightVolume, endR);
+        if (delay != lastDelay) {
+            int64 read2 = readAt(delay);
+            tap(ringL, left, read2, 0, leftVolume);
+            if (right) tap(ringR, right, read2, 0, rightVolume);
+        }
+    } else {
+        auto change = (uint32) (delay + length - lastDelay);
+        if (change > 0x7FFF) { lastDelay = delay; return false; }
+        auto toU28 = [](float v) { v = min(v, 7.0f) * 268435456.0f; return !(v > 0) ? 0u : v >= 4294967295.0f ? 0xFFFFFFFFu : (uint32) v; };
+        auto vL = (int32) toU28(leftVolume), vR = (int32) toU28(rightVolume);
+        int64 read = readAt(delayFrames);
+        uint32 frac = sweepFrac;
+        for (int i = 0; i < length; i++) {
+            size_t i0 = (size_t) (read % size), i1 = (size_t) ((read + 1) % size);
+            auto w0 = (int32) ((0x10000 - frac) * 0x1000), w1 = (int32) (frac << 12);
+            auto sample = [&](const vector<int32> &ring) {
+                int32 hi = (int32) (((int64) ring[i1] * w1) >> 32);
+                return (int32) ((uint32) smmla(ring[i0], w0, (int32) ((uint32) hi << 4) >> 4) << 4);
+            };
+            int32 l = sample(ringL);
+            left[i] = (int32) ((uint32) smmla(l, vL, left[i] >> 4) << 4);
+            if (right) right[i] = (int32) ((uint32) smmla(stereo ? sample(ringR) : l, vR, right[i] >> 4) << 4);
+            frac += (uint32) ((int32) (change * 0x10000u) / length);
+            read += (int32) frac >> 16;
+            frac &= 0xFFFF;
+        }
+        sweepFrac = frac;
+    }
+    lastDelay = delay;
+    return true;
+}
+
+void DelayLineTap_32::sampleAudio(int16 *left, int16 *right, int length) {
+    if (!delayLine or delayLine->data.empty()) return;
+    auto &data = delayLine->data;
+    size_t size = data.size();
+    for (int i = 0; i < length; i++) {
+        size_t index = (delayLine->position + size + i - (size_t) (delayFrames % (int) size)) % size;
+        auto v = (int16) max(-32768, min(32767, data[index] >> 8));
+        left[i] = right[i] = v;
+    }
+}
