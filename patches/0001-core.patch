+// Wavetables: the X (and with several rows, Y) position moves toward its target by at most
+// one cell boundary per call, and the output mixes the two (or four) neighboring tables with weights that ramp from
+// the start to the end position's fractions, all on the synth's phase.
+// TE generator tables: a 1024-step sine (one guard entry) and a raised cosine, (1 - cos) / 2, built
+// from its first half and mirrored
+namespace {
+    struct TeTables {
+        int16 sine[1025]{}, bump[1025]{};
+        TeTables() {
+            for (int i = 0; i <= 1024; i++) sine[i] = (int16) lround(32767.0 * sin(2 * M_PI * i / 1024));
+            for (int i = 0; i <= 512; i++) bump[i] = bump[1024 - i] = (int16) floor(32767.0 * (1 - cos(2 * M_PI * i / 1024)) / 2 + 0.5);
+        }
+    };
+    const TeTables &teTables() { static TeTables t; return t; }
+
+    // A sine read with 20 bits of interpolation: x is 30 bits of phase
+    int32 teInterpolate(uint32 x) {
+        auto &t = teTables().sine;
+        uint32 i = x >> 20, f = x & 0xFFFFF;
+        return (int16) (((int64) t[i + 1] * f + (int64) t[i] * (0xFFFFF - f)) >> 20);
+    }
+}
+
+// The phase, digital and VOSIM generators, one sample at a time,
+// with the synth's usual volume ramps
+static void renderTeSegment(PDSynth_32 &s, uint32 &lastPhase, int32 *left, int32 *right, int n, uint32 step, int32 delta,
+                            int32 a, int32 a1, int32 b, int32 b1) {
+    int32 dA = (a1 - a) / n, dB = (b1 - b) / n;
+    auto out = [&](int i, int32 v) {
+        accumulate(left[i], v, a); a += dA;
+        if (right) { accumulate(right[i], v, b); b += dB; }
+    };
+    if (s.waveform == SoundWaveform::POPhase) {
+        // two sines at (latched p1 + 32) / 32 and (latched p2 + 64) / 64 times the phase, summed, fading over the cycle,
+        // scaled by p2 / 8 + 1 and saturated to 23 bits. The parameters are latched when the phase wraps
+        uint64 m1 = s.teLatch[0] + 32u, m2 = s.teLatch[1] + 64u;
+        int32 gain = (s.teParam[1] >> 3) + 1;
+        for (int i = 0; i < n; i++) {
+            uint32 p = s.tePhase[0];
+            int32 v1 = teInterpolate((uint32) ((m1 * p) >> 5) >> 2), v2 = teInterpolate((uint32) ((m2 * p) >> 6) >> 2);
+            uint32 next = p + step; step += (uint32) delta;
+            s.tePhase[0] = next;
+            if (next < lastPhase) { s.teLatch[0] = s.teParam[0]; s.teLatch[1] = s.teParam[1]; }
+            lastPhase = next;
+            int32 fade = (int32) (((0x7FFFu - (p >> 17)) * 0x7FFFu) >> 15);
+            int32 v = (int32) ((uint32) (v1 + v2) * (uint32) fade) >> 8;
+            v = max(-0x400000, min(0x3FFFFF, v * gain));
+            out(i, v);
+        }
+    } else if (s.waveform == SoundWaveform::PODigital) {
+        // a sine with feedback (amount p2 squared), plus half a sine at a multiple of the frequency, XORed with the
+        // magnitude of a third sine (level p1 squared). The step does not sweep within a segment
+        auto &t = teTables().sine;
+        uint32 b1sq = (uint32) s.teParam[1] * s.teParam[1], b0sq4 = ((uint32) s.teParam[0] * s.teParam[0]) >> 2;
+        uint32 inc = (step << (s.teParam[0] >> 4)) + ((step * (uint32) (s.teParam[1] * 4 - 256)) >> 31);
+        for (int i = 0; i < n; i++) {
+            int32 x = t[((uint32) s.teFeedback * b1sq + s.tePhase[0]) >> 22];
+            s.teFeedback = x;
+            int32 y = t[s.tePhase[1] >> 22] >> 1;
+            int32 sum = (int16) max(-32768, min(32767, x + y));
+            int32 z = (int32) (b0sq4 * (uint32) (int32) t[s.tePhase[2] >> 22]) >> 15;
+            if (z < 0) z = -z;
+            int32 v = ((sum ^ (z & 0xFFFF)) >> 1) << 8;
+            out(i, v);
+            s.tePhase[0] += step; s.tePhase[1] += inc; s.tePhase[2] += inc;
+        }
+    } else { // POVosim
+        // two raised-cosine pulse trains whose rates rise with p1 and p2, each halving in level every quarter of
+        // its run; both restart with each cycle, and the sum fades over the last quarter of the cycle
+        auto &t = teTables().bump;
+        uint32 incA = (1u << 24) / 10 + ((uint32) s.teParam[0] << 14), incB = ((uint32) s.teParam[1] << 15) + (1u << 24) / 3;
+        for (int i = 0; i < n; i++) {
+            int32 env = max(0, min(0x7FFF, (int32) (0x1FFFFu - (s.tePhase[0] >> 15))));
+            uint32 pA = s.tePhase[1], pB = s.tePhase[2];
+            int32 sA = t[(pA >> 18) & 0x3FF] >> (pA >> 28), sB = t[(pB >> 18) & 0x3FF] >> (pB >> 28);
+            s.tePhase[2] = (uint32) min<int64>((int64) (int32) (pB + incB) < 0 ? 0 : (int32) (pB + incB), 0x3FFFFFFF);
+            s.tePhase[1] = (uint32) min<int64>((int64) (int32) (pA + incA) < 0 ? 0 : (int32) (pA + incA), 0x3FFFFFFF);
+            uint32 before = s.tePhase[0];
+            s.tePhase[0] = before + step;
+            if (s.tePhase[0] < before) s.tePhase[1] = s.tePhase[2] = 0;
+            step += (uint32) delta;
+            out(i, (env * (sA + sB)) >> 8);
+        }
+    }
+}
+
+static void renderWavetableSegment(PDSynth_32 &s, int32 *left, int32 *right, int n, int32 step, int32 delta, int32 a0, int32 a1, int32 b0, int32 b1) {
+    const int16 *data = s.wavetable->pcm.data();
+    int L = s.wtLog2;
+    auto approach = [](uint32 target, uint32 &cur, uint32 &i0, uint32 &f0, uint32 &f1) {
+        uint32 from = cur == 0xFFFFFFFF ? target : cur;
+        i0 = from >> 16; f0 = from & 0xFFFF;
+        if (f0 == 0 and target < from) { i0 -= 1; f0 = 0x10000; }
+        if (target >> 16 == i0) { f1 = target & 0xFFFF; cur = target; }
+        else if (i0 < target >> 16) { f1 = 0x10000; cur = (from & 0xFFFF0000u) + 0x10000; }
+        else { f1 = 0; cur = i0 << 16; }
+    };
+    uint32 i0, f0, f1;
+    approach(s.wtX, s.wtXCur, i0, f0, f1);
+    int32 wtA0 = a0 >> 16, wtA1 = a1 >> 16, wtB0 = b0 >> 16, wtB1 = b1 >> 16;
+    uint32 phase = s.genPhase;
+    const int16 *base = data;
+    auto table = [&](const int16 *row, uint32 column) { return row + ((size_t) column << L); };
+    if (s.wtRows > 1) {
+        uint32 j0, g0, g1;
+        approach(s.wtY, s.wtYCur, j0, g0, g1);
+        base = data + ((size_t) s.wtColumns * j0 << L);
+        if (g0 != 0 or g1 != 0) {
+            uint32 w00s = (0x10000 - g0) * (0x10000 - f0) >> 16, w00e = (0x10000 - g1) * (0x10000 - f1) >> 16;
+            uint32 w10s = f0 * (0x10000 - g0) >> 16, w10e = f1 * (0x10000 - g1) >> 16;
+            uint32 w01s = g0 * (0x10000 - f0) >> 16, w01e = g1 * (0x10000 - f1) >> 16;
+            uint32 w11s = g0 * f0 >> 16, w11e = g1 * f1 >> 16;
+            renderTableSample(table(base, i0), L, phase, step, delta, n, left, right, wtA0 * (int32) w00s, (int32) w00e * wtA1, (int32) w00s * wtB0, (int32) w00e * wtB1);
+            renderTableSample(table(base, i0 + 1), L, phase, step, delta, n, left, right, (int32) w10s * wtA0, (int32) w10e * wtA1, (int32) w10s * wtB0, (int32) w10e * wtB1);
+            const int16 *next = base + ((size_t) s.wtColumns << L);
+            renderTableSample(table(next, i0), L, phase, step, delta, n, left, right, wtA0 * (int32) w01s, wtA1 * (int32) w01e, (int32) w01s * wtB0, (int32) w01e * wtB1);
+            s.genPhase = renderTableSample(table(next, i0 + 1), L, phase, step, delta, n, left, right, (int32) w11s * wtA0, wtA1 * (int32) w11e, (int32) w11s * wtB0, (int32) w11e * wtB1);
+            return;
+        }
+    }
+    if (f0 != 0 or f1 != 0) {
+        renderTableSample(table(base, i0), L, phase, step, delta, n, left, right, (int32) (0x10000 - f0) * wtA0, (int32) (0x10000 - f1) * wtA1,
+                          (int32) (0x10000 - f0) * wtB0, (int32) (0x10000 - f1) * wtB1);
+        s.genPhase = renderTableSample(table(base, i0 + 1), L, phase, step, delta, n, left, right, (int32) f0 * wtA0, (int32) f1 * wtA1, (int32) f0 * wtB0, (int32) f1 * wtB1);
+        return;
+    }
+    s.genPhase = renderTableSample(table(base, i0), L, phase, step, delta, n, left, right, a0, a1, b0, b1);
+}
+
+void PDSynth_32::setWaveformState(SoundWaveform wave) {
+    waveform = wave;
+    sample = nullptr; wavetable = nullptr; // a waveform replaces a sample or wavetable generator
+    genPhase = 0;
+    genParam = wave == SoundWaveform::Square ? 0x80000000 : wave == SoundWaveform::Noise ? 1 : 0;
+    teParam[0] = teParam[1] = teLatch[0] = teLatch[1] = 0; tePhase[0] = tePhase[1] = tePhase[2] = 0; teFeedback = 0;
+}
+
+void PDSynth_32::scheduleNote(uint32 start, float frequency, float velocity, float length) {
+    // as on the device: a synth holds its current note (A) and one queued note (B). A note for
+    // later goes into A when there is no current note, otherwise into B, replacing what B held. A note for now starts
+    // at once and clears B. (pendingNotes: a not yet started A first, then B.)
+    playing = true;
+    envNoteOff = false; // playNote clears the synth's note-off flag (not the note's start)
+    PendingNote note{ start, frequency, velocity, length };
+    uint32 now = cranked.audio.sampleTime;
+    if (start <= now) {
+        pendingNotes.clear();
+        pendingNotes.push_back(note);
+        immediateNote = true;
+        return;
+    }
+    bool haveA = noteActive or !pendingNotes.empty();
+    if (!haveA) { pendingNotes.push_back(note); return; }
+    if (noteActive) { pendingNotes.clear(); pendingNotes.push_back(note); return; } // the current note is A; this is B
+    if (pendingNotes.size() > 1) pendingNotes.pop_back();
+    pendingNotes.push_back(note);
+}
+
+void PDSynth_32::noteOffAt(uint32 when) {
+    // the device turns a note off by giving it a length that ends at `when`
+    // with no current note, the queued note B takes the place of A
+    if (!noteActive) { if (!pendingNotes.empty()) pendingNotes.erase(pendingNotes.begin()); return; }
+    if (released) return;
+    uint32 now = cranked.audio.sampleTime;
+    noteLength = (float) (noteTime + (when > now ? when - now : 0)) / SYNTH_RATE;
+}
+
+// Sample playback: plays from pos while lo <= pos < hi, at most count frames, with the volume
+// ramping from a to a1 (b to b1 on the right). Interpolation stops one frame before interpEnd, counted from base; for
+// stereo the device compares a sample index with a frame count there. A step of exactly 1.0 reads without
+// interpolation (and leaves the fraction as it was). Afterwards the position is clamped to the bounds. Frames outside
+// the sample read as silence (the device reads whatever memory follows).
+// The frames are read through at(frame, channel).
+template<class At>
+static int fillSampleFrames(At at, int ch, int64 lo, int64 hi, int64 base, int64 interpEnd, int32 &pos, uint32 &frac,
+                            int32 step, int32 delta, int32 *left, int32 *right, int count, int32 a, int32 a1, int32 b, int32 b1) {
+    if (count <= 0) return 0; // no frames: nothing is rendered, as on the device
+    int32 dA = (a1 - a) / count, dB = (b1 - b) / count;
+    bool unity = a == 0x10000000 and b == 0x10000000 and dA == 0 and dB == 0;
+    int64 p = pos; // as on the device, a position below 0 is past every bound
+    bool whole = step == 0x10000 and delta == 0; // read without interpolation
+    int i = 0;
+    for (; i < count and p >= lo and p < hi and p >= 0; i++) {
+        int32 l, r;
+        if (whole) {
+            l = at(p, 0) << 8; r = ch == 2 ? at(p, 1) << 8 : l;
+        } else {
+            int64 rel = p - base;
+            bool interpolate = ch == 1 ? rel < interpEnd - 1 : 2 * rel < interpEnd - 2;
+            if (interpolate) {
+                int64 f = frac, g = 0x10000 - frac; // 16-bit products, divided by 256 toward zero
+                l = (int32) ((f * at(p + 1, 0) + g * at(p, 0)) / 256);
+                r = ch == 2 ? (int32) ((f * at(p + 1, 1) + g * at(p, 1)) / 256) : l;
+            } else {
+                l = at(p, 0) << 8; r = ch == 2 ? at(p, 1) << 8 : l;
+            }
+        }
+        if (unity) { left[i] += l; right[i] += r; }
+        else { accumulate(left[i], l, a); accumulate(right[i], r, b); }
+        a += dA; b += dB;
+        if (whole) p++;
+        else { int32 t = (int32) (frac + (uint32) step); step += delta; p += t >> 16; frac = (uint32) t & 0xFFFF; }
+    }
+    pos = (int32) (p >= lo ? min(p, hi) : lo);
+    return i;
+}
+
+static int fillSamplePlayer(AudioSample_32 &sample, int ch, int64 lo, int64 hi, int64 base, int64 interpEnd, int32 &pos, uint32 &frac,
+                            int32 step, int32 delta, int32 *left, int32 *right, int count, int32 a, int32 a1, int32 b, int32 b1) {
+    auto &pcm = sample.pcm;
+    auto frames = (int64) (pcm.size() / ch);
+    auto at = [&](int64 f, int c) -> int32 {
+        if (f < 0 or f >= frames) return 0;
+        sample.lazy.ensure(pcm, (uint64) f); // decoded as it is read
+        return pcm[(size_t) (f * ch + c)];
+    };
+    return fillSampleFrames(at, ch, lo, hi, base, interpEnd, pos, frac, step, delta, left, right, count, a, a1, b, b1);
+}
+
+int32 SamplePlayer_32::stepFor(float r) const {
+    if (!sample) return 0;
+    return (int32) ((float) sample->sampleRate * r * 65536.0f / (float) AUDIO_SAMPLING_RATE);
+}
+
+bool SamplePlayer_32::pbActive() const {
+    return pbStarted and !(pbStartPending and pbStartTime <= cranked.audio.sampleTime);
+}
+
+bool SamplePlayer_32::pbIsPlaying() const {
+    return pbStarted or (pbStartPending and pbStartTime <= cranked.audio.sampleTime);
+}
+
+void SamplePlayer_32::pbPlay(int repeatCount, float playRate, uint32 when, float volLeft, float volRight) {
+    if (!sample or sample->pcm.empty()) return;
+    std::erase(cranked.audio.finishedSources, (NativeResource *) this); // pending notifications are dropped
+    std::erase(cranked.audio.loopedSources, (NativeResource *) this);
+    pbStartTime = when; pendRepeat = repeatCount; oneShotLeft = volLeft; oneShotRight = volRight;
+    pbStartPending = true;
+    pbPendStep = stepFor(playRate == 0 ? rate : playRate); // the stored rate is not changed
+    syncPlaying();
+}
+
+void SamplePlayer_32::pbStop() {
+    bool was = pbStarted;
+    pbStarted = false; pendRangeLo = 0; pbStartPending = false; pbFadeOut = true;
+    leftVolume = savedLeft; rightVolume = savedRight; pbOneShot = false;
+    syncPlaying();
+    if (was) pbFinished();
+}
+
+void SamplePlayer_32::pbSetPaused(bool flag) {
+    if (!pbPaused) {
+        if (!flag) return;
+        pbPaused = true; pbFadeOut = true; pbFadeIn = false; pbStarted = false;
+    } else {
+        if (flag) return;
+        pbPaused = false; pbFadeIn = true;
+    }
+    syncPlaying();
+}
+
+void SamplePlayer_32::pbFinished() {
+    cranked.audio.finishedSources.push_back(this); // Lua callbacks run on the main thread
+    if (completionCallback) // the device calls a C callback from the audio render
+        cranked.nativeEngine.invokeEmulatedFunction<void, ArgType::void_t, ArgType::ptr_t, ArgType::uint32_t>(completionCallback, this, completionCallbackUserdata);
+}
+
+void SamplePlayer_32::pbLooped() {
+    cranked.audio.loopedSources.push_back(this);
+    if (loopCallback)
+        cranked.nativeEngine.invokeEmulatedFunction<void, ArgType::void_t, ArgType::ptr_t, ArgType::uint32_t>(loopCallback, this, loopCallbackUserdata);
+}
+
+// a player's rate modulator, stepped once per block: its value, and for an
+// LFO the value just before its event and the event's offset in the block (-1 for other signals: no split), and
+// whether the step sweeps between values (LFO shapes that interpolate)
+struct RateModulation { bool present{}, sweep{}; float value{}, before{}; int event = -1; };
+static int32 toInt32Sat(float v) { // toward zero, saturating (NaN is 0), as the device's float conversion
+    return !(v == v) ? 0 : v >= 2147483647.0f ? INT32_MAX : v <= -2147483648.0f ? INT32_MIN : (int32) v;
+}
+static RateModulation stepRateModulator(const SynthSignalValueRef &mod, uint32 blockStart, int n) {
+    RateModulation m;
+    if (auto lfo = dynamic_cast<PDSynthLFO_32 *>(mod.get())) {
+        lfo->step(blockStart, n);
+        m = { true, lfo->type == LFOType::Function ? lfo->functionInterpolate : lfoInterpolates(lfo->type), lfo->v0, lfo->v2, lfo->eventIn };
+    } else if (auto env = dynamic_cast<PDSynthEnvelope_32 *>(mod.get())) {
+        env->modStep(blockStart, n); m.present = true; m.value = env->modValue;
+    } else if (auto cs = dynamic_cast<ControlSignal_32 *>(mod.get())) {
+        cs->modStep(blockStart, n); m.present = true; m.value = cs->modValue;
+    } else if (auto ch = dynamic_cast<SoundChannelSignal_32 *>(mod.get())) {
+        m.present = true; m.value = ch->level; // a channel's level signal: the last block's level
+    }
+    return m;
+}
+
+bool SamplePlayer_32::renderFixed(int32 *left, int32 *right, uint32 T, int n) {
+    // the sample player's render, as on the device
+    if (!sample or sample->pcm.empty() or !playing) return false;
+    auto mod = stepRateModulator(rateModulator, T, n); // the modulator scales the step; an LFO's event splits the block
+    int64 modEvent = mod.present and mod.event >= 0 ? mod.event : INT64_MAX;
+    bool adpcm = sample->soundFormat == SoundFormat::MonoADPCM or sample->soundFormat == SoundFormat::StereoADPCM;
+    int ch = sample->channels;
+    int32 frames = (int32) (sample->pcm.size() / ch);
+    int done = 0, idle = 0;
+    while (done < n) {
+        int segEnd = modEvent > done ? (int) min<int64>(modEvent, n) : n;
+        if (pbStartPending) segEnd = pbStartTime > T ? (int) min<uint32>((uint32) n, pbStartTime - T) : 0;
+        int cnt = segEnd - done;
+        int rendered = 0;
+        if ((pbFadeOut or pbFadeIn or pbStarted) and cnt > 0) {
+            int32 s0 = pbStep, s1 = pbStep;
+            if (mod.present) { // the value before the event for the part before it; interpolating shapes sweep from the last value
+                float base = (float) pbStep, value = modEvent < n and done < modEvent ? mod.before : mod.value;
+                if (mod.sweep) { s0 = toInt32Sat(base * rateModValue); rateModValue = value; s1 = toInt32Sat(value * base); }
+                else s0 = s1 = toInt32Sat(value * base);
+            }
+            int64 lo = rangeLo, hi = rangeHi;
+            if (s0 < 1) { if (s0 != 0 and (uint32) posFrame >= (uint32) hi) hi = (int64) (uint32) posFrame + 1; }
+            else if ((uint32) posFrame <= (uint32) lo) lo = (int32) posFrame;
+            int64 base = 0, interpEnd = hi;
+            // ADPCM is decoded block by block into a buffer holding the frames this block needs (plus one); the
+            // interpolation test compares against that buffer's end
+            if (adpcm) { // no reverse playback
+                if (s0 < 1 or s1 < 1) { syncPlaying(); return true; }
+                base = (int32) posFrame;
+                int64 need = (int64) ((((uint64) (n - done) * (uint32) ((s0 + s1) >> 1)) + posFrac + 0xFFFF) >> 16) + 1;
+                int64 avail = min<int64>(frames - base, need);
+                interpEnd = min<int64>(hi - base, avail);
+                hi = base + interpEnd;
+            }
+            int32 aV = fixed28(min(leftVolume, 7.0f)), bV = fixed28(min(rightVolume, 7.0f));
+            int32 pos = (int32) posFrame, sd = (s1 - s0) / cnt;
+            if (pbFadeOut) {
+                rendered = fillSamplePlayer(*sample, ch, lo, hi, base, interpEnd, pos, posFrac, s0, sd, left + done, right + done, cnt, aV, 0, bV, 0);
+                pbFadeOut = false;
+            } else if (pbFadeIn) {
+                rendered = fillSamplePlayer(*sample, ch, lo, hi, base, interpEnd, pos, posFrac, s0, sd, left + done, right + done, cnt, 0, aV, 0, bV);
+                pbFadeIn = false; pbStarted = true;
+            } else
+                rendered = fillSamplePlayer(*sample, ch, lo, hi, base, interpEnd, pos, posFrac, s0, sd, left + done, right + done, cnt, aV, aV, bV, bV);
+            posFrame = (uint32) pos;
+            done += rendered;
+            if (done == n) break;
+            if (rendered > 0 and done == modEvent) continue; // the rest of the block, at the modulator's new value
+        }
+        if (pbStartPending and pbStartTime <= T + (uint32) done) {
+            pbStartPending = false; pbStarted = true; posFrac = 0;
+            if (oneShotLeft > 0 or oneShotRight > 0) { leftVolume = oneShotLeft; rightVolume = oneShotRight; pbOneShot = true; }
+            else { leftVolume = savedLeft; rightVolume = savedRight; pbOneShot = false; }
+            pbStep = pbPendStep; pbPendStep = 0;
+            rangeLo = pendRangeLo; pendRangeLo = 0;
+            rangeHi = pendRangeHi ? pendRangeHi : frames; pendRangeHi = 0;
+            repeat = pendRepeat;
+            if (pbStep == 0) pbStep = stepFor(rate);
+            int32 p = sampleOffset;
+            if (pbStep < 0) { if (p == 0) p = rangeHi - 1; }
+            else if (pbStep != 0 and p == 0) p = rangeLo;
+            posFrame = (uint32) p; sampleOffset = 0;
+            if (done < segEnd) done = segEnd;
+            continue;
+        }
+        if (!pbStarted) break;
+        // the play range's end (or start, in reverse) was reached
+        if (rendered > 0) idle = 0;
+        else if (++idle > 2) break; // the device would loop here forever (an empty range)
+        if (repeat == 1) {
+            pbStarted = false;
+            leftVolume = savedLeft; rightVolume = savedRight; pbOneShot = false;
+            syncPlaying();
+            pbFinished();
+            break;
+        }
+        if (repeat == -1) pbStep = -pbStep; // ping-pong: turn around where it stopped
+        else {
+            if (repeat > 1) repeat--;
+            posFrame = (uint32) (pbStep >= 1 ? rangeLo : rangeHi);
+        }
+        pbLooped();
+    }
+    syncPlaying();
+    position = posFrame + posFrac / 65536.0;
+    return true;
+}
+
+struct FilePlayer_32::Mp3Stream {
+    vector<uint8> data;
+    size_t pos{};
+    mp3dec_t decoder{};
+    int channels{};
+    bool done{};
+};
+
+uint32 FilePlayer_32::totalFrames() const {
+    auto decoded = (uint32) (streamPcm.size() / max(1, streamChannels));
+    // an MP3 plays every frame it decodes (the estimate is only reported); until its end is decoded it is unknown
+    if (!mp3 or mp3->done) return decoded;
+    return 0xFFFFFFFFu;
+}
+
+void FilePlayer_32::decodeTo(uint64 frames) {
+    if (!mp3) return;
+    auto &m = *mp3;
+    vector<int16> pcm(MINIMP3_MAX_SAMPLES_PER_FRAME);
+    while (!m.done and streamPcm.size() / max(1, streamChannels) < frames) {
+        mp3dec_frame_info_t info{};
+        int samples = m.pos < m.data.size() ? mp3dec_decode_frame(&m.decoder, m.data.data() + m.pos, (int) min<size_t>(m.data.size() - m.pos, INT32_MAX), pcm.data(), &info) : 0;
+        if (info.frame_bytes <= 0) { m.done = true; break; } // the end of the data
+        m.pos += (size_t) info.frame_bytes;
+        if (samples <= 0) continue; // skipped data
+        if (info.channels != m.channels) { m.done = true; break; } // a format change ends the file (as on the device)
+        streamPcm.insert(streamPcm.end(), pcm.begin(), pcm.begin() + samples * info.channels);
+    }
+}
+
+bool FilePlayer_32::loadMp3(vector<uint8> data) {
+    // an ID3v2 tag is skipped (its size is 4 x 7 bits); the data starts at the first frame,
+    // whose header gives the channels, rate and bit rate
+    size_t start = 0;
+    if (data.size() >= 10 and data[0] == 'I' and data[1] == 'D' and data[2] == '3')
+        start = 10 + ((size_t) (data[6] & 0x7F) << 21 | (size_t) (data[7] & 0x7F) << 14 | (size_t) (data[8] & 0x7F) << 7 | (data[9] & 0x7F));
+    if (start >= data.size()) return false;
+    auto m = make_shared<Mp3Stream>();
+    m->data = std::move(data);
+    m->pos = start;
+    mp3dec_init(&m->decoder);
+    vector<int16> pcm(MINIMP3_MAX_SAMPLES_PER_FRAME);
+    mp3dec_frame_info_t info{};
+    int samples = 0;
+    for (int guard = 0; guard < 64 and samples <= 0; guard++) {
+        info = {};
+        samples = mp3dec_decode_frame(&m->decoder, m->data.data() + m->pos, (int) min<size_t>(m->data.size() - m->pos, INT32_MAX), pcm.data(), &info);
+        if (info.frame_bytes <= 0) return false;
+        if (samples <= 0) { m->pos += (size_t) info.frame_bytes; continue; }
+        start = m->pos + (size_t) info.frame_offset;
+        m->pos += (size_t) info.frame_bytes;
+    }
+    if (samples <= 0 or info.hz <= 0 or info.bitrate_kbps <= 0 or info.channels < 1 or info.channels > 2) return false;
+    m->channels = info.channels;
+    streamPcm.assign(pcm.begin(), pcm.begin() + samples * info.channels);
+    streamChannels = info.channels;
+    streamRate = info.hz;
+    streamBytesPerFrame = 2 * info.channels;
+    streamIsPcm = false;
+    // the length: data bytes x 8 x rate / bit rate (exact for a constant bit rate)
+    mp3LengthFrames = (uint32) min<uint64>(((uint64) (m->data.size() - start) * 8 * (uint64) info.hz) / ((uint64) info.bitrate_kbps * 1000), 0xFFFFFFFFu);
+    mp3 = m;
+    return true;
+}
+
+uint32 FilePlayer_32::ringFrames() const {
+    int bpf = max(1, streamBytesPerFrame);
+    float secs = bufferSeconds;
+    uint32 want = !(secs > 0) ? 0u : 44100.0f * secs >= 4294967295.0f ? 0xFFFFFFFFu : (uint32) (44100.0f * secs);
+    uint64 bytes = (uint64) bpf * min<uint32>(want, 1u << 26);
+    bytes = (bytes + 3) & ~(uint64) 3; // rounded up to the 4-byte alignment
+    return max<uint32>(2, (uint32) (bytes / (uint64) bpf));
+}
+
+static uint32 fileFrames(float rate, float seconds) { // whole frames, toward zero and saturating, as on the device
+    float f = rate * seconds;
+    return !(f > 0) ? 0u : f >= 4294967295.0f ? 0xFFFFFFFFu : (uint32) f;
+}
+
+uint32 FilePlayer_32::loopStartFrame() const { return fileFrames((float) streamRate, loopStartSeconds); }
+
+uint32 FilePlayer_32::loopEndFrame() const {
+    uint32 end = fileFrames((float) streamRate, loopEndSeconds);
+    return end > loopStartFrame() ? end : 0; // an end at or before the start is the file's end
+}
+
+void FilePlayer_32::resetStream(uint32 frame) {
+    ringPos = 0; streamRead = streamPlayed = 0; jumps.clear(); readerDone = false;
+    readFrame = posFrame = min(frame, totalFrames());
+}
+
+void FilePlayer_32::fill() {
+    // the reader: reads until the ring is full (but for 4 bytes). At the end of a pass (the loop
+    // end, or the file's end on the last pass) the count goes down, the reader goes back to the loop start, and the
+    // loop callback runs; on the last pass it stops at the file's end.
+    if (!streamLoaded or !playing or paused or readerDone) return;
+    uint32 frames = totalFrames();
+    int bpf = max(1, streamBytesPerFrame);
+    auto capacity = (uint64) max<int64>(1, ((int64) ringFrames() * bpf - 4) / bpf);
+    for (int guard = 0; guard < 64; guard++) {
+        uint64 buffered = streamRead - streamPlayed;
+        uint32 loopEnd = loopEndFrame();
+        uint32 end = repeat != 1 and loopEnd ? min(loopEnd, frames) : frames;
+        if (readFrame >= end) {
+            if (repeat == 1) { if (readFrame >= frames) readerDone = true; break; }
+            if (repeat > 1) repeat--;
+            uint32 start = min(loopStartFrame(), frames);
+            readFrame = start;
+            jumps.emplace_back(streamRead, start);
+            cranked.audio.loopedSources.push_back(this);
+            if (loopCallback) {
+                cranked.nativeEngine.invokeEmulatedFunction<void, ArgType::void_t, ArgType::ptr_t, ArgType::uint32_t>(loopCallback, this, loopCallbackUserdata);
+                if (!playing) break;
+            }
+            if (start >= end) break; // an empty loop: nothing to read
+            continue;
+        }
+        if (buffered >= capacity) break;
+        uint64 k = min<uint64>(capacity - buffered, end - readFrame);
+        if (mp3) { // decoded as far as the reader goes; the data may end before the estimated length
+            decodeTo((uint64) readFrame + k);
+            uint64 decoded = streamPcm.size() / max(1, streamChannels);
+            k = decoded > readFrame ? min<uint64>(k, decoded - readFrame) : 0;
+            if (k == 0) { frames = totalFrames(); if (readFrame >= frames and repeat == 1) { readerDone = true; break; } if (!mp3->done) break; continue; }
+        }
+        readFrame += (uint32) k; streamRead += k;
+    }
+}
+
+void FilePlayer_32::advance(uint32 count) {
+    ringPos = (uint32) (((uint64) ringPos + count) % ringFrames());
+    uint64 from = streamPlayed, to = streamPlayed + count;
+    uint64 frame = posFrame;
+    while (!jumps.empty() and jumps.front().first <= to) {
+        frame = jumps.front().second; from = jumps.front().first;
+        jumps.erase(jumps.begin());
+    }
+    posFrame = (uint32) min<uint64>(frame + (to - from), 0xFFFFFFFFu);
+    streamPlayed = to;
+}
+
+void FilePlayer_32::seek(uint32 frame) {
+    // stopped, the ring is emptied; playing, the reader moves and what the ring holds
+    // still plays first
+    decodeTo(frame);
+    frame = min(frame, totalFrames());
+    if (!playing or paused) {
+        resetStream(frame);
+        headerOffset = streamIsPcm;
+    } else {
+        readFrame = frame; readerDone = false;
+        jumps.emplace_back(streamRead, frame);
+    }
+}
+
+void FilePlayer_32::leaveChannel() {
+    if (luaOwned or !explicitChannel) return;
+    for (auto &channel : cranked.audio.channels)
+        if (eraseByEquivalentKey(channel->sources, (SoundSource) this)) break;
+    explicitChannel = false;
+    cranked.audio.addOrdered(cranked.audio.mainChannel->sources, this);
+}
+
+int64 FilePlayer_32::currentOffset() const {
+    // the reader's position less what the ring holds; a position before the loop start is taken to be the end of a
+    // loop still in the ring (so before the first loop it reads loop end - loop start too far)
+    int64 offset = (int64) readFrame - (int64) (streamRead - streamPlayed);
+    if (!playing or paused) offset = (int64) posFrame + (headerOffset ? 16 / max(1, streamBytesPerFrame) : 0);
+    int64 start = loopStartFrame();
+    if (offset < start) offset = offset - start + (loopEndFrame() ? loopEndFrame() : mp3 ? mp3LengthFrames : totalFrames());
+    return offset;
+}
+
+bool FilePlayer_32::renderFixed(int32 *left, int32 *right, uint32 T, int n) {
+    // the file player's render, as on the device (see the fields in Audio.hpp)
+    if (!streamLoaded or streamPcm.empty() or paused or !playing) return false;
+    int ch = max(1, streamChannels);
+    bool simFloat = cranked.audio.simulatorFloat;
+    // the 16.16 step, converted to unsigned (saturating on the device, wrapping in the Simulator)
+    float stepF = (rate * 65536.0f * (float) streamRate) / (float) AUDIO_SAMPLING_RATE;
+    uint32 baseU = !(stepF == stepF) ? 0u : simFloat ? (uint32) (int64) max(-9.2e18f, min(stepF, 9.2e18f))
+                 : !(stepF > 0) ? 0u : stepF >= 4294967295.0f ? 0xFFFFFFFFu : (uint32) stepF;
+    float base = (float) (int32) baseU; // as on the device, the step is read back as a signed value
+    // the rate modulator scales the step: an LFO's value before its event for the part of the block before it (the
+    // block is split there), an envelope's or control signal's value for the whole block; interpolating LFO shapes
+    // sweep from the value of the last part
+    auto mod = stepRateModulator(rateModulator, T, n);
+    bool hasMod = mod.present, lerp = mod.sweep;
+    float v0 = mod.value, v2 = mod.before;
+    int event = mod.event;
+    int32 aL = fixed28(min(leftVolume, 7.0f)), aR = fixed28(min(rightVolume, 7.0f));
+    uint32 savedFrac = posFrac;
+    // the first part ends at the modulator's event (a part of 0 frames or fewer renders nothing, as on the device;
+    // the Simulator stops with SIGFPE there)
+    int count = hasMod ? max(0, min(n, event)) : n;
+    int done = 0;
+    for (int guard = 0; done < n and guard < n + 16; guard++) {
+        uint64 buffered = streamRead - streamPlayed;
+        if (buffered == 0) { // nothing in the ring: the end of the data, or an underrun
+            if (!readerDone) underran = true;
+            leftVolume = (float) aL / 268435456.0f; rightVolume = (float) aR / 268435456.0f;
+            if (readerDone or stopOnUnderrun) { // stopped: the position stays where it ended
+                playing = false; headerOffset = streamIsPcm;
+                leaveChannel();
+                cranked.audio.finishedSources.push_back(this);
+                if (completionCallback)
+                    cranked.nativeEngine.invokeEmulatedFunction<void, ArgType::void_t, ArgType::ptr_t, ArgType::uint32_t>(completionCallback, this, completionCallbackUserdata);
+            }
+            position = posFrame;
+            return true; // handled (the rest of the block is silent)
+        }
+        auto avail = (int64) min<uint64>((uint64) ringFrames() - ringPos, buffered);
+        int32 s0 = (int32) baseU, s1 = s0;
+        if (hasMod) {
+            float value = event < n and done < event ? v2 : v0;
+            if (lerp) { s0 = toInt32Sat(base * rateModValue); rateModValue = value; s1 = toInt32Sat(value * base); }
+            else s0 = s1 = toInt32Sat(value * base);
+        }
+        int32 eL = aL, eR = aR;
+        if (fadeRemaining >= 1) {
+            // the fade's part of the block ends at the target's share of the whole block (block
+            // length / samples left), computed in single precision
+            count = min(count, fadeRemaining);
+            float share = (float) n / (float) fadeRemaining;
+            eL = (int32) ((float) aL + share * (-(float) aL + min(leftFadeTarget, 7.0f) * 268435456.0f));
+            eR = (int32) ((float) aR + share * (-(float) aR + min(rightFadeTarget, 7.0f) * 268435456.0f));
+        }
+        int rendered = count;
+        uint32 consumed = 0;
+        if ((aL > 0 or aR > 0) and count > 0) { // at volume 0 nothing is read: the player does not advance
+            // the frames from the read pointer on, as the reader wrote them (through the loops and seeks in jumps)
+            auto frames = (uint64) min<size_t>(totalFrames(), streamPcm.size() / ch);
+            auto at = [&](int64 k, int c) -> int32 {
+                if (k < 0) return 0;
+                uint64 sIndex = streamPlayed + (uint64) k, f = posFrame + (uint64) k;
+                auto it = upper_bound(jumps.begin(), jumps.end(), sIndex, [](uint64 v, const pair<uint64, uint32> &j) { return v < j.first; });
+                if (it != jumps.begin()) { --it; f = it->second + (sIndex - it->first); }
+                if (f >= frames) return 0;
+                streamLazy.ensure(streamPcm, f); // decoded as it is read
+                return streamPcm[(size_t) f * ch + c];
+            };
+            int32 pos = 0;
+            rendered = fillSampleFrames(at, ch, 0, avail, 0, avail, pos, posFrac, s0, (s1 - s0) / count,
+                                        left + done, right + done, count, aL, eL, aR, eR);
+            consumed = (uint32) max(pos, 0);
+        }
+        done += rendered;
+        if (fadeRemaining >= 1 and (fadeRemaining -= rendered) <= 0) {
+            fadeRemaining = 0;
+            aL = fixed28(min(leftFadeTarget, 7.0f)); aR = fixed28(min(rightFadeTarget, 7.0f));
+            leftVolume = (float) aL / 268435456.0f; rightVolume = (float) aR / 268435456.0f;
+            if (fadeLuaCallback) { fadeLuaCallback = false; cranked.audio.fadedSources.push_back(this); }
+            if (auto callback = fadeCallback) {
+                fadeCallback = 0;
+                auto userdata = fadeCallbackUserdata; fadeCallbackUserdata = 0;
+                cranked.nativeEngine.invokeEmulatedFunction<void, ArgType::void_t, ArgType::ptr_t, ArgType::uint32_t>(callback, this, userdata);
+            }
+            if (!playing) break;
+        } else { aL = eL; aR = eR; }
+        advance(consumed);
+        count = n - done;
+    }
+    // the volume reached is the player's volume from now on (written back after each block, as on the device); the
+    // position's fraction returns to what it was before the block
+    leftVolume = (float) aL / 268435456.0f; rightVolume = (float) aR / 268435456.0f;
+    posFrac = savedFrac;
+    position = posFrame;
+    return true;
+}
+
+bool PDSynth_32::renderFixed(int32 *left, int32 *right, uint32 T, int n) {
+    if (!playing) return false;
+    auto env = envelope.get();
+    auto freqLfo = dynamic_cast<PDSynthLFO_32 *>(frequencyModulator.get());
+    auto ampLfo = dynamic_cast<PDSynthLFO_32 *>(amplitudeModulator.get());
+    // an envelope can be a modulator too (see PDSynthEnvelope_32::modStep)
+    auto freqEnv = freqLfo ? nullptr : dynamic_cast<PDSynthEnvelope_32 *>(frequencyModulator.get());
+    auto ampEnv = ampLfo ? nullptr : dynamic_cast<PDSynthEnvelope_32 *>(amplitudeModulator.get());
+    // and a control signal (stepped per block on its own position; one value per block)
+    auto freqCs = freqLfo or freqEnv ? nullptr : dynamic_cast<ControlSignal_32 *>(frequencyModulator.get());
+    auto ampCs = ampLfo or ampEnv ? nullptr : dynamic_cast<ControlSignal_32 *>(amplitudeModulator.get());
+    // and a channel's level signal (its last block's level)
+    auto freqCh = freqLfo or freqEnv or freqCs ? nullptr : dynamic_cast<SoundChannelSignal_32 *>(frequencyModulator.get());
+    auto ampCh = ampLfo or ampEnv or ampCs ? nullptr : dynamic_cast<SoundChannelSignal_32 *>(amplitudeModulator.get());
+    auto envelopeModulators = [&]() { // each envelope modulator once
+        vector<PDSynthEnvelope_32 *> mods;
+        auto add = [&](PDSynthEnvelope_32 *m) { if (m and find(mods.begin(), mods.end(), m) == mods.end()) mods.push_back(m); };
+        add(freqEnv); add(ampEnv);
+        for (int p = 1; p <= 4; p++) add(dynamic_cast<PDSynthEnvelope_32 *>(parameterModulators[p].get()));
+        return mods;
+    };
+    float A = env ? env->attack : 0, D = env ? env->decay : 0, S = env ? env->sustain : 1, R = max(env ? env->release : 0, MIN_RELEASE);
+    // a curved envelope follows the curve table; a straight one keeps the plain fractions
+    // (measured exact)
+    bool curved = env and env->curvature != 0;
+    bool simFloat = cranked.audio.simulatorFloat;
+    auto stage = [&](float t, float len, float from, float to) {
+        return curved ? env->interpolate(t, len, from, to, simFloat) : from + (to - from) * (t / len);
+    };
+    // as on the device, the values include the note's level (velocity):
+    // the attack runs from the start level to the level, the decay from the level to level x sustain. Scaling a
+    // 0-to-1 envelope by the level afterwards would round differently (off by one output step now and then).
+    auto envValue = [&](float t) -> float { // the envelope at note time t (seconds)
+        if (envRelStart != -1 and envRelStart <= t) {
+            float since = t - envRelStart;
+            if (R <= since) { envDone = true; return 0; }
+            return stage(since, R, envLast, 0);
+        }
+        float v;
+        if (A <= t) {
+            t -= A;
+            float sustainLevel = noteVolume * S;
+            v = D <= t ? sustainLevel : stage(t, D, noteVolume, sustainLevel);
+        } else
+            v = stage(t, A, envStartLevel, noteVolume);
+        envLast = v;
+        return v;
+    };
+    auto nextEvent = [&](float t, float &target) -> float { // seconds to the next breakpoint, or -1
+        if (envRelStart != -1 and !((double) t < (double) envRelStart - ENVELOPE_MARGIN)) {
+            float since = t - envRelStart;
+            if ((double) since < (double) R - ENVELOPE_MARGIN) { target = 0; return R - since; }
+            return -1;
+        }
+        if ((double) t < (double) A - ENVELOPE_MARGIN) { target = noteVolume; return A - t; }
+        float ad = A + D;
+        if ((double) t < (double) ad - ENVELOPE_MARGIN) { target = noteVolume * S; return ad - t; }
+        if (envRelStart != -1) { target = noteVolume * S; return envRelStart - t; }
+        return -1;
+    };
+    auto startNote = [&](const PendingNote &note) {
+        if (idle) genPhase = 0; // the phase restarts only when the synth was silent
+        idle = false; noteActive = true; released = false; releaseTime = -1;
+        noteFrequency = note.frequency; noteLength = note.length > 0 ? note.length : -1;
+        { // note-on and trigger both apply the velocity sensitivity s:
+          // level = f(f(velocity)) with f(x) = 1 - s + s x (in double), so 1 (the default) gives the velocity itself
+            float sens = env ? env->velocitySensitivity : 1.0f;
+            auto f = [&](float x) { return (float) ((double) (sens * x) + 1.0 - (double) sens); };
+            // legato: while the envelope runs and has not reached its
+            // release, the new note does not trigger it. Only the level changes (to f(velocity), applied once) and a
+            // set release time moves to the envelope's clock plus the new length. The envelope's clock and start level
+            // stay, but the synth's note clock restarts, so the attack is evaluated again from the old start level.
+            bool legatoNote = env and env->legato and envClock != -1 and (envRelStart == -1 or envClock < envRelStart);
+            if (legatoNote) {
+                noteVolume = sens == 1.0f ? note.velocity : f(note.velocity);
+                if (envRelStart != -1) envRelStart = envClock + (note.length > 0 ? note.length : 0);
+            } else {
+                noteVolume = sens == 1.0f ? note.velocity : f(f(note.velocity));
+                // trigger: while the envelope is still running (its clock is not
+                // stopped) and retrigger is not set, the attack starts from the value at its last block step, not from 0
+                envStartLevel = env and envClock != -1 and !env->reTrigger ? envStepValue : 0;
+                envClock = 0; envPrevClock = 0; envRelStart = noteLength;
+            }
+        }
+        noteTime = 0;
+        envDone = false;
+        // measured: a sample synth whose envelope has no release keeps its level when the note
+        // ends; only the loop stops, and the note lasts until the sample runs out
+        if (sample and (!envelope or envelope->release == 0)) envRelStart = -1;
+        // the modulators' note start (the phase continues unless retrigger)
+        if (sample and sample->fromData) sample->decodeFromData(); // the game may have rewritten the data
+        if (wavetable) { if (wavetable->fromData) wavetable->decodeFromData(); wtXCur = wtYCur = 0xFFFFFFFF; } // reset at note-on
+        // TE generators at note-on: both parameters return to 0x80 (so a value set before the note is lost
+        // unless a modulator sets it again) and the phases restart; the digital synth keeps its third phase and feedback
+        if (waveform == SoundWaveform::POPhase or waveform == SoundWaveform::PODigital or waveform == SoundWaveform::POVosim) {
+            teParam[0] = teParam[1] = 0x80;
+            tePhase[0] = tePhase[1] = 0;
+            if (waveform == SoundWaveform::POPhase) teLatch[0] = teLatch[1] = 0x80;
+            if (waveform == SoundWaveform::POVosim) tePhase[2] = 0;
+        }
+        if (sample) { samplePos = 0; sampleFrac = 0; sampleLooping = sampleSustainEnd != 0; sampleSilent = false; } // sample note-on
+        if (freqLfo) freqLfo->noteStarted();
+        if (ampLfo and ampLfo != freqLfo) ampLfo->noteStarted();
+        for (int p = 1; p <= 4; p++) // parameter modulators get the note start too
+            if (auto lfo = dynamic_cast<PDSynthLFO_32 *>(parameterModulators[p].get()); lfo and lfo != freqLfo and lfo != ampLfo) lfo->noteStarted();
+        // envelopes as modulators get the note-on (velocity and length) too
+        for (auto mod : envelopeModulators()) mod->modNoteOn(note.velocity, note.length > 0 ? note.length : -1);
+    };
+    auto release = [&]() {
+        if (released) return;
+        released = true; releaseTime = noteTime;
+        sampleLooping = false; // the rest of the sample plays out
+        if (sample and (!envelope or envelope->release == 0)) return; // see startNote: no release for samples
+        if (envRelStart == -1) envRelStart = (float) noteTime / SYNTH_RATE;
+    };
+    // the envelope's note-off, where the note's length ends (offset: samples into the block; at
+    // a block's start when the end has already passed): it triggers the
+    // envelope again with velocity 0. The level is then 1 - s, so with a velocity sensitivity s below 1 the envelope
+    // restarts (from its current value, unless retrigger is set) toward 1 - s, with its release time moved to the
+    // note-off. Its own clock restarts, while the note's clock goes on, so the release in progress takes its starting
+    // value from the restarted attack and decay at each block.
+    auto envelopeNoteOff = [&](int offset) {
+        // the note-off runs once per playNote call: a note that started after an earlier note's note-off, with no
+        // playNote in between (both queued at once), gets none of its own and simply releases at its length
+        if (envNoteOff or !env) return;
+        envNoteOff = true;
+        for (auto mod : envelopeModulators()) mod->modNoteOff(offset); // the modulators' note-off
+        float sens = env->velocitySensitivity;
+        float level = (float) ((double) (sens * 0.0f) + 1.0 - (double) sens);
+        if (!(level > 0)) return; // a plain release (see release())
+        if (sample and envelope->release == 0) return; // see startNote: no release for samples
+        float rel = (float) offset / SYNTH_RATE + envPrevClock; // the release time, on the envelope's clock at the block's start
+        envStartLevel = envClock != -1 and !env->reTrigger ? envStepValue : 0;
+        noteVolume = level;
+        envClock = 0; envPrevClock = 0; envDone = false; envRelStart = rel;
+    };
+    auto renderSegment = [&](int32 *outL, int32 *outR, int count, int32 a0, int32 a1, int32 b0, int32 b1, int offset, int n) {
+        // the phase step sweeps linearly over the segment between the frequency modulator's values at its ends (octaves)
+        // measured: sample generators are not capped at 2756 Hz for an SDK 3.1.1 game
+        // (3500 Hz plays at full speed)
+        float noteF = noteFrequency;
