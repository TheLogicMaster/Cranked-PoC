+    Cranked *cranked;
+    json_decoder_32 *work; // emulated working copy handed to callbacks
+    std::deque<vheap_vector<char>> strings;
+    cref_t string(const char *text) {
+        if (!text) return 0;
+        if (strings.size() >= 64) strings.pop_front(); // strings only need to outlive the callbacks around them
+        size_t len = strlen(text);
