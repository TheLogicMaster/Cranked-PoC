+// IEEE half precision from a double, with the rounding mode (0 nearest even, 1 +inf, 2 -inf, 3 zero)
+u16 halfFromDouble(double x, int mode, bool &isNaN) {
+    u64 b = bits64(x);
+    u16 sign = (u16) ((b >> 48) & 0x8000);
+    isNaN = std::isnan(x);
+    if (isNaN) return (u16) (sign | 0x7E00 | ((b >> 42) & 0x1FF));
+    if (std::isinf(x)) return (u16) (sign | 0x7C00);
+    double a = std::fabs(x);
+    if (a == 0) return sign;
+    int e; std::frexp(a, &e); // a = m * 2^e, m in [0.5, 1)
+    int exponent = e - 1;                // a = (2m) * 2^exponent
+    double scaled;
+    int halfExp;
+    if (exponent < -14) { scaled = std::ldexp(a, 24); halfExp = 0; }       // subnormal: units of 2^-24
+    else { scaled = std::ldexp(a, 10 - exponent); halfExp = exponent + 15; } // 1.xxxx with 10 fraction bits
+    double r;
+    switch (mode) {
+        case 0: r = std::nearbyint(scaled); break;
+        case 1: r = sign ? std::floor(scaled) : std::ceil(scaled); break;
+        case 2: r = sign ? std::ceil(scaled) : std::floor(scaled); break;
+        default: r = std::trunc(scaled); break;
+    }
+    u32 mant = (u32) r;
+    if (halfExp == 0) { // subnormal (may round up to the smallest normal)
+        return (u16) (sign | mant);
+    }
+    if (mant >= 2048) { mant >>= 1; halfExp++; }
+    if (halfExp >= 31) { // overflow: infinity, or the largest finite value when rounding toward zero or away from it
