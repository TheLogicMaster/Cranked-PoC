+    };
+
+    int off = 0, firstEnd = n, lengthLeft = -1;
+    bool any = false, stepped = false, lengthChecked = false, first = true;
+    while (off < n) {
+        int stop = n; // a pending note that is due takes over from its start
+        if (pendingNotes.size() > 1 and pendingNotes[1].start <= T + off) // B, once due, replaces a waiting A
