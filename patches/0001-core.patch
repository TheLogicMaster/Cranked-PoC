+// FPToFixed with 0 fraction bits: rounded in `mode`, saturated; NaN gives 0
+u32 toInt(double x, int mode, bool isUnsigned) {
+    if (std::isnan(x)) return 0;
+    double r = roundIntegral(x, mode);
+    if (isUnsigned) { if (r <= 0) return 0; if (r >= 4294967295.0) return 0xFFFFFFFFu; return (u32) r; }
+    if (r >= 2147483647.0) return 0x7FFFFFFF;
+    if (r <= -2147483648.0) return 0x80000000u;
+    return (u32) (s32) r;
