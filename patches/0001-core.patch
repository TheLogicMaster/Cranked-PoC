+        case 0x4: case 0x5: { // VCMP, VCMPE (with zero for opc2 5)
+            u32 flags;
+            if (dbl) flags = fp.cmp64(getD(st, d), opc2 == 5 ? 0 : getD(st, m));
+            else flags = fp.cmp32(st.s[d], opc2 == 5 ? 0 : st.s[m]);
+            st.fpscr = (st.fpscr & 0x0FFFFFFF) | flags << 28;
+            return;
+        }
+        case 0x6: { // VRINTR (op 0), VRINTZ (op 1)
+            int mode = op ? 3 : fp.rmode();
+            if (dbl) { u64 x = fp.in64(getD(st, m)); setD(st, d, isNaN64(x) ? fp.quiet64(x) : fp.out64(bits64(roundIntegral(f64(x), mode)))); }
+            else { u32 x = fp.in32(st.s[m]); st.s[d] = isNaN32(x) ? fp.quiet32(x) : fp.out32(bits32((float) roundIntegral(f32(x), mode))); }
+            return;
+        }
+        case 0x7: // VRINTX (op 0), VCVT between double and single (op 1)
+            if (!op) {
+                int mode = fp.rmode();
+                if (dbl) { u64 x = fp.in64(getD(st, m)); setD(st, d, isNaN64(x) ? fp.quiet64(x) : fp.out64(bits64(roundIntegral(f64(x), mode)))); }
+                else { u32 x = fp.in32(st.s[m]); st.s[d] = isNaN32(x) ? fp.quiet32(x) : fp.out32(bits32((float) roundIntegral(f32(x), mode))); }
+                return;
+            }
+            if (dbl) { // double to single: Sd = Vd:D, Dm
+                u64 x = fp.in64(getD(st, m));
+                int sd = (int) (vd << 1 | D);
+                u32 r;
+                if (isNaN64(x)) r = fp.dn() ? DEFAULT_NAN32 : (u32) (x >> 32 & 0x80000000) | 0x7FC00000 | (u32) ((x >> 29) & 0x3FFFFF);
+                else r = fp.out32(bits32(fp.rounded([&] { return (float) f64(x); })));
+                st.s[sd] = r;
+            } else { // single to double: Dd = D:Vd, Sm
+                u32 x = fp.in32(st.s[(int) (vm << 1 | M)]);
+                int dd = (int) (D << 4 | vd);
+                u64 r;
+                if (isNaN32(x)) r = fp.dn() ? DEFAULT_NAN64 : (u64) (x & 0x80000000) << 32 | 0x7FF8000000000000ull | (u64) (x & 0x3FFFFF) << 29;
+                else r = bits64((double) f32(x));
+                setD(st, dd, r);
+            }
+            return;
+        case 0x8: { // VCVT integer to float (op 1 signed); the source is always a single register Sm
+            u32 x = st.s[(int) (vm << 1 | M)];
+            if (dbl) setD(st, d, bits64(op ? (double) (s32) x : (double) x)); // exact
+            else st.s[d] = fp.out32(bits32(fp.rounded([&] { return op ? (float) (s32) x : (float) x; })));
+            return;
+        }
+        case 0xA: case 0xB: case 0xE: case 0xF: { // VCVT between float and fixed point (in place in Vd)
+            bool toFixed = opc2 & 4, isUnsigned = opc2 & 1, sx = (hw2 >> 7) & 1;
+            u32 size = sx ? 32 : 16;
+            u32 imm5 = (hw2 & 15) << 1 | ((hw2 >> 5) & 1);
+            int fracBits = (int) size - (int) imm5;
+            if (fracBits < 0) undefined();
+            if (toFixed) {
+                double v; bool nan;
+                if (dbl) { u64 x = fp.in64(getD(st, d)); nan = isNaN64(x); v = f64(x); } else { u32 x = fp.in32(st.s[d]); nan = isNaN32(x); v = f32(x); }
+                double scaled = nan ? 0 : std::ldexp(v, fracBits);
+                u32 r;
+                if (size == 32) r = toInt(nan ? std::numeric_limits<double>::quiet_NaN() : scaled, 3, isUnsigned);
+                else {
+                    double t = nan ? 0 : std::trunc(scaled);
+                    if (isUnsigned) r = t <= 0 ? 0 : t >= 65535 ? 0xFFFF : (u32) t;
+                    else r = (u32) (t >= 32767 ? 32767 : t <= -32768 ? -32768 : (s32) t) & 0xFFFF;
+                    if (!isUnsigned and (r & 0x8000)) r |= 0xFFFF0000; // sign-extended into the register
+                }
+                if (dbl) setD(st, d, isUnsigned or size == 16 ? (u64) r : (u64) (s64) (s32) r); else st.s[d] = r;
+                if (dbl and size == 16 and !isUnsigned) setD(st, d, (u64) (s64) (s32) r);
+            } else {
+                u64 raw = dbl ? getD(st, d) : st.s[d];
+                s64 value;
+                if (size == 16) value = isUnsigned ? (s64) (raw & 0xFFFF) : (s64) (s16) (raw & 0xFFFF);
+                else value = isUnsigned ? (s64) (u32) raw : (s64) (s32) (u32) raw;
+                if (dbl) setD(st, d, fp.out64(bits64(fp.rounded([&] { return std::ldexp((double) value, -fracBits); }))));
+                else st.s[d] = fp.out32(bits32(fp.rounded([&] { return (float) std::ldexp((double) value, -fracBits); })));
+            }
+            return;
+        }
+        case 0xC: case 0xD: { // VCVT, VCVTR float to integer (opc2 0xC unsigned, 0xD signed); the result is Sd
+            bool isSigned = opc2 & 1;
+            int mode = op ? 3 : fp.rmode();
+            double v;
+            if (dbl) v = f64(fp.in64(getD(st, m))); else v = f32(fp.in32(st.s[m]));
+            st.s[(int) (vd << 1 | D)] = toInt(v, mode, !isSigned);
+            return;
+        }
+        default: undefined();
+    }
+}
+
+void Interpreter::vfpUnconditional(u16 hw1, u16 hw2) {
+    Fp fp{ st.fpscr };
+    bool dbl = (hw2 >> 8) & 1;
+    u32 D = (hw1 >> 6) & 1, N = (hw2 >> 7) & 1, M = (hw2 >> 5) & 1;
+    u32 vd = (hw2 >> 12) & 15, vn = hw1 & 15, vm = hw2 & 15;
+    int d = dbl ? (int) (D << 4 | vd) : (int) (vd << 1 | D);
+    int n = dbl ? (int) (N << 4 | vn) : (int) (vn << 1 | N);
+    int m = dbl ? (int) (M << 4 | vm) : (int) (vm << 1 | M);
+    if ((hw1 & 0xFF80) == 0xFE00 and !(hw2 & 0x50)) { // VSEL
+        u32 cc = (hw1 >> 4) & 3;
+        bool cond = cc == 0 ? st.z : cc == 1 ? st.v : cc == 2 ? st.n == st.v : (!st.z and st.n == st.v);
+        if (dbl) setD(st, d, cond ? getD(st, n) : getD(st, m)); else st.s[d] = cond ? st.s[n] : st.s[m];
+        return;
+    }
+    if ((hw1 & 0xFFB0) == 0xFE80 and !(hw2 & 0x10)) { // VMAXNM, VMINNM
+        bool min = (hw2 >> 6) & 1;
+        if (dbl) setD(st, d, fp.maxmin64(getD(st, n), getD(st, m), !min)); else st.s[d] = fp.maxmin32(st.s[n], st.s[m], !min);
+        return;
+    }
+    if ((hw1 & 0xFFBC) == 0xFEB8 and (hw2 & 0xC0) == 0x40) { // VRINTA, VRINTN, VRINTP, VRINTM
+        static const int modes[4] = { 4, 0, 1, 2 };
+        int mode = modes[hw1 & 3];
+        if (dbl) { u64 x = fp.in64(getD(st, m)); setD(st, d, isNaN64(x) ? fp.quiet64(x) : fp.out64(bits64(roundIntegral(f64(x), mode)))); }
+        else { u32 x = fp.in32(st.s[m]); st.s[d] = isNaN32(x) ? fp.quiet32(x) : fp.out32(bits32((float) roundIntegral(f32(x), mode))); }
+        return;
+    }
+    if ((hw1 & 0xFFBC) == 0xFEBC and (hw2 & 0x40)) { // VCVTA, VCVTN, VCVTP, VCVTM (to integer; the result is Sd)
+        static const int modes[4] = { 4, 0, 1, 2 };
+        int mode = modes[hw1 & 3];
+        bool isSigned = (hw2 >> 7) & 1;
+        double v = dbl ? f64(fp.in64(getD(st, m))) : f32(fp.in32(st.s[m]));
+        st.s[(int) (vd << 1 | D)] = toInt(v, mode, !isSigned);
+        return;
+    }
+    undefined();
+}
+
+} // namespace armi
diff --git a/core/ArmInterpreter.hpp b/core/ArmInterpreter.hpp
new file mode 100644
index 0000000..0e71cc7
--- /dev/null
+++ b/core/ArmInterpreter.hpp
@@ -0,0 +1,153 @@
+// An interpreter for the Cortex-M7's instruction set as games use it (Thumb-2 with the DSP extension and
+// FPv5 floating point, single and double precision), for hosts where Unicorn's JIT cannot run (WebAssembly, iOS).
+// It keeps the parts of Unicorn's behaviour Cranked relies on: emulation runs from a start address until the PC
+// reaches an end address, a step count runs, or a stop is requested; a fetch, read or write outside the mapped
+// regions stops it with Unicorn's error codes (after the matching hooks); BKPT, SVC and undefined instructions
+// raise interrupts 7, 2 and 1 through the interrupt hook.
+//
+// Floating point follows the ARM rules for NaNs (the first signalling NaN operand, quietened, else the first quiet
+// one; the default NaN for invalid operations and in default-NaN mode), flush-to-zero and the rounding modes, around
+// the host's IEEE arithmetic, so results are bit-exact; the cumulative exception flags in FPSCR are not kept.
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <functional>
+#include <vector>
+
+#if defined(__GNUC__) || defined(__clang__)
+#define ARMI_ALWAYS_INLINE [[gnu::always_inline]] inline
+#elif defined(_MSC_VER)
+#define ARMI_ALWAYS_INLINE __forceinline
+#else
+#define ARMI_ALWAYS_INLINE inline
+#endif
+#if defined(__GNUC__) || defined(__clang__)
+#define ARMI_NOINLINE [[gnu::noinline]]
+#elif defined(_MSC_VER)
+#define ARMI_NOINLINE __declspec(noinline)
+#else
+#define ARMI_NOINLINE
+#endif
+
+namespace armi {
+
+    using u8 = uint8_t; using u16 = uint16_t; using u32 = uint32_t; using u64 = uint64_t;
+    using s8 = int8_t; using s16 = int16_t; using s32 = int32_t; using s64 = int64_t;
+
+    enum Prot : u32 { ProtRead = 1, ProtWrite = 2, ProtExec = 4 };
+
+    enum class Result {
+        Ok,               // reached the end address, ran the step count or a stop was requested
+        FetchUnmapped, ReadUnmapped, WriteUnmapped,
+        FetchProt, ReadProt, WriteProt,
+        Exception,        // an interrupt the hook returned from (the PC is after the instruction)
+    };
+
+    struct Region { u32 base, size, prot; u8 *host; };
+
+    // The CPU state, as a context saves it
+    struct State {
+        u32 r[16]{};          // r[15] is the PC (the address of the next instruction to run, without the Thumb bit)
+        u32 n{}, z{}, c{}, v{}, q{}; // flags, 0 or 1
+        u32 ge{};             // GE[3:0]
+        u32 it{};             // ITSTATE
+        u32 ipsr{};
+        u32 fpscr{};
+        u32 primask{}, basepri{}, faultmask{}, control{}, msp{}, psp{};
+        u32 fpexc = 0x40000000;
+        u32 exclusive{}; bool exclusiveSet{}; // the local exclusive monitor (LDREX opens it, STREX and CLREX close it)
+        alignas(8) u32 s[64]{}; // S0-S63: D0-D31 as pairs (Dn = S[2n], S[2n+1], little-endian)
+        u32 xpsr() const;
+        void setXpsr(u32 value, u32 mask = 0xFFFFFFFF);
+    };
+
+    class Interpreter {
+    public:
+        Interpreter();
+
+        State st;
+
+        // memory
+        bool map(u32 base, u32 size, u32 prot, u8 *host); // false if it overlaps a region
+        bool unmap(u32 base, u32 size);
+        bool read(u32 address, void *out, size_t size);   // host access (no hooks, no protection)
+        bool write(u32 address, const void *in, size_t size);
+
+        // hooks, as Unicorn calls them; return values are as Unicorn's (true from an unmapped hook would mean
+        // "mapped now, retry", which Cranked never does, so it is treated as false)
+        std::function<void(u32 intno)> onInterrupt;
+        std::function<void(int type, u32 address, int size, s64 value)> onUnmapped; // type: Unicorn's uc_mem_type
+        std::function<void(u32 address, u32 size)> onCode; // before each instruction (slow; for counting)
+
+        // runs from `begin` (the Thumb bit ignored) until the PC is `until`, `count` instructions have run (0: no
+        // limit), stop() is called or `budget` instructions have run (0: no limit; a front end without threads uses it
+        // in place of a watchdog)
+        Result run(u32 begin, u32 until, u64 count, u64 budget = 0);
+        void stop() { stopRequested = true; }
+        u32 faultAddress() const { return lastFaultAddress; }
+        u64 executed() const { return totalExecuted; }
+
+    private:
+        static constexpr int PAGE_BITS = 16;
+        std::vector<Region> regions;
+        std::vector<int> pages; // region index + 1 for each 64 KB page, 0 if unmapped
+        // the fast path: for each page with one region, its host address minus the page's guest address, the valid
+        // offsets [lo, hi) and the protection; accesses outside it take the slow path (translate)
+        struct FastPage { uintptr_t delta{}; u32 lo{}, hi{}, prot{}; };
+        std::vector<FastPage> fast;
+        void rebuildFast();
+        u8 *fastPointer(u32 a, u32 size, u32 need) const {
+            const FastPage &f = fast[a >> PAGE_BITS];
+            u32 off = a & ((1u << PAGE_BITS) - 1);
+            if (off >= f.lo and off + size <= f.hi and (f.prot & need) == need) return (u8 *) (f.delta + a);
+            return nullptr;
+        }
+        std::atomic<bool> stopRequested{ false };
+        u32 lastFaultAddress{};
+        u64 totalExecuted{};
+
+        struct Fault { Result result; };
+
+        // memory access for instructions; a fault throws Fault after calling the hook
+        // the accessors are inlined (their fast path is a table lookup and a range check); translate, the slow
+        // path, is not
+        ARMI_NOINLINE u8 *translate(u32 address, u32 size, u32 need, Result unmapped, Result prot, int hookType, s64 value);
+        ARMI_ALWAYS_INLINE u32 load8(u32 a); ARMI_ALWAYS_INLINE u32 load16(u32 a); ARMI_ALWAYS_INLINE u32 load32(u32 a); u64 load64(u32 a);
+        ARMI_ALWAYS_INLINE void store8(u32 a, u32 v); ARMI_ALWAYS_INLINE void store16(u32 a, u32 v); ARMI_ALWAYS_INLINE void store32(u32 a, u32 v); void store64(u32 a, u64 v);
+        u16 fetch16(u32 a);
+
+        // execution
+        u32 pc{}, nextPc{};
+        ARMI_ALWAYS_INLINE bool conditionPassed(u32 cond) const;
+        void branchWritePC(u32 address) { nextPc = address & ~1u; }
+        void bxWritePC(u32 address) { nextPc = address & ~1u; } // interworking (an ARM-state target is not checked)
+        void loadWritePC(u32 address) { bxWritePC(address); }
+        u32 reg(int n) const { return n == 15 ? pc + 4 : st.r[n]; }
+        void setReg(int n, u32 value) { if (n == 15) bxWritePC(value); else st.r[n] = value; }
+        ARMI_ALWAYS_INLINE void step16(u16 hw); // inlined into the run loop (saves the call's register saves)
+        void step32(u16 hw1, u16 hw2);
+        void dataProcessingModifiedImmediate(u16 hw1, u16 hw2);
+        void dataProcessingPlainImmediate(u16 hw1, u16 hw2);
+        void dataProcessingShiftedRegister(u16 hw1, u16 hw2);
+        void dataProcessingRegister(u16 hw1, u16 hw2);
+        void branchesAndMisc(u16 hw1, u16 hw2);
+        void loadStoreMultiple(u16 hw1, u16 hw2);
+        void loadStoreDualExclusiveTable(u16 hw1, u16 hw2);
+        void loadStoreSingle(u16 hw1, u16 hw2);
+        void multiply(u16 hw1, u16 hw2);
+        void longMultiplyDivide(u16 hw1, u16 hw2);
+        void parallelAddSub(u16 hw1, u16 hw2);
+        void miscOperations(u16 hw1, u16 hw2);
+        void coprocessor(u16 hw1, u16 hw2);
+        void vfpDataProcessing(u16 hw1, u16 hw2);
+        void vfpTransfer(u16 hw1, u16 hw2);
+        void vfpLoadStore(u16 hw1, u16 hw2);
+        void vfpUnconditional(u16 hw1, u16 hw2); // FPv5: VSEL, VMAXNM, VMINNM, VCVTA/N/P/M, VRINTA/N/P/M
+        [[noreturn]] void undefined();
+        void interrupt(u32 intno);
+    };
+
+}
