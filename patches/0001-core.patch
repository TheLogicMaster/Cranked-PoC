+// The mixer: sources are mixed per channel, custom effects see each channel's mix as
+// 8.24 fixed point (as on the device), then channels are summed into interleaved stereo 16-bit output at 44.1 kHz.
+void Audio::updateFilePlayers() {
+    vector<FilePlayer_32 *> players;
+    vector<SoundChannel> all{ mainChannel.get() };
+    for (auto &channel : channels) all.push_back(channel.get());
+    for (auto channel : all)
+        if (channel) for (auto &source : channel->sources)
+            if (auto player = dynamic_cast<FilePlayer_32 *>(source.get()); player and player->playing and !player->paused) players.push_back(player);
+    for (auto player : players) player->fill();
+}
