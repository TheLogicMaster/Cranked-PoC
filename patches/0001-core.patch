@@ -0,0 +1,140 @@
+// Playdate-compatible JSON decoder: the C callback API (json->decode and
+// json->decodeString) and a model of the Lua binding (json.decode and
+// json.decodeFile) built on it. (Cranked APIs: data/json)
+//
+// Behaviour summary (see JsonDecoder.cpp for details):
+//  * Input is streamed through a reader callback; one byte of pushback.
+//  * Line numbers start at 1 and advance only on '\n' seen between tokens.
+//  * Integers wrap in 32 bits, fractions keep 9 digits, single precision floats;
+//    exponents are applied as measured in the Simulator (see readNumber).
+//  * json.decodeFile on a file shorter than 3 bytes fails with "empty file".
+//  * \u escapes below 0x100 give one byte, others 2- or 3-byte UTF-8.
+//  * Callbacks receive a working copy of the caller's callbacks; changes made by
+//    a callback last until the sublist being decoded finishes.
+#pragma once
+
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <string>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+namespace jsondecoder {
+
+enum ValueType {
+    kJSONNull = 0,
+    kJSONTrue = 1,
+    kJSONFalse = 2,
+    kJSONInteger = 3,
+    kJSONFloat = 4,
+    kJSONString = 5,
+    kJSONArray = 6,
+    kJSONTable = 7,
+};
+
+struct Value {
+    int type = kJSONNull;
+    int intval = 0;
+    float floatval = 0.0f;
+    std::string stringval;   // bytes before the first NUL
+    void *ptr = nullptr;     // arrays/tables: didDecodeSublist's result
+};
+
+struct Decoder;
+
+using DecodeErrorFn = std::function<void(Decoder &, const char *error, int linenum)>;
+using WillDecodeSublistFn = std::function<void(Decoder &, const char *name, int type)>;
+using ShouldDecodeTableValueForKeyFn = std::function<int(Decoder &, const char *key)>;
+using DidDecodeTableValueFn = std::function<void(Decoder &, const char *key, const Value &value)>;
+using ShouldDecodeArrayValueAtIndexFn = std::function<int(Decoder &, int pos)>;
+using DidDecodeArrayValueFn = std::function<void(Decoder &, int pos, const Value &value)>;
+using DidDecodeSublistFn = std::function<void *(Decoder &, const char *name, int type)>;
+
+struct Callbacks {
+    DecodeErrorFn decodeError;
+    WillDecodeSublistFn willDecodeSublist;
+    ShouldDecodeTableValueForKeyFn shouldDecodeTableValueForKey;
+    DidDecodeTableValueFn didDecodeTableValue;
+    ShouldDecodeArrayValueAtIndexFn shouldDecodeArrayValueAtIndex;
+    DidDecodeArrayValueFn didDecodeArrayValue;
+    DidDecodeSublistFn didDecodeSublist;
+    void *userdata = nullptr;
+    int returnString = 0;
+};
+
+struct DecoderHeader {
+    Callbacks cb;
+    const char *path = nullptr;
+    const char *errorMsg = nullptr;
+};
+
+struct DecoderImpl;
+
+struct Decoder {
+    DecoderHeader hdr;
+    void setError(const char *msg) { hdr.errorMsg = msg; }
+    int line() const;
+    const char *path() const { return hdr.path; }
+    DecoderImpl *impl = nullptr;
+};
+
+using ReadFn = std::function<int(uint8_t *buf, int bufsize)>;
+
+struct DecodeStatus {
+    bool hang = false;
+    bool simulatedAllocFailure = false;
+};
+
+int decode(const Callbacks &callbacks, const ReadFn &reader, Value *out, DecodeStatus *status = nullptr);
+int decodeString(const Callbacks &callbacks, const char *json, Value *out, DecodeStatus *status = nullptr);
+int decodeString(const Callbacks &callbacks, const std::string &json, Value *out, DecodeStatus *status = nullptr);
+
+struct LuaTable;
+
+struct LuaValue {
+    enum Kind { Nil, Bool, Int, Float, String, Table };
+    Kind kind = Nil;
+    bool b = false;
+    int32_t i = 0;
+    float f = 0.0f;
+    std::string s;
+    std::shared_ptr<LuaTable> t;
+
+    static LuaValue nil() { return {}; }
+    static LuaValue boolean(bool v) { LuaValue r; r.kind = Bool; r.b = v; return r; }
+    static LuaValue integer(int32_t v) { LuaValue r; r.kind = Int; r.i = v; return r; }
+    static LuaValue number(float v) { LuaValue r; r.kind = Float; r.f = v; return r; }
+    static LuaValue string(std::string v) { LuaValue r; r.kind = String; r.s = std::move(v); return r; }
+    static LuaValue newTable();
+    bool isNil() const { return kind == Nil; }
+};
+
+struct LuaTable {
+    std::vector<std::pair<LuaValue, LuaValue>> entries;
+    LuaValue get(const LuaValue &key) const;
+    void set(const LuaValue &key, const LuaValue &value);
+    bool next(const LuaValue &key, LuaValue &nextKey, LuaValue &nextValue) const;
+
+  private:
+    std::unordered_map<std::string, size_t> index_;
+    long find(const LuaValue &key) const;
+    void reindex();
+};
+
+struct LuaDecodeResult {
+    enum Status { Ok, Failed, LuaError, Undefined };
+    Status status = Ok;
+    LuaValue value;
+    LuaValue message;
+    std::string luaError;
+};
+
+LuaDecodeResult luaDecode(const std::string &str);
+LuaDecodeResult luaDecodeFile(const std::string &fileBytes);
+
+std::string describe(const Value &v);
+std::string describe(const LuaValue &v);
+
+}  // namespace jsondecoder
