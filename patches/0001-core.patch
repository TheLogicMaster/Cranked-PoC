+            case jsondecoder::kJSONFloat: out.data.floatval = v.floatval; break;
+            case jsondecoder::kJSONString: out.data.stringval = string(v.stringval.c_str()); break;
+            case jsondecoder::kJSONArray: case jsondecoder::kJSONTable: out.data.tableval = (cref_t) (uintptr_t) v.ptr; break;
+            default: break;
