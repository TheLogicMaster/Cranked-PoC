+                case 8: value = st.fpexc; break;
+                case 7: value = 0x10110221; break; // MVFR0 (single and double, divide, square root)
+                case 6: value = 0x12000011; break; // MVFR1
+                case 5: value = 0x00000040; break; // MVFR2 (FPv5)
