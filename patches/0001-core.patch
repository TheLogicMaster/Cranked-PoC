+// measured: the stencil pattern arguments are a table of eight rows, eight
+// row numbers, or a level with an optional dither type (Bayer 4x4 when left out; an explicit nil or a string is an
+// error). A level uses the dither type's own thresholds, as drawFaded does, with the level rounded to 1/255. The error
+// diffusion types (Floyd-Steinberg, Burkes, Atkinson) give the same fixed pattern at every level: two pixels of the
+// first row.
+static array<uint8, 8> stencilRows(Cranked *cranked, LuaVal arg1) {
+    auto L = cranked->getLuaContext();
+    int first = arg1.index, top = lua_gettop(L);
+    array<uint8, 8> rows{};
+    if (arg1.isTable()) {
+        for (int row = 0; row < 8; row++) rows[row] = (uint8) arg1.getIntElement(row + 1);
+        return rows;
+    }
+    bool eight = top - first + 1 >= 8;
+    for (int i = 0; eight and i < 8; i++) eight = lua_type(L, first + i) == LUA_TNUMBER;
+    if (eight) {
+        for (int row = 0; row < 8; row++) rows[row] = (uint8) LuaVal(L, first + row).asInt();
+        return rows;
+    }
+    if (lua_type(L, first) != LUA_TNUMBER or (top > first and lua_type(L, first + 1) != LUA_TNUMBER))
+        luaL_error(L, "arguments to setStencilPattern() should be a table or list of pixel values or an alpha level with optional dither type");
+    float level = (float) lua_tonumber(L, first);
+    int type = top > first ? (int) lua_tointeger(L, first + 1) : (int) DitherType::Bayer4x4;
+    if (type >= (int) DitherType::FloydSteinberg) { rows[0] = 0x60; return rows; }
+    for (int row = 0; row < 8; row++)
+        for (int col = 0; col < 8; col++)
+            if (Graphics::stencilPatternCell((DitherType) type, col, row, level)) rows[row] |= 0x80 >> col;
+    return rows;
+}
