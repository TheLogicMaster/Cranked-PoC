+
+bool ChannelSource_32::renderFixed(int32 *left, int32 *right, uint32 blockStart, int length) {
+    // nothing until its channel has produced a block, then a copy of that block
+    // (it replaces what the channel's earlier sources mixed, as on the device)
+    if (!hasData) return true;
+    length = min(length, 256);
+    memcpy(left, bufferL, length * 4);
+    if (right) memcpy(right, stereoData ? bufferR : bufferL, length * 4);
+    return true;
+}
+
+void ChannelSource_32::copy(const int32 *left, const int32 *right, int length, bool active) {
+    // the left side is copied for every block, both sides (and the stereo flag) only for a
+    // block in which the channel was active
+    length = min(length, 256);
+    stereoFlag = right != nullptr;
+    memcpy(bufferL, left, length * 4);
+    if (!active) return;
+    if (right) memcpy(bufferR, right, length * 4);
+    hasData = true;
+    stereoData = right != nullptr;
+}
