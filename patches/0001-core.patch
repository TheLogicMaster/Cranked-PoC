diff --git a/core/ArgValidation.cpp b/core/ArgValidation.cpp
new file mode 100644
index 0000000..5f281c3
--- /dev/null
+++ b/core/ArgValidation.cpp
@@ -0,0 +1,84 @@
+// Checks of the object arguments a native game passes to the C API, before the call.
+//
+// The device checks most object arguments for NULL itself (a NULL object makes the call do nothing), and does not
+// check anything else: a dangling or wrong pointer is undefined behavior on the device. In the emulator such a pointer
+// would make host code read emulated memory as a host object, so it must not reach the implementation.
+//
+// - A NULL first argument (the object the call is about) skips the call; it returns 0. A few functions take NULL
+//   there on purpose and are listed below.
+// - Any non-NULL object argument must be a live object of the parameter's class, or the game stops with an error
+//   naming the function, like a fault on the device.
+#include "Cranked.hpp"
+#include "gen/PlaydateAPI.hpp"
+
+using namespace cranked;
+
+namespace {
+    template<typename T, typename = void> struct IsComplete : std::false_type {};
+    template<typename T> struct IsComplete<T, std::void_t<decltype(sizeof(T))>> : std::true_type {};
+
+    template<typename T>
+    constexpr bool isResourcePointerImpl() { // opaque types (only declared) are not checked
+        if constexpr (!is_pointer_v<T>) return false;
+        else {
+            using U = std::remove_cv_t<remove_pointer_t<T>>;
+            if constexpr (!std::is_class_v<U> or !IsComplete<U>::value) return false;
+            else return is_base_of_v<NativeResource, U>;
+        }
+    }
+    template<typename T>
+    constexpr bool isResourcePointer = isResourcePointerImpl<T>();
+
+    // Functions whose first object argument may be NULL on purpose
+    bool nullFirstAllowed(const char *name) {
+        static const std::unordered_set<string> names{
+            "playdate_graphics_pushContext", // NULL: the frame buffer
+            "playdate_graphics_setStencil", "playdate_graphics_setStencilImage", // NULL: no stencil
+            "playdate_graphics_setFont", // NULL: the system font
+            "playdate_sys_setMenuImage", // NULL: no image
+            "playdate_graphics_getFontHeight", "playdate_graphics_getTextWidth", "playdate_graphics_getTextHeightForMaxWidth", // NULL: the current font
+            "playdate_graphics_getFontPage",
+        };
+        return names.contains(name);
+    }
+
+    template<typename T>
+    bool checkArg(Cranked &cranked, const char *name, int index, void *slot) {
+        if constexpr (isResourcePointer<T>) {
+            void *pointer = *(void **) slot;
+            if (!pointer)
+                return index != 0 or nullFirstAllowed(name);
+            auto &live = cranked.nativeEngine.liveResources();
+            auto resource = (NativeResource *) pointer;
+            if (!live.contains(resource))
+                throw NativeEngine::NativeExecutionError(format("{}: argument {} is not a live object", name, index + 1));
+            if (!dynamic_cast<T>(resource))
+                throw NativeEngine::NativeExecutionError(format("{}: argument {} is an object of the wrong type", name, index + 1));
+        }
+        return true;
+    }
+
+    template<typename Tuple, size_t ...I>
+    bool checkArgs(Cranked &cranked, const char *name, void **ffiArgs, std::index_sequence<I...>) {
+        bool ok = true;
+        ((ok = ok and checkArg<tuple_element_t<I + 1, Tuple>>(cranked, name, (int) I, ffiArgs[I + 1])), ...);
+        return ok;
+    }
+
+    template<typename F> struct Params;
+    template<typename R, typename ...A> struct Params<R (*)(A...)> { using Types = tuple<A...>; static constexpr size_t count = sizeof...(A); };
+    template<typename R, typename ...A> struct Params<R (*)(A..., ...)> { using Types = tuple<A...>; static constexpr size_t count = sizeof...(A); };
+
+    template<auto F>
+    bool validate(Cranked &cranked, const char *name, void **ffiArgs) {
+        using P = Params<decltype(F)>;
+        if constexpr (P::count == 0) return true;
+        else if constexpr (!is_same_v<tuple_element_t<0, typename P::Types>, Cranked *>) return true;
+        else return checkArgs<typename P::Types>(cranked, name, ffiArgs, std::make_index_sequence<P::count - 1>{});
+    }
+}
+
+// One validator per entry of playdateFunctionTable, in the same order (generated from gen/PlaydateFunctionMappings.cpp)
+NativeArgValidator cranked::playdateArgValidators[FUNCTION_TABLE_SIZE] {
+#include "gen/ArgValidators.inc"
+};
diff --git a/core/ArmInterpreter.cpp b/core/ArmInterpreter.cpp
new file mode 100644
index 0000000..17483e7
--- /dev/null
+++ b/core/ArmInterpreter.cpp
@@ -0,0 +1,1634 @@
+// See ArmInterpreter.hpp. The decoding follows the ARMv7-M Architecture Reference Manual's encoding tables
+// (Thumb 16-bit, Thumb 32-bit, floating point), with FPv5 additions.
+#include "ArmInterpreter.hpp"
+
+#include <algorithm>
+#include <bit>
+#include <cfenv>
+#include <cmath>
+#include <limits>
+
+// portable byte swap (MSVC has no __builtin_bswap32); compilers turn this into one instruction
+static inline uint32_t byteSwap32(uint32_t v) { return (v >> 24) | ((v >> 8) & 0xFF00u) | ((v << 8) & 0xFF0000u) | (v << 24); }
+
+namespace armi {
+
+// ---------------------------------------------------------------------------------------------------------------------
+// state
+
+u32 State::xpsr() const {
+    u32 itBits = ((it & 3) << 25) | ((it >> 2) << 10);
+    return n << 31 | z << 30 | c << 29 | v << 28 | q << 27 | itBits | 1u << 24 | (ge & 0xF) << 16 | (ipsr & 0x1FF);
+}
+
+void State::setXpsr(u32 value, u32 mask) {
+    u32 x = (xpsr() & ~mask) | (value & mask);
+    n = x >> 31 & 1; z = x >> 30 & 1; c = x >> 29 & 1; v = x >> 28 & 1; q = x >> 27 & 1;
+    ge = x >> 16 & 0xF;
+    it = ((x >> 25) & 3) | (((x >> 10) & 0x3F) << 2);
+    ipsr = x & 0x1FF;
+}
+
+Interpreter::Interpreter() : pages(1u << (32 - PAGE_BITS), 0), fast(1u << (32 - PAGE_BITS)) {}
+
+void Interpreter::rebuildFast() {
+    std::fill(fast.begin(), fast.end(), FastPage{});
+    std::vector<u8> shared(fast.size(), 0);
+    for (auto &r : regions) {
+        u64 end = (u64) r.base + r.size;
+        for (u64 p = r.base >> PAGE_BITS; p <= (end - 1) >> PAGE_BITS; p++) {
+            if (fast[p].hi or shared[p]) { shared[p] = 1; fast[p] = FastPage{}; continue; } // two regions: slow path
+            u64 pageStart = p << PAGE_BITS;
+            u32 lo = (u32) (std::max<u64>(r.base, pageStart) - pageStart);
+            u32 hi = (u32) (std::min<u64>(end, pageStart + (1u << PAGE_BITS)) - pageStart);
+            fast[p] = { (uintptr_t) r.host - (uintptr_t) r.base, lo, hi, r.prot };
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// memory
+
+bool Interpreter::map(u32 base, u32 size, u32 prot, u8 *host) {
+    if (!size or !host) return false;
+    u64 end = (u64) base + size;
+    for (auto &r : regions)
+        if (base < (u64) r.base + r.size and r.base < end) return false;
+    regions.push_back({ base, size, prot, host });
+    int index = (int) regions.size();
+    for (u64 p = base >> PAGE_BITS; p <= (end - 1) >> PAGE_BITS; p++)
+        if (!pages[p]) pages[p] = index; // a page shared with another region keeps the first; lookups fall back to a scan
+    rebuildFast();
+    return true;
+}
+
+bool Interpreter::unmap(u32 base, u32 size) {
+    for (size_t i = 0; i < regions.size(); i++)
+        if (regions[i].base == base and regions[i].size == size) {
+            regions.erase(regions.begin() + (long) i);
+            std::fill(pages.begin(), pages.end(), 0);
+            for (size_t k = 0; k < regions.size(); k++) {
+                auto &r = regions[k];
+                for (u64 p = r.base >> PAGE_BITS; p <= ((u64) r.base + r.size - 1) >> PAGE_BITS; p++)
+                    if (!pages[p]) pages[p] = (int) k + 1;
+            }
+            rebuildFast();
+            return true;
+        }
+    return false;
+}
+
+static const Region *findRegion(const std::vector<Region> &regions, const std::vector<int> &pages, int pageBits, u32 a, u32 size) {
+    if (int index = pages[a >> pageBits]) {
+        auto &r = regions[index - 1];
+        if (a >= r.base and (u64) a + size <= (u64) r.base + r.size) return &r;
+    }
+    for (auto &r : regions)
+        if (a >= r.base and (u64) a + size <= (u64) r.base + r.size) return &r;
+    return nullptr;
+}
+
+bool Interpreter::read(u32 address, void *out, size_t size) {
+    auto r = findRegion(regions, pages, PAGE_BITS, address, (u32) size);
+    if (!r) return false;
+    memcpy(out, r->host + (address - r->base), size);
+    return true;
+}
+
+bool Interpreter::write(u32 address, const void *in, size_t size) {
+    auto r = findRegion(regions, pages, PAGE_BITS, address, (u32) size);
+    if (!r) return false;
+    memcpy(r->host + (address - r->base), in, size);
+    return true;
+}
+
+u8 *Interpreter::translate(u32 a, u32 size, u32 need, Result unmapped, Result prot, int hookType, s64 value) {
+    if (int index = pages[a >> PAGE_BITS]) { // the common case: inside the page's region
+        auto &r = regions[index - 1];
+        u32 off = a - r.base;
+        if (a >= r.base and off <= r.size - size and r.size >= size) {
+            if ((r.prot & need) != need) { lastFaultAddress = a; throw Fault{ prot }; }
+            return r.host + off;
+        }
+    }
+    if (auto r = findRegion(regions, pages, PAGE_BITS, a, size)) {
+        if ((r->prot & need) != need) { lastFaultAddress = a; throw Fault{ prot }; }
+        return r->host + (a - r->base);
+    }
+    lastFaultAddress = a;
+    if (onUnmapped) onUnmapped(hookType, a, (int) size, value);
+    throw Fault{ unmapped };
+}
+
+static constexpr int MEM_READ_UNMAPPED = 19, MEM_WRITE_UNMAPPED = 20, MEM_FETCH_UNMAPPED = 21; // Unicorn's uc_mem_type
+
+u32 Interpreter::load8(u32 a) { if (auto p = fastPointer(a, 1, ProtRead)) return *p; return *translate(a, 1, ProtRead, Result::ReadUnmapped, Result::ReadProt, MEM_READ_UNMAPPED, 0); }
+u32 Interpreter::load16(u32 a) { u16 v; auto p = fastPointer(a, 2, ProtRead); memcpy(&v, p ? p : translate(a, 2, ProtRead, Result::ReadUnmapped, Result::ReadProt, MEM_READ_UNMAPPED, 0), 2); return v; }
+u32 Interpreter::load32(u32 a) { u32 v; auto p = fastPointer(a, 4, ProtRead); memcpy(&v, p ? p : translate(a, 4, ProtRead, Result::ReadUnmapped, Result::ReadProt, MEM_READ_UNMAPPED, 0), 4); return v; }
+u64 Interpreter::load64(u32 a) { return (u64) load32(a) | (u64) load32(a + 4) << 32; }
+void Interpreter::store8(u32 a, u32 v) { auto p = fastPointer(a, 1, ProtWrite); *(p ? p : translate(a, 1, ProtWrite, Result::WriteUnmapped, Result::WriteProt, MEM_WRITE_UNMAPPED, v)) = (u8) v; }
+void Interpreter::store16(u32 a, u32 v) { u16 x = (u16) v; auto p = fastPointer(a, 2, ProtWrite); memcpy(p ? p : translate(a, 2, ProtWrite, Result::WriteUnmapped, Result::WriteProt, MEM_WRITE_UNMAPPED, x), &x, 2); }
+void Interpreter::store32(u32 a, u32 v) { auto p = fastPointer(a, 4, ProtWrite); memcpy(p ? p : translate(a, 4, ProtWrite, Result::WriteUnmapped, Result::WriteProt, MEM_WRITE_UNMAPPED, v), &v, 4); }
+void Interpreter::store64(u32 a, u64 v) { store32(a, (u32) v); store32(a + 4, (u32) (v >> 32)); }
+u16 Interpreter::fetch16(u32 a) { u16 v; auto p = fastPointer(a, 2, ProtExec); memcpy(&v, p ? p : translate(a, 2, ProtExec, Result::FetchUnmapped, Result::FetchProt, MEM_FETCH_UNMAPPED, 0), 2); return v; }
+
+// ---------------------------------------------------------------------------------------------------------------------
+// the run loop
+
+Result Interpreter::run(u32 begin, u32 until, u64 count, u64 budget) {
+    stopRequested = false;
+    pc = begin & ~1u;
+    until &= ~1u;
+    u64 done = 0;
+    u64 limit = count ? (budget ? std::min(count, budget) : count) : (budget ? budget : ~0ull);
+    // the code page being run: guest range [codeLo, codeLo + codeSpan + 4) at host codeDelta + address (refreshed when
+    // the PC leaves it); empty at first (no even PC is codeLo + 0 = 0xFFFFFFFF)
+    u32 codeLo = 0xFFFFFFFF, codeSpan = 0; uintptr_t codeDelta = 0;
+    const bool hookCode = (bool) onCode; // tested once, not per instruction
+    try {
+        for (;;) {
+            if (pc == until or done >= limit) break;
+            if ((done & 63) == 0 and stopRequested.load(std::memory_order_relaxed)) break;
+            u16 hw1, hw2 = 0;
+            if (pc - codeLo <= codeSpan) { // both halfwords inside the cached range
+                u32 word; memcpy(&word, (const u8 *) (codeDelta + pc), 4);
+                hw1 = (u16) word; hw2 = (u16) (word >> 16);
+            } else {
+                // a fetch outside executable memory (every API call: a branch into the unmapped function
+                // table) ends the run without an exception, which would cost more than the call itself
+                if (!fastPointer(pc, 2, ProtExec)) {
+                    auto r = findRegion(regions, pages, PAGE_BITS, pc, 2);
+                    if (!r or !(r->prot & ProtExec)) {
+                        lastFaultAddress = pc;
+                        if (!r and onUnmapped) onUnmapped(MEM_FETCH_UNMAPPED, pc, 2, 0);
+                        st.r[15] = pc;
+                        totalExecuted += done;
+                        return r ? Result::FetchProt : Result::FetchUnmapped;
+                    }
+                }
+                hw1 = fetch16(pc);
+                const FastPage &f = fast[pc >> PAGE_BITS];
+                if ((f.prot & ProtExec) and f.hi >= f.lo + 4) { codeLo = (pc & ~((1u << PAGE_BITS) - 1)) + f.lo; codeSpan = f.hi - f.lo - 4; codeDelta = f.delta; }
+                if ((hw1 >> 11) >= 0x1D) hw2 = fetch16(pc + 2);
+            }
+            bool wide = (hw1 >> 11) >= 0x1D;
+            if (hookCode) onCode(pc, wide ? 4 : 2);
+            nextPc = pc + (wide ? 4 : 2);
+            u32 itBefore = st.it;
+            if ((itBefore & 0xF) and !conditionPassed(itBefore >> 4)) {
+                // skipped by an IT block
+            } else if (wide)
+                step32(hw1, hw2);
+            else
+                step16(hw1);
+            if (itBefore & 0xF) // advance the IT block (an IT instruction itself starts with st.it set and no mask before)
+                st.it = (st.it & 7) == 0 ? 0 : (st.it & 0xE0) | ((st.it << 1) & 0x1F);
+            pc = nextPc;
+            done++;
+        }
+    } catch (Fault &f) {
+        st.r[15] = pc;
+        totalExecuted += done;
+        return f.result;
+    }
+    st.r[15] = pc;
+    totalExecuted += done;
+    return Result::Ok;
+}
+
+void Interpreter::undefined() {
+    interrupt(1); // EXCP_UDEF
+    throw Fault{ Result::Exception };
+}
+
+void Interpreter::interrupt(u32 intno) {
+    if (!onInterrupt) throw Fault{ Result::Exception };
+    st.r[15] = pc;
+    onInterrupt(intno); // may request a stop or throw (Cranked's handler throws for anything but a breakpoint)
+}
+
+// for each condition, the NZCV values (N in bit 3 of the index) for which it passes, built from the manual's
+// ConditionHolds
+static constexpr bool conditionHolds(u32 cond, u32 nzcv) {
+    bool n = nzcv >> 3 & 1, z = nzcv >> 2 & 1, c = nzcv >> 1 & 1, v = nzcv & 1, r = true;
+    switch (cond >> 1) {
+        case 0: r = z; break;
+        case 1: r = c; break;
+        case 2: r = n; break;
+        case 3: r = v; break;
+        case 4: r = c and !z; break;
+        case 5: r = n == v; break;
+        case 6: r = n == v and !z; break;
+        default: return true;
+    }
+    return (cond & 1) ? !r : r;
+}
+struct ConditionTable {
+    u16 passes[16]{};
+    constexpr ConditionTable() {
+        for (u32 cond = 0; cond < 16; cond++)
+            for (u32 nzcv = 0; nzcv < 16; nzcv++)
+                if (conditionHolds(cond, nzcv)) passes[cond] |= (u16) (1u << nzcv);
+    }
+};
+static constexpr ConditionTable conditionTable;
+
+bool Interpreter::conditionPassed(u32 cond) const {
+    return conditionTable.passes[cond & 15] >> (st.n << 3 | st.z << 2 | st.c << 1 | st.v) & 1;
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// integer helpers (the manual's pseudocode functions)
+
+enum { SRType_LSL, SRType_LSR, SRType_ASR, SRType_ROR, SRType_RRX };
+
+static inline u32 addWithCarry(u32 x, u32 y, u32 carryIn, u32 &carryOut, u32 &overflow) {
+    u64 unsignedSum = (u64) x + y + carryIn;
+    s64 signedSum = (s64) (s32) x + (s32) y + carryIn;
+    u32 result = (u32) unsignedSum;
+    carryOut = (u32) (unsignedSum >> 32) & 1;
+    overflow = (s64) (s32) result != signedSum;
+    return result;
+}
+
+static inline u32 shiftC(u32 value, int type, u32 amount, u32 carryIn, u32 &carryOut) {
+    carryOut = carryIn;
+    if (type == SRType_RRX) { carryOut = value & 1; return carryIn << 31 | value >> 1; }
+    if (amount == 0) return value;
+    switch (type) {
+        case SRType_LSL:
+            if (amount < 32) { carryOut = (value >> (32 - amount)) & 1; return value << amount; }
+            carryOut = amount == 32 ? value & 1 : 0; return 0;
+        case SRType_LSR:
+            if (amount < 32) { carryOut = (value >> (amount - 1)) & 1; return value >> amount; }
+            carryOut = amount == 32 ? value >> 31 : 0; return 0;
+        case SRType_ASR:
+            if (amount < 32) { carryOut = ((u32) ((s32) value >> (amount - 1))) & 1; return (u32) ((s32) value >> amount); }
+            carryOut = value >> 31; return value >> 31 ? 0xFFFFFFFFu : 0;
+        default: { // ROR
+            u32 m = amount & 31;
+            u32 result = m ? (value >> m | value << (32 - m)) : value;
+            carryOut = result >> 31;
+            return result;
+        }
+    }
+}
+
+static inline u32 shiftNoCarry(u32 value, int type, u32 amount, u32 carryIn) { u32 c; return shiftC(value, type, amount, carryIn, c); }
+
+static inline void decodeImmShift(u32 type, u32 imm5, int &shiftType, u32 &amount) {
+    switch (type) {
+        case 0: shiftType = SRType_LSL; amount = imm5; break;
+        case 1: shiftType = SRType_LSR; amount = imm5 ? imm5 : 32; break;
+        case 2: shiftType = SRType_ASR; amount = imm5 ? imm5 : 32; break;
+        default:
+            if (imm5 == 0) { shiftType = SRType_RRX; amount = 1; } else { shiftType = SRType_ROR; amount = imm5; }
+    }
+}
+
+static inline u32 thumbExpandImmC(u32 imm12, u32 carryIn, u32 &carryOut) {
+    carryOut = carryIn;
+    if ((imm12 >> 10) == 0) {
+        u32 imm8 = imm12 & 0xFF;
+        switch ((imm12 >> 8) & 3) {
+            case 0: return imm8;
+            case 1: return imm8 << 16 | imm8;
+            case 2: return imm8 << 24 | imm8 << 8;
+            default: return imm8 << 24 | imm8 << 16 | imm8 << 8 | imm8;
+        }
+    }
+    u32 unrotated = 0x80 | (imm12 & 0x7F), rotation = imm12 >> 7;
+    u32 result = unrotated >> rotation | unrotated << (32 - rotation);
+    carryOut = result >> 31;
+    return result;
+}
+
+static inline s32 signExtend(u32 value, int bits) { return (s32) (value << (32 - bits)) >> (32 - bits); }
+
+static inline s64 signedSat(s64 value, int bits, bool &saturated) {
+    s64 max = ((s64) 1 << (bits - 1)) - 1, min = -((s64) 1 << (bits - 1));
+    saturated = value > max or value < min;
+    return value > max ? max : value < min ? min : value;
+}
+
+static inline s64 unsignedSat(s64 value, int bits, bool &saturated) {
+    s64 max = ((s64) 1 << bits) - 1;
+    saturated = value > max or value < 0;
+    return value > max ? max : value < 0 ? 0 : value;
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// 16-bit instructions
+
+void Interpreter::step16(u16 hw) {
+    bool inIT = (st.it & 0xF) != 0;
+    bool setFlags = !inIT;
+    u32 carry, overflow;
+    switch (hw >> 12) {
+        case 0x0: case 0x1: { // shift (immediate), add, subtract
+            u32 op = (hw >> 11) & 3;
+            int rd = hw & 7, rn = (hw >> 3) & 7;
+            if (op != 3) { // LSL, LSR, ASR (immediate)
+                int type; u32 amount;
+                decodeImmShift(op, (hw >> 6) & 31, type, amount);
+                u32 result = shiftC(st.r[rn], type, amount, st.c, carry);
+                st.r[rd] = result;
+                if (setFlags) { st.n = result >> 31; st.z = result == 0; if (!(op == 0 and amount == 0)) st.c = carry; }
+            } else {
+                bool imm = (hw >> 10) & 1, sub = (hw >> 9) & 1;
+                u32 operand = imm ? (u32) ((hw >> 6) & 7) : st.r[(hw >> 6) & 7];
+                u32 result = sub ? addWithCarry(st.r[rn], ~operand, 1, carry, overflow) : addWithCarry(st.r[rn], operand, 0, carry, overflow);
+                st.r[rd] = result;
+                if (setFlags) { st.n = result >> 31; st.z = result == 0; st.c = carry; st.v = overflow; }
+            }
+            return;
+        }
+        case 0x2: case 0x3: { // MOV, CMP, ADD, SUB (8-bit immediate)
+            int rdn = (hw >> 8) & 7; u32 imm = hw & 0xFF;
+            switch ((hw >> 11) & 3) {
+                case 0: st.r[rdn] = imm; if (setFlags) { st.n = 0; st.z = imm == 0; } break;
+                case 1: { u32 r = addWithCarry(st.r[rdn], ~imm, 1, carry, overflow); st.n = r >> 31; st.z = r == 0; st.c = carry; st.v = overflow; break; }
+                case 2: { u32 r = addWithCarry(st.r[rdn], imm, 0, carry, overflow); st.r[rdn] = r; if (setFlags) { st.n = r >> 31; st.z = r == 0; st.c = carry; st.v = overflow; } break; }
+                default: { u32 r = addWithCarry(st.r[rdn], ~imm, 1, carry, overflow); st.r[rdn] = r; if (setFlags) { st.n = r >> 31; st.z = r == 0; st.c = carry; st.v = overflow; } break; }
+            }
+            return;
+        }
+        case 0x4: {
+            if ((hw >> 10) == 0x10) { // data processing (register)
+                int rdn = hw & 7, rm = (hw >> 3) & 7;
+                u32 a = st.r[rdn], b = st.r[rm], result = 0;
+                bool write = true, logical = true;
+                carry = st.c; overflow = st.v;
+                switch ((hw >> 6) & 15) {
+                    case 0: result = a & b; break; // AND
+                    case 1: result = a ^ b; break; // EOR
+                    case 2: result = shiftC(a, SRType_LSL, b & 0xFF, st.c, carry); break;
+                    case 3: result = shiftC(a, SRType_LSR, b & 0xFF, st.c, carry); break;
+                    case 4: result = shiftC(a, SRType_ASR, b & 0xFF, st.c, carry); break;
+                    case 5: result = addWithCarry(a, b, st.c, carry, overflow); logical = false; break; // ADC
+                    case 6: result = addWithCarry(a, ~b, st.c, carry, overflow); logical = false; break; // SBC
+                    case 7: result = shiftC(a, SRType_ROR, b & 0xFF, st.c, carry); break;
+                    case 8: result = a & b; write = false; break; // TST
+                    case 9: result = addWithCarry(~b, 0, 1, carry, overflow); logical = false; rdn = hw & 7; break; // RSB #0 (Rn is bits 5:3)
+                    case 10: result = addWithCarry(a, ~b, 1, carry, overflow); write = false; logical = false; break; // CMP
+                    case 11: result = addWithCarry(a, b, 0, carry, overflow); write = false; logical = false; break; // CMN
+                    case 12: result = a | b; break; // ORR
+                    case 13: result = a * b; break; // MUL (flags N and Z only)
+                    case 14: result = a & ~b; break; // BIC
+                    default: result = ~b; break; // MVN
+                }
+                bool flags = setFlags or !write; // TST, CMP and CMN always set the flags
+                if (write) st.r[rdn] = result;
+                if (flags) {
+                    st.n = result >> 31; st.z = result == 0;
+                    u32 op = (hw >> 6) & 15;
+                    if (op != 13) st.c = carry; // MUL leaves C (ARMv7)
+                    if (!logical) st.v = overflow;
+                }
+                return;
+            }
+            if ((hw >> 10) == 0x11) { // special data instructions and branch and exchange
+                int rm = (hw >> 3) & 15, rdn = ((hw >> 4) & 8) | (hw & 7);
+                switch ((hw >> 8) & 3) {
+                    case 0: { // ADD (register), no flags
+                        u32 r = reg(rdn) + reg(rm);
+                        if (rdn == 15) branchWritePC(r); else st.r[rdn] = r;
+                        return;
+                    }
+                    case 1: { // CMP (high registers)
+                        u32 r = addWithCarry(reg(rdn), ~reg(rm), 1, carry, overflow);
+                        st.n = r >> 31; st.z = r == 0; st.c = carry; st.v = overflow;
+                        return;
+                    }
+                    case 2: // MOV (register)
+                        if (rdn == 15) branchWritePC(reg(rm)); else st.r[rdn] = reg(rm);
+                        return;
+                    default: { // BX, BLX
+                        u32 target = reg(rm);
+                        if (hw & 0x80) st.r[14] = nextPc | 1;
+                        bxWritePC(target);
+                        return;
+                    }
+                }
+            }
+            // LDR (literal)
+            int rt = (hw >> 8) & 7;
+            st.r[rt] = load32(((pc + 4) & ~3u) + (hw & 0xFF) * 4);
+            return;
+        }
+        case 0x5: { // load/store (register offset)
+            int rt = hw & 7, rn = (hw >> 3) & 7, rm = (hw >> 6) & 7;
+            u32 address = st.r[rn] + st.r[rm];
+            switch ((hw >> 9) & 7) {
+                case 0: store32(address, st.r[rt]); break;
+                case 1: store16(address, st.r[rt]); break;
+                case 2: store8(address, st.r[rt]); break;
+                case 3: st.r[rt] = (u32) (s32) (s8) load8(address); break;
+                case 4: st.r[rt] = load32(address); break;
+                case 5: st.r[rt] = load16(address); break;
+                case 6: st.r[rt] = load8(address); break;
+                default: st.r[rt] = (u32) (s32) (s16) load16(address); break;
+            }
+            return;
+        }
+        case 0x6: case 0x7: { // STR, LDR, STRB, LDRB (immediate)
+            int rt = hw & 7, rn = (hw >> 3) & 7; u32 imm5 = (hw >> 6) & 31;
+            bool byte = (hw >> 12) & 1, load = (hw >> 11) & 1;
+            u32 address = st.r[rn] + (byte ? imm5 : imm5 * 4);
+            if (load) st.r[rt] = byte ? load8(address) : load32(address);
+            else if (byte) store8(address, st.r[rt]); else store32(address, st.r[rt]);
+            return;
+        }
+        case 0x8: { // STRH, LDRH (immediate)
+            int rt = hw & 7, rn = (hw >> 3) & 7;
+            u32 address = st.r[rn] + ((hw >> 6) & 31) * 2;
+            if (hw & 0x800) st.r[rt] = load16(address); else store16(address, st.r[rt]);
+            return;
+        }
+        case 0x9: { // STR, LDR (SP-relative)
+            int rt = (hw >> 8) & 7;
+            u32 address = st.r[13] + (hw & 0xFF) * 4;
+            if (hw & 0x800) st.r[rt] = load32(address); else store32(address, st.r[rt]);
+            return;
+        }
+        case 0xA: { // ADR, ADD (SP plus immediate)
+            int rd = (hw >> 8) & 7;
+            st.r[rd] = (hw & 0x800) ? st.r[13] + (hw & 0xFF) * 4 : ((pc + 4) & ~3u) + (hw & 0xFF) * 4;
+            return;
+        }
+        case 0xB: { // miscellaneous
+            if ((hw & 0xFF00) == 0xB000) { // ADD, SUB (SP plus immediate)
+                u32 imm = (hw & 0x7F) * 4;
+                st.r[13] = (hw & 0x80) ? st.r[13] - imm : st.r[13] + imm;
+                return;
+            }
+            if ((hw & 0xF500) == 0xB100) { // CBZ, CBNZ
+                int rn = hw & 7;
+                u32 imm = (((hw >> 9) & 1) << 6) | (((hw >> 3) & 31) << 1);
+                bool nonzero = (hw >> 11) & 1;
+                if ((st.r[rn] != 0) == nonzero) branchWritePC(pc + 4 + imm);
+                return;
+            }
+            if ((hw & 0xFF00) == 0xB200) { // SXTH, SXTB, UXTH, UXTB
+                int rd = hw & 7, rm = (hw >> 3) & 7; u32 m = st.r[rm];
+                switch ((hw >> 6) & 3) {
+                    case 0: st.r[rd] = (u32) (s32) (s16) m; break;
+                    case 1: st.r[rd] = (u32) (s32) (s8) m; break;
+                    case 2: st.r[rd] = m & 0xFFFF; break;
+                    default: st.r[rd] = m & 0xFF; break;
+                }
+                return;
+            }
+            if ((hw & 0xFE00) == 0xB400) { // PUSH
+                u32 list = (hw & 0xFF) | ((hw & 0x100) ? 1u << 14 : 0);
+                u32 address = st.r[13] - 4 * (u32) std::popcount(list);
+                u32 a = address;
+                for (int i = 0; i < 15; i++) if (list & (1u << i)) { store32(a, st.r[i]); a += 4; }
+                st.r[13] = address;
+                return;
+            }
+            if ((hw & 0xFFE8) == 0xB660) { // CPS
+                if (!(hw & 0x10)) { /* enable */ if (hw & 2) st.primask = 0; if (hw & 1) st.faultmask = 0; }
+                else { if (hw & 2) st.primask = 1; if (hw & 1) st.faultmask = 1; }
+                return;
+            }
+            if ((hw & 0xFF00) == 0xBA00) { // REV, REV16, REVSH
+                int rd = hw & 7, rm = (hw >> 3) & 7; u32 m = st.r[rm];
+                switch ((hw >> 6) & 3) {
+                    case 0: st.r[rd] = byteSwap32(m); return;
+                    case 1: st.r[rd] = ((m & 0x00FF00FF) << 8) | ((m >> 8) & 0x00FF00FF); return;
+                    case 3: st.r[rd] = (u32) (s32) (s16) (u16) (((m & 0xFF) << 8) | ((m >> 8) & 0xFF)); return;
+                    default: undefined();
+                }
+            }
+            if ((hw & 0xFE00) == 0xBC00) { // POP
+                u32 list = (hw & 0xFF) | ((hw & 0x100) ? 1u << 15 : 0);
+                u32 a = st.r[13];
+                u32 target = 0; bool toPc = false;
+                for (int i = 0; i < 16; i++) if (list & (1u << i)) { u32 value = load32(a); a += 4; if (i == 15) { target = value; toPc = true; } else st.r[i] = value; }
+                st.r[13] = a;
+                if (toPc) loadWritePC(target);
+                return;
+            }
+            if ((hw & 0xFF00) == 0xBE00) { interrupt(7); return; } // BKPT
+            if ((hw & 0xFF00) == 0xBF00) { // IT, hints
+                if (hw & 0xF) { st.it = hw & 0xFF; return; }
+                return; // NOP, YIELD, WFE, WFI, SEV
+            }
+            undefined();
+        }
+        case 0xC: { // STM, LDM
+            int rn = (hw >> 8) & 7; u32 list = hw & 0xFF;
+            u32 a = st.r[rn];
+            if (hw & 0x800) {
+                for (int i = 0; i < 8; i++) if (list & (1u << i)) { st.r[i] = load32(a); a += 4; }
+                if (!(list & (1u << rn))) st.r[rn] = a;
+            } else {
+                for (int i = 0; i < 8; i++) if (list & (1u << i)) { store32(a, st.r[i]); a += 4; }
+                st.r[rn] = a;
+            }
+            return;
+        }
+        case 0xD: { // conditional branch, UDF, SVC
+            u32 cond = (hw >> 8) & 15;
+            if (cond == 14) undefined();
+            if (cond == 15) { interrupt(2); return; } // SVC
+            if (conditionPassed(cond)) branchWritePC(pc + 4 + (u32) signExtend((hw & 0xFF) << 1, 9));
+            return;
+        }
+        case 0xE: // B (unconditional)
+            branchWritePC(pc + 4 + (u32) signExtend((hw & 0x7FF) << 1, 12));
+            return;
+        default:
+            undefined();
+    }
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// 32-bit instructions
+
+void Interpreter::step32(u16 hw1, u16 hw2) {
+    u32 op1 = (hw1 >> 11) & 3, op2 = (hw1 >> 4) & 0x7F;
+    if (op1 == 1) {
+        if ((op2 & 0x64) == 0x00) return loadStoreMultiple(hw1, hw2);
+        if ((op2 & 0x64) == 0x04) return loadStoreDualExclusiveTable(hw1, hw2);
+        if ((op2 & 0x60) == 0x20) return dataProcessingShiftedRegister(hw1, hw2);
+        return coprocessor(hw1, hw2);
+    }
+    if (op1 == 2) {
+        if (hw2 & 0x8000) return branchesAndMisc(hw1, hw2);
+        if (op2 & 0x20) return dataProcessingPlainImmediate(hw1, hw2);
+        return dataProcessingModifiedImmediate(hw1, hw2);
+    }
+    // op1 == 3
+    if ((op2 & 0x71) == 0x00) return loadStoreSingle(hw1, hw2);
+    if ((op2 & 0x67) == 0x01 or (op2 & 0x67) == 0x03 or (op2 & 0x67) == 0x05) return loadStoreSingle(hw1, hw2);
+    if ((op2 & 0x70) == 0x20) return dataProcessingRegister(hw1, hw2);
+    if ((op2 & 0x78) == 0x30) return multiply(hw1, hw2);
+    if ((op2 & 0x78) == 0x38) return longMultiplyDivide(hw1, hw2);
+    if (op2 & 0x40) return coprocessor(hw1, hw2);
+    undefined();
+}
+
+// The data-processing operations shared by the modified-immediate and shifted-register forms
+enum { DP_AND = 0, DP_BIC = 1, DP_ORR = 2, DP_ORN = 3, DP_EOR = 4, DP_ADD = 8, DP_ADC = 10, DP_SBC = 11, DP_SUB = 13, DP_RSB = 14 };
+
+#define ARMI_DATA_PROCESSING(op, rn, rd, setFlags, operand, shiftCarry)                                             \
+    do {                                                                                                         \
+        u32 a_ = reg(rn), b_ = (operand), r_ = 0, c_ = (shiftCarry), v_ = st.v;                                  \
+        bool write_ = true, arith_ = false;                                                                      \
+        switch (op) {                                                                                            \
+            case DP_AND: r_ = a_ & b_; if (rd == 15) write_ = false; break;                                      \
+            case DP_BIC: r_ = a_ & ~b_; break;                                                                   \
+            case DP_ORR: r_ = (rn == 15 ? 0 : a_) | b_; break;                                                   \
+            case DP_ORN: r_ = (rn == 15 ? 0 : a_) | ~b_; break;                                                  \
+            case DP_EOR: r_ = a_ ^ b_; if (rd == 15) write_ = false; break;                                      \
+            case DP_ADD: r_ = addWithCarry(a_, b_, 0, c_, v_); arith_ = true; if (rd == 15) write_ = false; break; \
+            case DP_ADC: r_ = addWithCarry(a_, b_, st.c, c_, v_); arith_ = true; break;                          \
+            case DP_SBC: r_ = addWithCarry(a_, ~b_, st.c, c_, v_); arith_ = true; break;                         \
+            case DP_SUB: r_ = addWithCarry(a_, ~b_, 1, c_, v_); arith_ = true; if (rd == 15) write_ = false; break; \
+            case DP_RSB: r_ = addWithCarry(~a_, b_, 1, c_, v_); arith_ = true; break;                            \
+            default: undefined();                                                                                \
+        }                                                                                                        \
+        if (write_) setReg(rd, r_);                                                                              \
+        if (setFlags) { st.n = r_ >> 31; st.z = r_ == 0; st.c = c_; if (arith_) st.v = v_; }                     \
+    } while (0)
+
+// ThumbExpandImm for every imm12, and whether the carry comes from the rotation (else it is the carry in)
+struct ExpandedImm { u32 value; bool rotated; };
+static const std::vector<ExpandedImm> &expandedImms() {
+    static const std::vector<ExpandedImm> table = [] {
+        std::vector<ExpandedImm> t(4096);
+        for (u32 i = 0; i < 4096; i++) { u32 c0, c1; u32 v = thumbExpandImmC(i, 0, c0); thumbExpandImmC(i, 1, c1); t[i] = { v, (i >> 10) != 0 }; (void) c0; (void) c1; }
+        return t;
+    }();
+    return table;
+}
+
+void Interpreter::dataProcessingModifiedImmediate(u16 hw1, u16 hw2) {
+    u32 op = (hw1 >> 5) & 15; bool s = (hw1 >> 4) & 1;
+    int rn = hw1 & 15, rd = (hw2 >> 8) & 15;
+    u32 imm12 = ((hw1 >> 10) & 1) << 11 | ((hw2 >> 12) & 7) << 8 | (hw2 & 0xFF);
+    static const ExpandedImm *imms = expandedImms().data();
+    u32 imm = imms[imm12].value;
+    u32 carry = imms[imm12].rotated ? imm >> 31 : st.c;
+    if (op == 0x6 or op == 0x7 or op == 0x9 or op == 0xC or op == 0xF) undefined();
+    ARMI_DATA_PROCESSING(op, rn, rd, s, imm, carry);
+}
+
+void Interpreter::dataProcessingShiftedRegister(u16 hw1, u16 hw2) {
+    u32 op = (hw1 >> 5) & 15; bool s = (hw1 >> 4) & 1;
+    int rn = hw1 & 15, rd = (hw2 >> 8) & 15, rm = hw2 & 15;
+    u32 imm5 = ((hw2 >> 12) & 7) << 2 | ((hw2 >> 6) & 3), type = (hw2 >> 4) & 3;
+    if (op == 0x6) { // PKHBT, PKHTB
+        bool tb = (hw2 >> 5) & 1;
+        u32 operand = tb ? shiftNoCarry(st.r[rm], SRType_ASR, imm5 ? imm5 : 32, st.c) : st.r[rm] << imm5;
+        u32 n = st.r[rn];
+        st.r[rd] = tb ? (n & 0xFFFF0000) | (operand & 0xFFFF) : (operand & 0xFFFF0000) | (n & 0xFFFF);
+        return;
+    }
+    int shiftType; u32 amount, carry;
+    decodeImmShift(type, imm5, shiftType, amount);
+    u32 operand = shiftC(reg(rm), shiftType, amount, st.c, carry);
+    ARMI_DATA_PROCESSING(op, rn, rd, s, operand, carry);
+}
+
+void Interpreter::dataProcessingPlainImmediate(u16 hw1, u16 hw2) {
+    u32 op = (hw1 >> 4) & 31;
+    int rn = hw1 & 15, rd = (hw2 >> 8) & 15;
+    u32 imm3 = (hw2 >> 12) & 7, imm8 = hw2 & 0xFF, i = (hw1 >> 10) & 1;
+    u32 imm12 = i << 11 | imm3 << 8 | imm8;
+    u32 imm2 = (hw2 >> 6) & 3;
+    switch (op) {
+        case 0x00: st.r[rd] = (rn == 15 ? ((pc + 4) & ~3u) : st.r[rn]) + imm12; return; // ADDW, ADR
+        case 0x0A: st.r[rd] = (rn == 15 ? ((pc + 4) & ~3u) : st.r[rn]) - imm12; return; // SUBW, ADR
+        case 0x04: st.r[rd] = (u32) (hw1 & 15) << 12 | imm12; return; // MOVW
+        case 0x0C: st.r[rd] = (st.r[rd] & 0xFFFF) | ((u32) (hw1 & 15) << 12 | imm12) << 16; return; // MOVT
+        case 0x10: case 0x12: { // SSAT, SSAT16
+            u32 satImm = (hw2 & 31) + 1, shiftN = imm3 << 2 | imm2;
+            bool asr = (hw1 >> 5) & 1, sat;
+            if (op == 0x12 and shiftN == 0) { // SSAT16
+                satImm = (hw2 & 15) + 1;
+                bool s1, s2;
+                u32 lo = (u32) signedSat((s16) st.r[rn], (int) satImm, s1) & 0xFFFF;
+                u32 hi = (u32) signedSat((s16) (st.r[rn] >> 16), (int) satImm, s2) & 0xFFFF;
+                st.r[rd] = hi << 16 | lo;
+                if (s1 or s2) st.q = 1;
+                return;
+            }
+            s32 operand = (s32) shiftNoCarry(st.r[rn], asr ? SRType_ASR : SRType_LSL, asr and shiftN == 0 ? 32 : shiftN, st.c);
+            st.r[rd] = (u32) signedSat(operand, (int) satImm, sat);
+            if (sat) st.q = 1;
+            return;
+        }
+        case 0x18: case 0x1A: { // USAT, USAT16
+            u32 satImm = hw2 & 31, shiftN = imm3 << 2 | imm2;
+            bool asr = (hw1 >> 5) & 1, sat;
+            if (op == 0x1A and shiftN == 0) { // USAT16
+                satImm = hw2 & 15;
+                bool s1, s2;
+                u32 lo = (u32) unsignedSat((s16) st.r[rn], (int) satImm, s1) & 0xFFFF;
+                u32 hi = (u32) unsignedSat((s16) (st.r[rn] >> 16), (int) satImm, s2) & 0xFFFF;
+                st.r[rd] = hi << 16 | lo;
+                if (s1 or s2) st.q = 1;
+                return;
+            }
+            s32 operand = (s32) shiftNoCarry(st.r[rn], asr ? SRType_ASR : SRType_LSL, asr and shiftN == 0 ? 32 : shiftN, st.c);
+            st.r[rd] = (u32) unsignedSat(operand, (int) satImm, sat);
+            if (sat) st.q = 1;
+            return;
+        }
+        case 0x14: case 0x1C: { // SBFX, UBFX
+            u32 lsb = imm3 << 2 | imm2, width = (hw2 & 31) + 1;
+            if (lsb + width > 32) undefined();
+            u32 field = (st.r[rn] >> lsb) & (width == 32 ? 0xFFFFFFFFu : (1u << width) - 1);
+            st.r[rd] = op == 0x14 ? (u32) signExtend(field, (int) width) : field;
+            return;
+        }
+        case 0x16: { // BFI, BFC
+            u32 lsb = imm3 << 2 | imm2, msb = hw2 & 31;
+            if (msb < lsb) undefined();
+            u32 width = msb - lsb + 1;
+            u32 mask = (width == 32 ? 0xFFFFFFFFu : ((1u << width) - 1)) << lsb;
+            u32 source = rn == 15 ? 0 : st.r[rn] << lsb;
+            st.r[rd] = (st.r[rd] & ~mask) | (source & mask);
+            return;
+        }
+        default: undefined();
+    }
+}
+
+void Interpreter::branchesAndMisc(u16 hw1, u16 hw2) {
+    u32 op1 = (hw2 >> 12) & 7, op = (hw1 >> 4) & 0x7F;
+    u32 s = (hw1 >> 10) & 1, j1 = (hw2 >> 13) & 1, j2 = (hw2 >> 11) & 1;
+    if ((op1 & 5) == 0) { // op1 0x0
+        if ((op & 0x38) != 0x38) { // B T3 (conditional)
+            u32 cond = (hw1 >> 6) & 15;
+            u32 imm = s << 20 | j2 << 19 | j1 << 18 | (u32) (hw1 & 0x3F) << 12 | (u32) (hw2 & 0x7FF) << 1;
+            if (conditionPassed(cond)) branchWritePC(pc + 4 + (u32) signExtend(imm, 21));
+            return;
+        }
+        if ((op & 0x7E) == 0x38) { // MSR
+            int rn = hw1 & 15; u32 sysm = hw2 & 0xFF, mask = (hw2 >> 10) & 3;
+            u32 value = st.r[rn];
+            if (sysm < 8) { // APSR
+                if (mask & 2) { st.n = value >> 31; st.z = (value >> 30) & 1; st.c = (value >> 29) & 1; st.v = (value >> 28) & 1; st.q = (value >> 27) & 1; }
+                if (mask & 1) st.ge = (value >> 16) & 15;
+            } else switch (sysm) {
+                case 8: st.msp = value & ~3u; break;
+                case 9: st.psp = value & ~3u; break;
+                case 16: st.primask = value & 1; break;
+                case 17: st.basepri = value & 0xFF; break;
+                case 18: if ((value & 0xFF) and ((value & 0xFF) < st.basepri or st.basepri == 0)) st.basepri = value & 0xFF; break;
+                case 19: st.faultmask = value & 1; break;
+                case 20: st.control = value & 7; break;
+                default: break;
+            }
+            return;
+        }
+        if (op == 0x3A) return; // hints (NOP, YIELD, WFE, WFI, SEV, DBG); CPS has no 32-bit form in M-profile
+        if (op == 0x3B) { if (((hw2 >> 4) & 15) == 2) st.exclusiveSet = false; return; } // CLREX, DSB, DMB, ISB
+        if ((op & 0x7E) == 0x3E) { // MRS
+            int rd = (hw2 >> 8) & 15; u32 sysm = hw2 & 0xFF, value = 0;
+            if (sysm < 8) {
+                if (!(sysm & 4)) value |= st.xpsr() & 0xF80F0000; // APSR: N Z C V Q and GE
+                if (sysm & 1) value |= st.ipsr & 0x1FF;
+            } else switch (sysm) {
+                case 8: value = st.msp; break;
+                case 9: value = st.psp; break;
+                case 16: value = st.primask; break;
+                case 17: case 18: value = st.basepri; break;
+                case 19: value = st.faultmask; break;
+                case 20: value = st.control; break;
+                default: break;
+            }
+            st.r[rd] = value;
+            return;
+        }
+        if (op == 0x7F and op1 == 2) undefined(); // UDF
+        undefined();
+    }
+    u32 i1 = !(j1 ^ s), i2 = !(j2 ^ s);
+    u32 imm = s << 24 | i1 << 23 | i2 << 22 | (u32) (hw1 & 0x3FF) << 12 | (u32) (hw2 & 0x7FF) << 1;
+    u32 target = pc + 4 + (u32) signExtend(imm, 25);
+    if ((op1 & 5) == 1) { branchWritePC(target); return; } // B T4
+    if ((op1 & 5) == 5) { st.r[14] = nextPc | 1; branchWritePC(target); return; } // BL
+    undefined(); // BLX (immediate) does not exist in M-profile
+}
+
+void Interpreter::loadStoreMultiple(u16 hw1, u16 hw2) {
+    u32 op = (hw1 >> 7) & 3; bool w = (hw1 >> 5) & 1, l = (hw1 >> 4) & 1;
+    int rn = hw1 & 15; u32 list = hw2;
+    u32 count = (u32) std::popcount(list);
+    if (op == 1) { // IA
+        u32 a = st.r[rn];
+        if (l) {
+            u32 target = 0; bool toPc = false;
+            for (int i = 0; i < 16; i++) if (list & (1u << i)) { u32 v = load32(a); a += 4; if (i == 15) { target = v; toPc = true; } else st.r[i] = v; }
+            if (w and !(list & (1u << rn))) st.r[rn] = a;
+            if (toPc) loadWritePC(target);
+        } else {
+            for (int i = 0; i < 15; i++) if (list & (1u << i)) { store32(a, st.r[i]); a += 4; }
+            if (w) st.r[rn] = a;
+        }
+        return;
+    }
+    if (op == 2) { // DB
+        u32 start = st.r[rn] - 4 * count, a = start;
+        if (l) {
+            u32 target = 0; bool toPc = false;
+            for (int i = 0; i < 16; i++) if (list & (1u << i)) { u32 v = load32(a); a += 4; if (i == 15) { target = v; toPc = true; } else st.r[i] = v; }
+            if (w and !(list & (1u << rn))) st.r[rn] = start;
+            if (toPc) loadWritePC(target);
+        } else {
+            for (int i = 0; i < 15; i++) if (list & (1u << i)) { store32(a, st.r[i]); a += 4; }
+            if (w) st.r[rn] = start;
+        }
+        return;
+    }
+    undefined();
+}
+
+void Interpreter::loadStoreDualExclusiveTable(u16 hw1, u16 hw2) {
+    bool p = (hw1 >> 8) & 1, u = (hw1 >> 7) & 1, w = (hw1 >> 5) & 1, l = (hw1 >> 4) & 1;
+    int rn = hw1 & 15, rt = (hw2 >> 12) & 15, rt2 = (hw2 >> 8) & 15;
+    if (!p and !w) { // exclusive and table branch
+        if (!u) { // STREX, LDREX
+            u32 address = st.r[rn] + (hw2 & 0xFF) * 4;
+            if (l) { st.r[rt] = load32(address); st.exclusive = address; st.exclusiveSet = true; }
+            else if (st.exclusiveSet and st.exclusive == address) { store32(address, st.r[rt]); st.r[rt2] = 0; st.exclusiveSet = false; } // one thread: succeeds when open for this address (as QEMU)
+            else st.r[rt2] = 1; // no reservation: the store fails and writes nothing
+            return;
+        }
+        u32 op3 = (hw2 >> 4) & 15;
+        if (l) {
+            if (op3 == 0 or op3 == 1) { // TBB, TBH
+                int rm = hw2 & 15;
+                u32 base = reg(rn), offset = op3 == 0 ? load8(base + st.r[rm]) : load16(base + st.r[rm] * 2);
+                branchWritePC(pc + 4 + offset * 2);
+                return;
+            }
+            if (op3 == 4) { st.r[rt] = load8(st.r[rn]); st.exclusive = st.r[rn]; st.exclusiveSet = true; return; }  // LDREXB
+            if (op3 == 5) { st.r[rt] = load16(st.r[rn]); st.exclusive = st.r[rn]; st.exclusiveSet = true; return; } // LDREXH
+        } else {
+            int rd = hw2 & 15;
+            if (op3 == 4 or op3 == 5) { // STREXB, STREXH
+                if (!st.exclusiveSet or st.exclusive != st.r[rn]) { st.r[rd] = 1; return; }
+                if (op3 == 4) store8(st.r[rn], st.r[rt]); else store16(st.r[rn], st.r[rt]);
+                st.r[rd] = 0; st.exclusiveSet = false; return;
+            }
+        }
+        undefined();
+    }
+    // LDRD, STRD (immediate, and LDRD literal)
+    u32 imm = (hw2 & 0xFF) * 4;
+    u32 base = rn == 15 ? ((pc + 4) & ~3u) : st.r[rn];
+    u32 offsetAddress = u ? base + imm : base - imm;
+    u32 address = p ? offsetAddress : base;
+    if (l) {
+        u32 lo = load32(address), hi = load32(address + 4);
+        st.r[rt] = lo; st.r[rt2] = hi;
+    } else {
+        store32(address, st.r[rt]); store32(address + 4, st.r[rt2]);
+    }
+    if (w) st.r[rn] = offsetAddress;
+}
+
+void Interpreter::loadStoreSingle(u16 hw1, u16 hw2) {
+    bool load = (hw1 >> 4) & 1, sign = (hw1 >> 8) & 1;
+    u32 size = (hw1 >> 5) & 3; // 0 byte, 1 halfword, 2 word
+    int rn = hw1 & 15, rt = (hw2 >> 12) & 15;
+    if (size == 3) undefined();
+    u32 address, writeback = 0; bool wb = false;
+    if (rn == 15) { // literal (loads only)
+        if (!load) undefined();
+        u32 imm = hw2 & 0xFFF, base = (pc + 4) & ~3u;
+        address = (hw1 & 0x80) ? base + imm : base - imm;
+    } else if (hw1 & 0x80) { // imm12
+        address = st.r[rn] + (hw2 & 0xFFF);
+    } else if (hw2 & 0x800) { // imm8 with P U W
+        bool p = (hw2 >> 10) & 1, u = (hw2 >> 9) & 1, w = (hw2 >> 8) & 1;
+        u32 imm = hw2 & 0xFF;
+        u32 offsetAddress = u ? st.r[rn] + imm : st.r[rn] - imm;
+        address = p ? offsetAddress : st.r[rn];
+        if (w) { wb = true; writeback = offsetAddress; }
+    } else if (((hw2 >> 6) & 0x3F) == 0) { // register offset
+        int rm = hw2 & 15;
+        address = st.r[rn] + (st.r[rm] << ((hw2 >> 4) & 3));
+    } else
+        undefined();
+    if (load) {
+        if (rt == 15 and size != 2) { if (wb) st.r[rn] = writeback; return; } // PLD, PLI and the halfword hints
+        u32 value;
+        if (size == 0) value = sign ? (u32) (s32) (s8) load8(address) : load8(address);
+        else if (size == 1) value = sign ? (u32) (s32) (s16) load16(address) : load16(address);
+        else value = load32(address);
+        if (wb) st.r[rn] = writeback;
+        if (rt == 15) loadWritePC(value); else st.r[rt] = value;
+    } else {
+        if (sign) undefined();
+        u32 value = st.r[rt];
+        if (size == 0) store8(address, value); else if (size == 1) store16(address, value); else store32(address, value);
+        if (wb) st.r[rn] = writeback;
+    }
+}
+
+void Interpreter::dataProcessingRegister(u16 hw1, u16 hw2) {
+    u32 op1 = (hw1 >> 4) & 15, op2 = (hw2 >> 4) & 15;
+    int rn = hw1 & 15, rd = (hw2 >> 8) & 15, rm = hw2 & 15;
+    if ((op1 & 8) == 0 and op2 == 0) { // LSL, LSR, ASR, ROR (register)
+        bool s = op1 & 1; u32 carry;
+        u32 result = shiftC(st.r[rn], (int) (op1 >> 1), st.r[rm] & 0xFF, st.c, carry);
+        st.r[rd] = result;
+        if (s) { st.n = result >> 31; st.z = result == 0; st.c = carry; }
+        return;
+    }
+    if ((op1 & 8) == 0 and (op2 & 8)) { // extends (with add)
+        u32 rotation = ((hw2 >> 4) & 3) * 8;
+        u32 rotated = rotation ? (st.r[rm] >> rotation | st.r[rm] << (32 - rotation)) : st.r[rm];
+        u32 n = rn == 15 ? 0 : st.r[rn];
+        switch (op1) {
+            case 0: st.r[rd] = n + (u32) (s32) (s16) rotated; return;           // SXTAH, SXTH
+            case 1: st.r[rd] = n + (rotated & 0xFFFF); return;                    // UXTAH, UXTH
+            case 2: { // SXTAB16, SXTB16
+                u32 lo = (u32) ((s32) (s16) (rn == 15 ? 0 : st.r[rn]) + (s32) (s8) rotated) & 0xFFFF;
+                u32 hi = (u32) ((s32) (s16) ((rn == 15 ? 0 : st.r[rn]) >> 16) + (s32) (s8) (rotated >> 16)) & 0xFFFF;
+                st.r[rd] = hi << 16 | lo; return;
+            }
+            case 3: { // UXTAB16, UXTB16
+                u32 lo = ((rn == 15 ? 0 : st.r[rn]) + (rotated & 0xFF)) & 0xFFFF;
+                u32 hi = (((rn == 15 ? 0 : st.r[rn]) >> 16) + ((rotated >> 16) & 0xFF)) & 0xFFFF;
+                st.r[rd] = hi << 16 | lo; return;
+            }
+            case 4: st.r[rd] = n + (u32) (s32) (s8) rotated; return;            // SXTAB, SXTB
+            case 5: st.r[rd] = n + (rotated & 0xFF); return;                      // UXTAB, UXTB
+            default: undefined();
+        }
+    }
+    if ((op1 & 8) and (op2 & 0xC) == 0) return parallelAddSub(hw1, hw2);   // signed
+    if ((op1 & 8) and (op2 & 0xC) == 4) return parallelAddSub(hw1, hw2);   // unsigned
+    if ((op1 & 0xC) == 8 and (op2 & 0xC) == 8) return miscOperations(hw1, hw2);
+    undefined();
+}
+
+void Interpreter::parallelAddSub(u16 hw1, u16 hw2) {
+    u32 op1 = (hw1 >> 4) & 7, prefix = (hw2 >> 4) & 3; bool isUnsigned = (hw2 >> 6) & 1;
+    int rn = hw1 & 15, rd = (hw2 >> 8) & 15, rm = hw2 & 15;
+    u32 a = st.r[rn], b = st.r[rm];
+    if (prefix == 3) undefined();
+    // prefix: 0 plain (sets GE), 1 saturating, 2 halving
+    auto lane = [&](u32 x, int bits, int index) -> s32 {
+        u32 v = (x >> (bits * index)) & ((1u << bits) - 1);
+        return isUnsigned ? (s32) v : signExtend(v, bits);
+    };
+    auto sat = [&](s32 v, int bits) -> s32 {
+        if (isUnsigned) { s32 max = (1 << bits) - 1; return v < 0 ? 0 : v > max ? max : v; }
+        s32 max = (1 << (bits - 1)) - 1, min = -(1 << (bits - 1)); return v < min ? min : v > max ? max : v;
+    };
+    u32 result = 0, ge = 0;
+    auto put = [&](s32 sum, int bits, int index, bool isAddition) {
+        s32 value = sum;
+        if (prefix == 1) value = sat(sum, bits);
+        else if (prefix == 2) value = sum >> 1;
+        result |= ((u32) value & ((1u << bits) - 1)) << (bits * index);
+        if (prefix == 0) {
+            bool flag = isUnsigned ? (isAddition ? sum >= (1 << bits) : sum >= 0) : sum >= 0;
+            if (flag) ge |= (bits == 8 ? 1u : 3u) << (bits == 8 ? index : index * 2);
+        }
+    };
+    switch (op1) {
+        case 0: for (int i = 0; i < 4; i++) put(lane(a, 8, i) + lane(b, 8, i), 8, i, true); break;            // ADD8
+        case 1: for (int i = 0; i < 2; i++) put(lane(a, 16, i) + lane(b, 16, i), 16, i, true); break;         // ADD16
+        case 2: put(lane(a, 16, 0) - lane(b, 16, 1), 16, 0, false); put(lane(a, 16, 1) + lane(b, 16, 0), 16, 1, true); break; // ASX
+        case 4: for (int i = 0; i < 4; i++) put(lane(a, 8, i) - lane(b, 8, i), 8, i, false); break;           // SUB8
+        case 5: for (int i = 0; i < 2; i++) put(lane(a, 16, i) - lane(b, 16, i), 16, i, false); break;        // SUB16
+        case 6: put(lane(a, 16, 0) + lane(b, 16, 1), 16, 0, true); put(lane(a, 16, 1) - lane(b, 16, 0), 16, 1, false); break; // SAX
+        default: undefined();
+    }
+    st.r[rd] = result;
+    if (prefix == 0) st.ge = ge;
+}
+
+void Interpreter::miscOperations(u16 hw1, u16 hw2) {
+    u32 op1 = (hw1 >> 4) & 3, op2 = (hw2 >> 4) & 3;
+    int rn = hw1 & 15, rd = (hw2 >> 8) & 15, rm = hw2 & 15;
+    switch (op1 << 2 | op2) {
+        case 0: case 1: case 2: case 3: { // QADD, QDADD, QSUB, QDSUB (Rm op Rn)
+            bool s1 = false, s2 = false;
+            s64 n = (s32) st.r[rn];
+            if (op2 & 1) n = signedSat(2 * n, 32, s1);
+            s64 r = (op2 & 2) ? (s64) (s32) st.r[rm] - n : (s64) (s32) st.r[rm] + n;
+            st.r[rd] = (u32) signedSat(r, 32, s2);
+            if (s1 or s2) st.q = 1;
+            return;
+        }
+        case 4: st.r[rd] = byteSwap32(st.r[rm]); return; // REV
+        case 5: { u32 m = st.r[rm]; st.r[rd] = ((m & 0x00FF00FF) << 8) | ((m >> 8) & 0x00FF00FF); return; } // REV16
+        case 6: { u32 m = st.r[rm], r = 0; for (int i = 0; i < 32; i++) if (m & (1u << i)) r |= 1u << (31 - i); st.r[rd] = r; return; } // RBIT
+        case 7: { u32 m = st.r[rm]; st.r[rd] = (u32) (s32) (s16) (u16) (((m & 0xFF) << 8) | ((m >> 8) & 0xFF)); return; } // REVSH
+        case 8: { // SEL
+            u32 n = st.r[rn], m = st.r[rm], r = 0;
+            for (int i = 0; i < 4; i++) r |= ((st.ge >> i) & 1 ? n : m) & (0xFFu << (8 * i));
+            st.r[rd] = r; return;
+        }
+        case 12: st.r[rd] = st.r[rm] ? (u32) std::countl_zero(st.r[rm]) : 32; return; // CLZ
+        default: undefined();
+    }
+}
+
+void Interpreter::multiply(u16 hw1, u16 hw2) {
+    u32 op1 = (hw1 >> 4) & 7, op2 = (hw2 >> 4) & 3;
+    int rn = hw1 & 15, ra = (hw2 >> 12) & 15, rd = (hw2 >> 8) & 15, rm = hw2 & 15;
+    u32 n = st.r[rn], m = st.r[rm];
+    s64 acc = ra == 15 ? 0 : (s32) st.r[ra];
+    switch (op1) {
+        case 0:
+            if (op2 == 0) { st.r[rd] = n * m + (ra == 15 ? 0 : st.r[ra]); return; } // MLA, MUL
+            if (op2 == 1) { st.r[rd] = st.r[ra] - n * m; return; }                  // MLS
+            break;
+        case 1: { // SMLA<x><y>, SMUL<x><y>
+            s32 a = (op2 & 2) ? (s32) n >> 16 : (s16) n, b = (op2 & 1) ? (s32) m >> 16 : (s16) m;
+            s64 r = (s64) a * b + acc;
+            st.r[rd] = (u32) r;
+            if (ra != 15 and r != (s32) r) st.q = 1;
+            return;
+        }
+        case 2: case 4: { // SMLAD(X), SMUAD(X), SMLSD(X), SMUSD(X)
+            u32 mm = (op2 & 1) ? (m >> 16 | m << 16) : m;
+            s64 p1 = (s64) (s16) n * (s16) mm, p2 = (s64) ((s32) n >> 16) * ((s32) mm >> 16);
+            s64 r = (op1 == 2 ? p1 + p2 : p1 - p2) + acc;
+            st.r[rd] = (u32) r;
+            if (r != (s32) r) st.q = 1;
+            return;
+        }
+        case 3: { // SMLAW<y>, SMULW<y>
+            s64 b = (op2 & 1) ? (s32) m >> 16 : (s16) m;
+            s64 r = (((s64) (s32) n * b) >> 16) + acc;
+            st.r[rd] = (u32) r;
+            if (ra != 15 and r != (s32) r) st.q = 1;
+            return;
+        }
+        case 5: case 6: { // SMMLA(R), SMMUL(R), SMMLS(R)
+            bool round = op2 & 1;
+            s64 product = (s64) (s32) n * (s32) m;
+            s64 value = op1 == 5 ? ((s64) (ra == 15 ? 0 : st.r[ra]) << 32) + product : ((s64) st.r[ra] << 32) - product;
+            if (round) value += 0x80000000;
+            st.r[rd] = (u32) (value >> 32);
+            return;
+        }
+        case 7: { // USADA8, USAD8
+            u32 sum = 0;
+            for (int i = 0; i < 4; i++) { s32 d = (s32) ((n >> (8 * i)) & 0xFF) - (s32) ((m >> (8 * i)) & 0xFF); sum += (u32) (d < 0 ? -d : d); }
+            st.r[rd] = sum + (ra == 15 ? 0 : st.r[ra]);
+            return;
+        }
+        default: break;
+    }
+    undefined();
+}
+
+void Interpreter::longMultiplyDivide(u16 hw1, u16 hw2) {
+    u32 op1 = (hw1 >> 4) & 7, op2 = (hw2 >> 4) & 15;
+    int rn = hw1 & 15, rdLo = (hw2 >> 12) & 15, rdHi = (hw2 >> 8) & 15, rm = hw2 & 15;
+    u32 n = st.r[rn], m = st.r[rm];
+    auto setLong = [&](u64 v) { st.r[rdLo] = (u32) v; st.r[rdHi] = (u32) (v >> 32); };
+    u64 acc = (u64) st.r[rdHi] << 32 | st.r[rdLo];
+    switch (op1) {
+        case 0: if (op2 == 0) { setLong((u64) ((s64) (s32) n * (s32) m)); return; } break; // SMULL
+        case 1: if (op2 == 15) { // SDIV
+            int rd = (hw2 >> 8) & 15;
+            st.r[rd] = m == 0 ? 0 : ((s32) n == INT32_MIN and (s32) m == -1) ? n : (u32) ((s32) n / (s32) m);
+            return;
+        } break;
+        case 2: if (op2 == 0) { setLong((u64) n * m); return; } break; // UMULL
+        case 3: if (op2 == 15) { int rd = (hw2 >> 8) & 15; st.r[rd] = m == 0 ? 0 : n / m; return; } break; // UDIV
+        case 4:
+            if (op2 == 0) { setLong(acc + (u64) ((s64) (s32) n * (s32) m)); return; } // SMLAL
+            if ((op2 & 0xC) == 8) { // SMLAL<x><y>
+                s32 a = (op2 & 2) ? (s32) n >> 16 : (s16) n, b = (op2 & 1) ? (s32) m >> 16 : (s16) m;
+                setLong(acc + (u64) ((s64) a * b)); return;
+            }
+            if ((op2 & 0xE) == 0xC) { // SMLALD(X)
+                u32 mm = (op2 & 1) ? (m >> 16 | m << 16) : m;
+                s64 p1 = (s64) (s16) n * (s16) mm, p2 = (s64) ((s32) n >> 16) * ((s32) mm >> 16);
+                setLong(acc + (u64) (p1 + p2)); return;
+            }
+            break;
+        case 5:
+            if ((op2 & 0xE) == 0xC) { // SMLSLD(X)
+                u32 mm = (op2 & 1) ? (m >> 16 | m << 16) : m;
+                s64 p1 = (s64) (s16) n * (s16) mm, p2 = (s64) ((s32) n >> 16) * ((s32) mm >> 16);
+                setLong(acc + (u64) (p1 - p2)); return;
+            }
+            break;
+        case 6:
+            if (op2 == 0) { setLong(acc + (u64) n * m); return; } // UMLAL
+            if (op2 == 6) { setLong((u64) n * m + st.r[rdHi] + st.r[rdLo]); return; } // UMAAL
+            break;
+        default: break;
+    }
+    undefined();
+}
