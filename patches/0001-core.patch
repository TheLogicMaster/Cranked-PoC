+void Audio::renderBlock() {
+    constexpr int len = 256;
+    rendering = true;
+    ScopeExitHelper doneRendering([this] {
+        rendering = false;
+        pendingReleases.clear();
+        for (auto source : vector(releaseWhenStopped)) // the ones that stopped playing are freed now
+            if (!source->playing) {
+                std::erase(releaseWhenStopped, source);
+                if (source->getRefCount() == 1) releaseIfOnlyInMainChannel(source);
+            }
+    });
+    // sources are mixed per channel in signed 8.24 (as on the device), effects process that mix, and the
+    // channels are summed into 16-bit stereo
+    vector<int32> outL(len), outR(len);
+    vector<int16> srcL(len), srcR(len);
+    for (auto lfo : globalLfos) lfo->step(sampleTime, len); // global LFOs advance whether or not they are used
+    for (auto env : globalEnvelopes) env->modStep(sampleTime, len); // and global envelopes
+    vector<SoundChannel> all{ mainChannel.get() };
+    for (auto &channel : channels) all.push_back(channel.get());
+    // channels are rendered in the order they were added (it matters for channel sources)
+    sort(all.begin() + 1, all.end(), [](SoundChannel a, SoundChannel b) { return a->orderSeq < b->orderSeq; });
+    // the game's SDK version (pdxinfo pdxversion): games built before 2.6.0 get the old pan law
+    int gameVersion = 0;
+    if (cranked.rom) if (auto v = cranked.rom->getManifestString("pdxversion")) gameVersion = atoi(v);
+    for (auto channel : all) {
+        if (!channel) continue;
+        // the channel's pan and volume modulators are stepped first
+        auto panMod = stepRateModulator(channel->panModulator, sampleTime, len);
+        auto volMod = stepRateModulator(channel->volumeModulator, sampleTime, len);
+        vector<int32> mixL(len), mixR(len);
+        // the channel is stereo when a source in it is stereo or has unequal volumes, or a stereo effect is added
+        // (otherwise only the left buffer is mixed and effects get no right buffer)
+        bool stereo = false;
+        for (auto &source : channel->sources) {
+            if (!source) continue;
+            if (source->leftVolume != source->rightVolume) stereo = true;
+            else if (auto sp = dynamic_cast<SamplePlayer_32 *>(source.get())) stereo = stereo or (sp->sample and sp->sample->channels == 2);
+            else if (auto fp = dynamic_cast<FilePlayer_32 *>(source.get())) stereo = stereo or fp->streamChannels == 2;
+            else if (auto tap = dynamic_cast<DelayLineTap_32 *>(source.get())) stereo = stereo or (tap->delayLine and tap->delayLine->stereo);
+            else if (auto custom = dynamic_cast<CustomSoundSource_32 *>(source.get())) stereo = stereo or custom->stereo;
+            else if (auto cs = dynamic_cast<ChannelSource_32 *>(source.get())) stereo = stereo or cs->stereoFlag;
+        }
+        vector<SoundSource> ordered(channel->sources.begin(), channel->sources.end());
+        sort(ordered.begin(), ordered.end(), [](SoundSource a, SoundSource b) { return a->orderSeq < b->orderSeq; }); // in the order added
+        stable_partition(ordered.begin(), ordered.end(), [](SoundSource s) { return dynamic_cast<SoundSequence_32 *>(s) != nullptr; });
+        for (auto &source : ordered) { // sequences first, so the notes they start sound in the same block
+            if (source and !source->playing) {
+                // the device renders every source in a channel, and a sample player's render steps
+                // its rate modulator before anything else, so a sample player's modulator runs while it is stopped
+                auto player = dynamic_cast<SamplePlayer_32 *>(source);
+                if (player and player->explicitChannel and player->rateModulator) stepRateModulator(player->rateModulator, sampleTime, len);
+            }
+            if (!source or !source->playing) continue;
+            if (source->renderFixed(mixL.data(), mixR.data(), sampleTime, len)) continue; // accumulates as the device does
+            fill(srcL.begin(), srcL.end(), 0); fill(srcR.begin(), srcR.end(), 0);
+            source->sampleAudio(srcL.data(), srcR.data(), len);
+            for (int i = 0; i < len; i++) { mixL[i] += (int32) (srcL[i] * source->leftVolume) << 8; mixR[i] += (int32) (srcR[i] * source->rightVolume) << 8; }
+        }
+        // the channel is active when a source produced sound (approximated by a nonzero mix)
+        // or an effect says so; effects get that flag (a delay line stops after its length of silence, a filter
+        // rings on), and an inactive channel adds nothing to the output
+        bool active = false;
+        for (int i = 0; i < len and !active; i++) active = mixL[i] != 0 or mixR[i] != 0;
+        auto peakLevel = [&](bool st) { // see SoundChannelSignal_32::level
+            uint32 m = 0;
+            for (int i = 0; i < len; i++) {
+                uint32 l = mixL[i] < 0 ? 0u - (uint32) mixL[i] : (uint32) mixL[i]; m = max(m, l);
+                if (st) { uint32 r = mixR[i] < 0 ? 0u - (uint32) mixR[i] : (uint32) mixR[i]; m = max(m, r); }
+            }
+            return (float) (int32) m / 8388608.0f;
+        };
+        if (channel->drySignal and channel->drySignal->used) channel->drySignal->level = active ? peakLevel(stereo) : 0.0f;
+        for (auto effect : vector(channel->effectOrder)) { // in the order added
+            if (!effect) continue;
+            auto line = dynamic_cast<DelayLine_32 *>(effect);
+            if (!stereo and line and line->stereo) { stereo = true; mixR = mixL; } // a stereo effect makes the channel stereo
+            auto bufL = (int32 *) cranked.heap.allocate(len * 4), bufR = stereo ? (int32 *) cranked.heap.allocate(len * 4) : nullptr;
+            memcpy(bufL, mixL.data(), len * 4); if (bufR) memcpy(bufR, mixR.data(), len * 4);
+            bool result;
+            if (auto custom = dynamic_cast<CustomEffect_32 *>(effect); custom and custom->processFunction)
+                result = cranked.nativeEngine.invokeEmulatedFunction<int32, ArgType::int32_t, ArgType::ptr_t, ArgType::ptr_t, ArgType::ptr_t, ArgType::int32_t, ArgType::int32_t>(custom->processFunction, custom, bufL, bufR, len, active ? 1 : 0) != 0;
+            else
+            { effect->renderTime = sampleTime; result = effect->process(bufL, bufR, len, active); }
+            active = active or result;
+            memcpy(mixL.data(), bufL, len * 4); if (bufR) memcpy(mixR.data(), bufR, len * 4);
+            cranked.heap.free(bufL); if (bufR) cranked.heap.free(bufR);
+        }
+        if (channel->wetSignal and channel->wetSignal->used) channel->wetSignal->level = active ? peakLevel(stereo) : 0.0f;
+        if (channel->outputSource) channel->outputSource->copy(mixL.data(), stereo ? mixR.data() : nullptr, len, active);
+        if (!active) continue;
+        mixChannel(*channel, mixL.data(), stereo ? mixR.data() : nullptr, outL.data(), outR.data(), len, panMod.present, panMod.sweep, panMod.value, panMod.before, panMod.event,
+                   volMod.present, volMod.sweep, volMod.value, volMod.before, volMod.event, gameVersion);
+    }
+    // the sum (8.24 fixed point) to 16 bits, saturating
+    for (int i = 0; i < len; i++) {
+        blockBuffer[i * 2] = (int16) max(-32768, min(32767, outL[i] >> 8));
+        blockBuffer[i * 2 + 1] = (int16) max(-32768, min(32767, outR[i] >> 8));
+    }
+    sampleTime += len;
 }
 
