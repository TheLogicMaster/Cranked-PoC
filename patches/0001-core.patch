+    u32 regs = dbl ? imm8 / 2 : imm8;
+    u32 address = p ? st.r[rn] - imm8 * 4 : st.r[rn];
+    u32 a = address;
+    for (u32 i = 0; i < regs; i++) {
+        if (dbl) { if (l) setD(st, (first + (int) i) & 31, load64(a)); else store64(a, getD(st, (first + (int) i) & 31)); a += 8; }
+        else { if (l) st.s[(first + (int) i) & 63] = load32(a); else store32(a, st.s[(first + (int) i) & 63]); a += 4; }
+    }
+    if (w) st.r[rn] = u ? st.r[rn] + words * 4 : st.r[rn] - words * 4;
