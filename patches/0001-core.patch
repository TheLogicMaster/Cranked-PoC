+double doubleFromHalf(u16 h) {
+    u32 sign = h >> 15, e = (h >> 10) & 31, m = h & 0x3FF;
+    double v;
+    if (e == 0) v = std::ldexp((double) m, -24);
+    else if (e == 31) v = m ? std::numeric_limits<double>::quiet_NaN() : std::numeric_limits<double>::infinity();
