+// json.decode and json.decodeFile follow the device's decoder (OS 3.1.2) and its Lua binding (JsonDecoder.cpp):
+// its number parsing, string escapes, error messages ("<error> at line <n>"), silent failures (nil, nil), holes for
+// null array elements, last-wins duplicate keys and the "_array" merge; exponent rounding and files shorter than 3
+// bytes ("empty file") as measured in the Simulator. Where the device would corrupt the Lua stack, Cranked returns
+// nil and a description instead. (Cranked APIs: data/json)
+static void pushJsonValue(lua_State *L, const jsondecoder::LuaValue &value) {
+    switch (value.kind) {
+        case jsondecoder::LuaValue::Nil: lua_pushnil(L); break;
+        case jsondecoder::LuaValue::Bool: lua_pushboolean(L, value.b); break;
+        case jsondecoder::LuaValue::Int: lua_pushinteger(L, value.i); break;
+        case jsondecoder::LuaValue::Float: lua_pushnumber(L, value.f); break;
+        case jsondecoder::LuaValue::String: lua_pushstring(L, value.s.c_str()); break;
+        case jsondecoder::LuaValue::Table:
+            lua_checkstack(L, 4);
+            lua_createtable(L, 0, 0);
+            if (value.t)
+                for (auto &[key, entry] : value.t->entries) {
+                    pushJsonValue(L, key);
+                    pushJsonValue(L, entry);
+                    lua_rawset(L, -3);
+                }
+            break;
+    }
+}
