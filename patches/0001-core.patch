+        for (size_t k = 4 * channels; k < bytes; k++) {
+            int byte = data[k];
+            *dst++ = decodeSample(byte >> 4, predictor[0], stepIndex[0]);
+            *dst++ = decodeSample(byte & 0xF, predictor[second], stepIndex[second]);
         }
+}
+
+Rom::Audio Rom::readAudio(const uint8 *data, size_t dataSize, bool decodeAdpcm) {
+    // The 12-byte magic is followed directly by the header, with no terminator; the header word holds the
+    // sample rate in its low 24 bits and the format in its top byte
+    if (dataSize < 16 or memcmp(AUDIO_MAGIC, data, 12) != 0)
+        throw CrankedError("Bad audio magic");
+    auto headerWord = readUint32LE(data + 12);
+    auto sampleRate = headerWord & 0xFFFFFF;
+    auto soundFormat = SoundFormat(headerWord >> 24);
+    bool stereo = soundFormat == SoundFormat::Stereo8bit or soundFormat == SoundFormat::Stereo16bit or soundFormat == SoundFormat::StereoADPCM;
+    auto audioDataSize = dataSize - 16;
+    Audio audio {.soundFormat = soundFormat, .sampleRate = sampleRate};
+    audio.data.resize(audioDataSize);
+    memcpy(audio.data.data(), data + 16, audioDataSize);
+    if (soundFormat == SoundFormat::Mono8bit or soundFormat == SoundFormat::Stereo8bit) {
+        auto samples = audioDataSize;
+        audio.samples.resize(samples);
+        for (int i = 0; i < samples; i++)
+            audio.samples[i] = (int16) (bit_cast<int8>(data[16 + i]) << 8); // measured: pdc stores 8-bit samples signed (silence is 0)
+    } else if (soundFormat == SoundFormat::Mono16bit or soundFormat == SoundFormat::Stereo16bit) {
+        auto samples = audioDataSize / 2;
+        audio.samples.resize(samples);
+        for (int i = 0; i < samples; i++)
+            audio.samples[i] = bit_cast<int16>(readUint16LE(data + 16 + i * 2));
+    } else { // 4-bit IMA ADPCM
+        // Format notes: a 2-byte block size, then blocks; each block starts with a 4-byte header per channel
+        // (predictor, step index, zero) whose predictor is the block's first sample; the last block may be partial.
+        // Stereo uses the high nibble for left and the low nibble for right. Mono nibble order is unverified (high first).
+        // Blocks are independent, so they can also be decoded one at a time as they are played (LazyAdpcm).
+        int channels = stereo ? 2 : 1;
+        if (dataSize < 18) return audio; // no block size (a sample too short for one)
+        if (!decodeAdpcm) return audio; // the caller decodes later (LazyAdpcm)
+        auto layout = adpcmLayout(data + 16, dataSize - 16, channels);
+        audio.samples.resize(layout.totalFrames * channels);
+        for (size_t b = 0; b < layout.blocks; b++)
+            decodeAdpcmBlock(data + 16, dataSize - 16, layout, channels, b, audio.samples.data());
     }
     return audio;
 }
 
