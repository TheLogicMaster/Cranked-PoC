+            step1 = !lerp or e1 == e0 ? step0 : toUnsigned(base * (e1 == 0 ? 1.0f : (float) pow(2.0, (double) e1)));
+        } else if (freqEnv or freqCs or freqCh) { // an envelope or control signal: one value per block, not interpolated
+            float e0 = pitch + (freqEnv ? freqEnv->modValue : freqCs ? freqCs->modValue : freqCh->level);
